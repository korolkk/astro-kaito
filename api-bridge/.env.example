# OpenClaw API 配置
OPENCLAW_API_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_TOKEN=your-openclaw-token-here

# 服务端口
PORT=3001

# 限流配置（次/分钟/IP，默认值）
# CHAT_RATE_LIMIT=20
# QA_RATE_LIMIT=10
# COMMENT_RATE_LIMIT=10
# GLOBAL_RATE_LIMIT=60

# 微信通知（需服务器上安装 openclaw CLI，设为 true 开启）
# ENABLE_WEIXIN_NOTIFY=true
# WEIXIN_TARGET=your-openclaw-wechat-token

# Webhook 部署密钥（GitHub Actions 调用 /api/deploy 时校验）
DEPLOY_SECRET=change-me-to-a-random-string
