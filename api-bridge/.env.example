# OpenClaw API 配置
OPENCLAW_API_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_TOKEN=your-openclaw-token-here

# 服务端口
PORT=3001

# 数据目录（SQLite 数据库存放路径，默认 /opt/api-bridge/data）
# DB_DIR=/opt/api-bridge/data

# 文章文件目录（管理员编辑文章时读写，默认 /var/www/kaitohub/src/content/blog）
# BLOG_CONTENT_DIR=/var/www/kaitohub/src/content/blog

# 仓库路径（部署相关功能使用，默认 /var/www/kaitohub）
# REPO_DIR=/var/www/kaitohub

# 构建产物目录（部署相关功能使用，默认 /var/www/kaitohub/dist）
# DIST_DIR=/var/www/kaitohub/dist

# 限流配置（次/分钟/IP，默认值）
# CHAT_RATE_LIMIT=20
# QA_RATE_LIMIT=10
# COMMENT_RATE_LIMIT=10
# GLOBAL_RATE_LIMIT=60

# 微信通知（需服务器上安装 openclaw CLI，设为 true 开启）
# ENABLE_WEIXIN_NOTIFY=true
# WEIXIN_TARGET=your-openclaw-wechat-token

# 后台管理密码（访问 /admin 需登录，已部署后请修改）
# ADMIN_PASSWORD=your-admin-password-here

# Webhook 部署密钥（GitHub Actions 调用 /api/deploy 时校验）
DEPLOY_SECRET=change-me-to-a-random-string

# 小红书数据源（自建 RSSHub 方案，配置后首页展示小红书精选、后台展示互动统计）
# 部署 RSSHub 见 scripts/deploy-rsshub.sh
# XHS_RSSHUB_URL=http://127.0.0.1:1200
# XHS_USER_ID=your-xiaohongshu-user-id
# XHS_CACHE_TTL=10
