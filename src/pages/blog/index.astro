---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const PAGE_SIZE = 15;

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))].sort();
const totalCount = posts.length;

let currentYear = 0;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1140px;
				max-width: calc(100% - 2em);
				padding-left: 2em;
				padding-right: 2em;
			}

			.timeline-card {
				background: var(--card-bg);
				border-radius: 20px;
				padding: 2.5em;
				box-shadow: 0 2px 12px rgba(var(--black), 0.04);
				display: flex;
				flex-direction: column;
			}

			/* === Control bar (sticky) === */
			.control-bar-wrap {
				position: sticky;
				top: 0;
				z-index: 10;
				background: var(--card-bg);
				padding-bottom: 1em;
				margin-bottom: 0.5em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.control-bar {
				display: flex;
				align-items: center;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.6em 0.8em;
			}
			.control-bar .sort-label {
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.control-bar .sort-select {
				padding: 0.3em 0.6em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				font-family: inherit;
				font-size: 0.84em;
				background: var(--card-bg);
				color: rgb(var(--black));
				cursor: pointer;
				outline: none;
			}
			.control-bar .post-count {
				font-size: 0.8em;
				color: rgb(var(--gray));
				margin-left: 0.3em;
			}
			.control-bar .post-count strong {
				color: var(--accent);
				font-weight: 700;
			}

			/* Tag pills */
			.tag-pills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3em;
			}
			.tag-pill {
				padding: 0.25em 0.7em;
				font-size: 0.78em;
				font-family: inherit;
				color: var(--accent);
				background: transparent;
				border: 1px solid rgba(var(--accent-rgb), 0.25);
				border-radius: 999px;
				cursor: pointer;
				transition: all 0.2s ease;
				white-space: nowrap;
			}
			.tag-pill:hover {
				background: rgba(var(--accent-rgb), 0.08);
			}
			.tag-pill.active {
				background: var(--accent);
				color: #fff;
				border-color: var(--accent);
			}

			/* === Timeline === */
			.timeline {
				min-height: 50em;
			}
			.timeline-item {
				display: grid;
				grid-template-columns: 100px 28px 1fr 160px;
				gap: 1em;
				align-items: start;
				padding: 1.15em 0.5em;
				margin: 0 -0.5em;
				border-radius: 10px;
				position: relative;
				transition: opacity 0.3s ease, background 0.2s ease;
			}
			.timeline-item.hidden {
				display: none;
			}
			.timeline-item.fading {
				opacity: 0;
			}
			.timeline-item:hover {
				background: rgba(var(--accent-rgb), 0.025);
			}
			.timeline-item.year-break {
				padding-top: 2.2em;
				margin-top: 0.5em;
				border-top: 1px dashed rgb(var(--gray-light));
			}
			.timeline-item.year-break::before {
				content: attr(data-year);
				position: absolute;
				top: -0.85em;
				left: 0.5em;
				font-size: 0.9em;
				font-weight: 700;
				color: var(--accent);
				background: var(--card-bg);
				padding: 0.1em 0.6em;
				border-radius: 4px;
				z-index: 3;
			}

			/* Date */
			.timeline-date {
				text-align: right;
				color: rgb(var(--gray));
				font-size: 0.82em;
				line-height: 1.4;
				padding-top: 0.15em;
				font-variant-numeric: tabular-nums;
			}
			.timeline-date .month {
				display: block;
			}

			/* Dot & line */
			.timeline-dot-col {
				display: flex;
				flex-direction: column;
				align-items: center;
				position: relative;
				height: 100%;
			}
			.timeline-dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: rgb(var(--gray-light));
				flex-shrink: 0;
				margin-top: 0.4em;
				position: relative;
				z-index: 2;
				transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
			}
			.timeline-item:hover .timeline-dot {
				background: var(--accent);
				box-shadow: 0 0 0 6px rgba(var(--accent-rgb), 0.15);
				transform: scale(1.5);
			}
			.timeline-item.year-break .timeline-dot {
				background: var(--accent);
				box-shadow: 0 0 0 5px rgba(var(--accent-rgb), 0.15);
			}
			.timeline-item:not(:last-child) .timeline-dot-col::after {
				content: '';
				width: 2px;
				flex: 1;
				background: rgb(var(--gray-light));
				margin-top: 4px;
				min-height: 100%;
				transition: background 0.25s ease;
			}
			.timeline-item:hover .timeline-dot-col::after {
				background: rgba(var(--accent-rgb), 0.3);
			}

			/* Content */
			.timeline-content {
				text-decoration: none;
				color: inherit;
				display: block;
			}
			.timeline-content h3 {
				margin: 0 0 0.2em;
				font-size: 1.05em;
				color: rgb(var(--black));
				line-height: 1.4;
				transition: color 0.2s ease;
			}
			.timeline-item:hover .timeline-content h3 {
				color: var(--accent);
			}
			.timeline-content .desc {
				margin: 0 0 0.35em;
				font-size: 0.84em;
				color: rgb(var(--gray));
				line-height: 1.45;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.timeline-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25em;
			}
			.timeline-tag {
				font-size: 0.68em;
				padding: 0.1em 0.5em;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.07);
				border-radius: 999px;
			}

			/* Cover */
			.timeline-cover {
				display: block;
				border-radius: 8px;
				overflow: hidden;
			}
			.timeline-cover img {
				width: 100%;
				height: 90px;
				object-fit: cover;
				border-radius: 8px;
				transition: transform 0.3s ease;
			}
			.timeline-item:hover .timeline-cover img {
				transform: scale(1.05);
			}

			/* No results */
			.no-results {
				text-align: center;
				padding: 3em 1em;
				color: rgb(var(--gray));
				font-size: 0.95em;
				display: none;
			}
			.no-results.show {
				display: block;
			}

			/* Pagination */
			.pagination {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.5em;
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.pagination.hidden {
				display: none;
			}
			.page-arrow,
			.page-num {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 2.2em;
				height: 2.2em;
				border: none;
				background: none;
				color: rgb(var(--gray));
				font-size: 0.95em;
				font-family: inherit;
				cursor: pointer;
				border-radius: 6px;
				transition: all 0.15s ease;
			}
			.page-arrow:hover:not(.disabled),
			.page-num:hover {
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.06);
			}
			.page-arrow.disabled {
				opacity: 0.25;
				cursor: default;
			}
			.page-num.active {
				color: var(--accent);
				font-weight: 700;
			}
			.page-nums {
				display: flex;
				align-items: center;
				gap: 0.15em;
			}
			.page-ellipsis {
				min-width: 2em;
				text-align: center;
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.page-total {
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin-left: 0.4em;
			}

			/* Keyboard hint */
			.kbd-hint {
				font-size: 0.7em;
				color: rgb(var(--gray));
				opacity: 0.5;
				margin-left: 0.3em;
			}

			@media (max-width: 800px) {
				.timeline-item {
					grid-template-columns: 70px 22px 1fr;
					gap: 0.6em;
				}
				.timeline-cover {
					display: none;
				}
				.kbd-hint { display: none; }
			}
			@media (max-width: 500px) {
				main {
					width: calc(100% - 1em);
				}
				.timeline-card { padding: 1.5em; }
				.timeline-item {
					grid-template-columns: 52px 18px 1fr;
					gap: 0.4em;
					padding: 0.8em 0.3em;
					margin: 0 -0.3em;
				}
				.timeline-item.year-break {
					padding-top: 1.8em;
				}
				.timeline-date {
					font-size: 0.72em;
				}
				.timeline-dot {
					width: 10px;
					height: 10px;
				}
				.timeline-content h3 {
					font-size: 0.92em;
				}
				.page-total {
					display: none;
				}
				.control-bar-wrap {
					position: static;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="timeline-card">
				{
					allTags.length > 0 && (
						<div class="control-bar-wrap">
							<div class="control-bar">
								<span class="sort-label">排序</span>
								<select class="sort-select" id="sortSelect">
									<option value="newest">最新优先</option>
									<option value="oldest">最旧优先</option>
								</select>
								<span class="sort-label">标签</span>
								<span class="tag-pills" id="tagPills">
									<button class="tag-pill active" data-tag="">全部</button>
									{allTags.map((tag) => <button class="tag-pill" data-tag={tag}>{tag}</button>)}
								</span>
							</div>
							<div class="post-count" id="postCount">共 <strong>{totalCount}</strong> 篇文章</div>
						</div>
					)
				}
				<div class="timeline">
					{
						posts.map((post) => {
							const year = post.data.pubDate.getFullYear();
							const isNewYear = year !== currentYear;
							currentYear = year;
							const monthDay = `${post.data.pubDate.getMonth() + 1}月${post.data.pubDate.getDate()}日`;
							const dateStr = post.data.pubDate.toISOString().split('T')[0];

							return (
								<article class={`timeline-item${isNewYear ? ' year-break' : ''}`} data-tags={post.data.tags?.join(',') || ''} data-date={dateStr} data-year={year}>
									<div class="timeline-date">
										<span class="month">{monthDay}</span>
									</div>
									<div class="timeline-dot-col">
										<div class="timeline-dot"></div>
									</div>
									<a class="timeline-content" href={`${base}blog/${post.id}/`}>
										<h3>{post.data.title}</h3>
										<p class="desc">{post.data.description}</p>
										{
											post.data.tags && post.data.tags.length > 0 && (
												<div class="timeline-tags">
													{post.data.tags.map((tag) => <span class="timeline-tag">{tag}</span>)}
												</div>
											)
										}
									</a>
									{
										post.data.heroImage && (
											<a class="timeline-cover" href={`${base}blog/${post.id}/`} tabindex="-1">
												<Image width={320} height={180} src={post.data.heroImage} alt="" loading="lazy" />
											</a>
										)
									}
								</article>
							);
						})
					}
				</div>
				<div class="no-results" id="noResults">没有找到相关文章</div>

				<nav class="pagination" id="pagination">
					<button class="page-arrow" id="pagePrev">‹</button>
					<span class="page-nums" id="pageNumbers"></span>
					<button class="page-arrow" id="pageNext">›</button>
					<span class="page-total" id="pageTotal"></span>
					<span class="kbd-hint">← → 翻页</span>
				</nav>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script is:inline>
	(function () {
		// ===== State =====
		var PAGE_SIZE = 15;
		var items = Array.from(document.querySelectorAll('.timeline-item'));
		var currentTag = '';
		var currentPage = 1;
		var sortOrder = 'newest';
		var noResults = document.getElementById('noResults');
		var pagination = document.getElementById('pagination');
		var pagePrev = document.getElementById('pagePrev');
		var pageNext = document.getElementById('pageNext');
		var pageNumbers = document.getElementById('pageNumbers');
		var pageTotal = document.getElementById('pageTotal');
		var postCount = document.getElementById('postCount');
		var timelineCard = document.querySelector('.timeline-card');

		// ===== Sort =====
		function sortItems(order) {
			sortOrder = order;
			items.sort(function (a, b) {
				var da = a.dataset.date || '';
				var db = b.dataset.date || '';
				return order === 'newest' ? db.localeCompare(da) : da.localeCompare(db);
			});
			var tl = document.querySelector('.timeline');
			if (tl) items.forEach(function (it) { tl.appendChild(it); });
		}

		var sortSelect = document.getElementById('sortSelect');
		if (sortSelect) {
			sortSelect.addEventListener('change', function () {
				sortItems(sortSelect.value);
				currentPage = 1;
				updateUI();
			});
		}

		// ===== Tag pills =====
		var tagPills = document.getElementById('tagPills');
		if (tagPills) {
			tagPills.addEventListener('click', function (e) {
				var pill = e.target.closest('.tag-pill');
				if (!pill) return;
				currentTag = pill.dataset.tag;
				currentPage = 1;
				tagPills.querySelectorAll('.tag-pill').forEach(function (p) {
					p.classList.toggle('active', p.dataset.tag === currentTag);
				});
				updateUI();
				// Scroll timeline into view
				if (timelineCard) timelineCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		}

		// ===== Filtering & Pagination =====
		function getVisibleItems() {
			return items.filter(function (item) {
				var tags = (item.dataset.tags || '').split(',').filter(Boolean);
				return !currentTag || tags.indexOf(currentTag) > -1;
			});
		}

		function setArrowDisabled(btn, disabled) {
			if (disabled) { btn.classList.add('disabled'); btn.disabled = true; }
			else { btn.classList.remove('disabled'); btn.disabled = false; }
		}

		function updateUI() {
			var visible = getVisibleItems();
			var totalPages = Math.ceil(visible.length / PAGE_SIZE) || 1;
			if (currentPage > totalPages) currentPage = totalPages;

			// Show/hide with fade
			items.forEach(function (item) { item.classList.add('hidden'); });
			var start = (currentPage - 1) * PAGE_SIZE;
			var end = Math.min(start + PAGE_SIZE, visible.length);
			for (var i = start; i < end; i++) {
				visible[i].classList.remove('hidden');
			}

			// Update post count
			if (postCount) {
				postCount.innerHTML = currentTag
					? '筛选出 <strong>' + visible.length + '</strong> 篇（共 ' + items.length + ' 篇）'
					: '共 <strong>' + items.length + '</strong> 篇文章';
			}

			// No results
			if (noResults) noResults.classList.toggle('show', visible.length === 0);

			// Pagination
			if (totalPages <= 1) {
				pagination.classList.add('hidden');
			} else {
				pagination.classList.remove('hidden');
				setArrowDisabled(pagePrev, currentPage <= 1);
				setArrowDisabled(pageNext, currentPage >= totalPages);

				var html = '';
				var maxShow = 5;
				if (totalPages <= maxShow + 2) {
					for (var p = 1; p <= totalPages; p++) html += pageNumBtn(p);
				} else {
					var startPage = Math.max(2, currentPage - Math.floor(maxShow / 2) + 1);
					var endPage = Math.min(totalPages - 1, currentPage + Math.floor(maxShow / 2));
					while (endPage - startPage < maxShow - 3 && endPage < totalPages - 1) endPage++;
					while (endPage - startPage < maxShow - 3 && startPage > 2) startPage--;
					html += pageNumBtn(1);
					if (startPage > 2) html += '<span class="page-ellipsis">…</span>';
					for (var p = startPage; p <= endPage; p++) html += pageNumBtn(p);
					if (endPage < totalPages - 1) html += '<span class="page-ellipsis">…</span>';
					html += pageNumBtn(totalPages);
				}
				pageNumbers.innerHTML = html;
				pageTotal.textContent = totalPages + ' 页';

				pageNumbers.querySelectorAll('.page-num').forEach(function (btn) {
					btn.addEventListener('click', function () {
						currentPage = parseInt(this.dataset.page, 10);
						updateUI();
						updateURL();
						if (timelineCard) timelineCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
					});
				});
			}

			updateURL();
		}

		function pageNumBtn(p) {
			var cls = p === currentPage ? 'page-num active' : 'page-num';
			return '<button class="' + cls + '" data-page="' + p + '">' + p + '</button>';
		}

		function updateURL() {
			var url = new URL(window.location);
			if (currentTag) url.searchParams.set('tag', currentTag);
			else url.searchParams.delete('tag');
			if (currentPage > 1) url.searchParams.set('page', currentPage);
			else url.searchParams.delete('page');
			window.history.replaceState({}, '', url);
		}

		// ===== Pagination arrows =====
		pagePrev.addEventListener('click', function () {
			if (currentPage <= 1) return;
			currentPage--;
			updateUI();
			if (timelineCard) timelineCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
		pageNext.addEventListener('click', function () {
			var totalPages = Math.ceil(getVisibleItems().length / PAGE_SIZE) || 1;
			if (currentPage >= totalPages) return;
			currentPage++;
			updateUI();
			if (timelineCard) timelineCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});

		// ===== Keyboard shortcuts =====
		document.addEventListener('keydown', function (e) {
			// Don't intercept when typing in inputs
			if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				pagePrev.click();
			} else if (e.key === 'ArrowRight') {
				e.preventDefault();
				pageNext.click();
			}
		});

		// ===== Init from URL =====
		var params = new URLSearchParams(window.location.search);
		currentTag = params.get('tag') || '';
		currentPage = parseInt(params.get('page'), 10) || 1;

		if (currentTag && tagPills) {
			tagPills.querySelectorAll('.tag-pill').forEach(function (p) {
				p.classList.toggle('active', p.dataset.tag === currentTag);
			});
		}

		updateUI();
	})();
</script>
