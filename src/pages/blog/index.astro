---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags || []))].sort();

let currentYear = 0;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1140px;
				max-width: calc(100% - 2em);
				padding-left: 2em;
				padding-right: 2em;
			}

			/* Timeline card */
			.timeline-card {
				background: var(--card-bg);
				border-radius: 20px;
				padding: 2.5em;
				box-shadow: 0 2px 12px rgba(var(--black), 0.04);
			}

			/* Tag filter */
			.tag-filter {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				justify-content: center;
				margin-bottom: 2.5em;
			}
			.tag-filter-btn {
				padding: 0.3em 0.85em;
				font-size: 0.82em;
				color: var(--accent);
				background: transparent;
				border: 1px solid rgba(var(--accent-rgb), 0.25);
				border-radius: 999px;
				cursor: pointer;
				font-family: inherit;
				transition: all 0.2s ease;
				white-space: nowrap;
			}
			.tag-filter-btn:hover,
			.tag-filter-btn.active {
				background: var(--accent);
				color: #fff;
				border-color: var(--accent);
			}

			/* Timeline */
			.timeline-item {
				display: grid;
				grid-template-columns: 100px 28px 1fr 160px;
				gap: 1em;
				align-items: start;
				padding: 1.1em 0;
				position: relative;
			}
			.timeline-item.hidden {
				display: none;
			}
			.timeline-item.year-break {
				padding-top: 2em;
			}

			/* Date */
			.timeline-date {
				text-align: right;
				color: rgb(var(--gray));
				font-size: 0.82em;
				line-height: 1.4;
				padding-top: 0.15em;
				font-variant-numeric: tabular-nums;
			}
			.timeline-date .year {
				display: block;
				font-weight: 700;
				color: rgb(var(--gray-dark));
				font-size: 1.3em;
			}

			/* Dot & line */
			.timeline-dot-col {
				display: flex;
				flex-direction: column;
				align-items: center;
				position: relative;
				height: 100%;
			}
			.timeline-dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: rgb(var(--gray-light));
				flex-shrink: 0;
				margin-top: 0.4em;
				position: relative;
				z-index: 2;
				transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
			}
			.timeline-item:hover .timeline-dot {
				background: var(--accent);
				box-shadow: 0 0 0 6px rgba(var(--accent-rgb), 0.15);
				transform: scale(1.5);
			}
			.timeline-item.year-break .timeline-dot {
				background: var(--accent);
				box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.12);
			}
			.timeline-item.year-break:hover .timeline-dot {
				box-shadow: 0 0 0 8px rgba(var(--accent-rgb), 0.18);
			}
			.timeline-item:not(:last-child) .timeline-dot-col::after {
				content: '';
				width: 2px;
				flex: 1;
				background: rgb(var(--gray-light));
				margin-top: 4px;
				min-height: 100%;
				transition: background 0.25s ease;
			}
			.timeline-item:hover .timeline-dot-col::after {
				background: rgba(var(--accent-rgb), 0.3);
			}

			/* Content */
			.timeline-content {
				text-decoration: none;
				color: inherit;
				display: block;
				padding-top: 0;
			}
			.timeline-content h3 {
				margin: 0 0 0.2em;
				font-size: 1.05em;
				color: rgb(var(--black));
				line-height: 1.4;
				transition: color 0.2s ease;
			}
			.timeline-item:hover .timeline-content h3 {
				color: var(--accent);
			}
			.timeline-content .desc {
				margin: 0;
				font-size: 0.84em;
				color: rgb(var(--gray));
				line-height: 1.45;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.timeline-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25em;
				margin-top: 0.45em;
			}
			.timeline-tag {
				font-size: 0.68em;
				padding: 0.1em 0.5em;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.07);
				border-radius: 999px;
			}

			/* Cover */
			.timeline-cover {
				display: block;
				border-radius: 8px;
				overflow: hidden;
			}
			.timeline-cover img {
				width: 100%;
				height: 90px;
				object-fit: cover;
				border-radius: 8px;
				transition: transform 0.3s ease;
			}
			.timeline-item:hover .timeline-cover img {
				transform: scale(1.05);
			}

			/* No results */
			.no-results {
				text-align: center;
				padding: 3em 1em;
				color: rgb(var(--gray));
				font-size: 0.95em;
				display: none;
			}
			.no-results.show {
				display: block;
			}

			@media (max-width: 800px) {
				.timeline-item {
					grid-template-columns: 70px 22px 1fr;
					gap: 0.6em;
				}
				.timeline-cover {
					display: none;
				}
			}
			@media (max-width: 500px) {
				main {
					width: calc(100% - 1em);
				}
				.timeline-item {
					grid-template-columns: 52px 18px 1fr;
					gap: 0.4em;
					padding: 0.8em 0;
				}
				.timeline-item.year-break {
					padding-top: 1.5em;
				}
				.timeline-date {
					font-size: 0.72em;
				}
				.timeline-date .year {
					font-size: 1.15em;
				}
				.timeline-dot {
					width: 10px;
					height: 10px;
				}
				.timeline-content h3 {
					font-size: 0.92em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="timeline-card">
				{
					allTags.length > 0 && (
						<div class="tag-filter" id="tagFilter">
							<button class="tag-filter-btn active" data-tag="">全部</button>
							{allTags.map((tag) => <button class="tag-filter-btn" data-tag={tag}>{tag}</button>)}
						</div>
					)
				}
				<div class="timeline">
					{
						posts.map((post) => {
							const year = post.data.pubDate.getFullYear();
							const isNewYear = year !== currentYear;
							currentYear = year;
							const monthDay = `${post.data.pubDate.getMonth() + 1}月${post.data.pubDate.getDate()}日`;

							return (
								<article class={`timeline-item${isNewYear ? ' year-break' : ''}`} data-tags={post.data.tags?.join(',') || ''}>
									<div class="timeline-date">
										{isNewYear && <span class="year">{year}年</span>}
										<span>{monthDay}</span>
									</div>
									<div class="timeline-dot-col">
										<div class="timeline-dot"></div>
									</div>
									<a class="timeline-content" href={`/blog/${post.id}/`}>
										<h3>{post.data.title}</h3>
										<p class="desc">{post.data.description}</p>
										{
											post.data.tags && post.data.tags.length > 0 && (
												<div class="timeline-tags">
													{post.data.tags.map((tag) => <span class="timeline-tag">{tag}</span>)}
												</div>
											)
										}
									</a>
									{
										post.data.heroImage && (
											<a class="timeline-cover" href={`/blog/${post.id}/`} tabindex="-1">
												<Image width={320} height={180} src={post.data.heroImage} alt="" />
											</a>
										)
									}
								</article>
							);
						})
					}
				</div>
				<div class="no-results" id="noResults">没有找到相关文章</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script is:inline>
	(function () {
		const filter = document.getElementById('tagFilter');
		const items = document.querySelectorAll('.timeline-item');
		const noResults = document.getElementById('noResults');

		function applyFilter(tag) {
			let visible = 0;
			items.forEach((item) => {
				const tags = item.dataset.tags ? item.dataset.tags.split(',') : [];
				const show = !tag || tags.includes(tag);
				if (show) {
					item.classList.remove('hidden');
					visible++;
				} else {
					item.classList.add('hidden');
				}
			});
			if (noResults) {
				noResults.classList.toggle('show', visible === 0);
			}

			if (filter) {
				filter.querySelectorAll('.tag-filter-btn').forEach((btn) => {
					btn.classList.toggle('active', btn.dataset.tag === tag);
				});
			}

			const url = new URL(window.location);
			if (tag) {
				url.searchParams.set('tag', tag);
			} else {
				url.searchParams.delete('tag');
			}
			window.history.replaceState({}, '', url);
		}

		if (filter) {
			filter.querySelectorAll('.tag-filter-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					applyFilter(btn.dataset.tag);
				});
			});
		}

		const params = new URLSearchParams(window.location.search);
		const activeTag = params.get('tag') || '';
		if (activeTag) {
			applyFilter(activeTag);
		}
	})();
</script>
