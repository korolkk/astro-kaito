---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`在线工具 - ${SITE_TITLE}`} description="在线工具合集" />
		<style>
			main {
				width: 1140px;
				max-width: calc(100% - 2em);
				padding-left: 2em;
				padding-right: 2em;
			}
			.page-title {
				font-size: 1.6em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.6em;
				text-align: center;
			}
			/* Section */
			.section {
				background: var(--card-bg);
				border-radius: 20px;
				padding: 2em;
				box-shadow: 0 2px 12px rgba(var(--black), 0.04);
				margin-bottom: 2em;
			}
			.section-title {
				font-size: 1.15em;
				font-weight: 700;
				margin: 0 0 1em;
				color: rgb(var(--black));
				padding-bottom: 0.5em;
				border-bottom: 2px solid rgb(var(--gray-light));
				display: flex;
				align-items: center;
				gap: 0.5em;
			}

			/* Tools grid */
			.tools-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1em;
			}
			.tool-card {
				display: flex;
				flex-direction: column;
				padding: 1.2em;
				background: rgb(var(--gray-light));
				border-radius: 12px;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.tool-card:hover {
				background: var(--card-bg);
				box-shadow: 0 2px 16px rgba(0,0,0,0.08);
				transform: translateY(-2px);
			}
			.tool-header {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin-bottom: 0.5em;
			}
			.tool-icon {
				width: 40px;
				height: 40px;
				border-radius: 10px;
				background: linear-gradient(135deg, var(--accent), var(--accent-dark));
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.1em;
				color: #fff;
				flex-shrink: 0;
			}
			.tool-name {
				font-size: 1em;
				font-weight: 700;
				color: rgb(var(--black));
			}
			.tool-desc {
				font-size: 0.85em;
				color: rgb(var(--gray));
				line-height: 1.5;
				margin: 0;
			}
			.tool-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.3em;
				margin-top: 0.6em;
			}
			.tool-tag {
				font-size: 0.72em;
				padding: 0.15em 0.5em;
				border-radius: 999px;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.07);
			}

			/* Project list */
			.project-list {
				display: flex;
				flex-direction: column;
				gap: 0.6em;
			}
			.project-item {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.9em 1em;
				background: rgb(var(--gray-light));
				border-radius: 10px;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.project-item:hover {
				background: var(--card-bg);
				box-shadow: 0 2px 12px rgba(0,0,0,0.06);
				transform: translateY(-1px);
			}
			.project-info {
				min-width: 0;
			}
			.project-name {
				display: block;
				font-size: 0.92em;
				font-weight: 600;
				color: rgb(var(--black));
				margin-bottom: 0.1em;
			}
			.project-desc {
				font-size: 0.8em;
				color: rgb(var(--gray));
				line-height: 1.4;
			}
			.project-arrow {
				color: var(--accent);
				font-size: 1.2em;
				flex-shrink: 0;
				margin-left: 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<h1 class="page-title">在线工具</h1>

			<section class="section">
				<h2 class="section-title">
					<span class="icon">🛠️</span> 自研工具
				</h2>
				<div class="tools-grid">
					<a href="/tools/image-processor" class="tool-card">
						<div class="tool-header">
							<span class="tool-icon">IP</span>
							<span class="tool-name">图片处理工具</span>
						</div>
						<p class="tool-desc">自研的在线图片处理工具，支持压缩、格式转换、缩放和滤镜，所有处理在浏览器本地完成。</p>
						<div class="tool-tags">
							<span class="tool-tag">自研</span>
							<span class="tool-tag">图像</span>
							<span class="tool-tag">工具</span>
						</div>
					</a>

					<a href="/tools/bitstream-analyzer" class="tool-card">
						<div class="tool-header">
							<span class="tool-icon">BS</span>
							<span class="tool-name">码流分析工具</span>
						</div>
						<p class="tool-desc">自研的H.264/H.265/MP4码流解析工具，支持NAL单元分析、帧类型统计、GOP结构可视化和格式转换。</p>
						<div class="tool-tags">
							<span class="tool-tag">自研</span>
							<span class="tool-tag">视频</span>
							<span class="tool-tag">工具</span>
						</div>
					</a>
				</div>
			</section>

			<section class="section">
				<h2 class="section-title">
					<span class="icon">📦</span> 开源项目
				</h2>
				<div class="project-list">
					<a href="https://github.com/korolkk/astro-kaito" target="_blank" class="project-item">
						<span class="project-info">
							<span class="project-name">KaitoHub</span>
							<span class="project-desc">基于 Astro 6 的极简博客主题，卡片式设计，内置暗色模式 · 77 篇技术文章</span>
						</span>
						<span class="project-arrow">→</span>
					</a>

					<a href="https://github.com/korolkk/HuanYou" target="_blank" class="project-item">
						<span class="project-info">
							<span class="project-name">HuanYou</span>
							<span class="project-desc">基于 Multi-Agent 架构的智能旅游管理系统，为旅行社提供行程管理、短视频脚本生成、一键导出剪映、客户画像分析等功能。</span>
						</span>
						<span class="project-arrow">→</span>
					</a>

					<a href="https://github.com/s1dashu/ip-as-logo-skill" target="_blank" class="project-item">
						<span class="project-info">
							<span class="project-name">ip-as-logo</span>
							<span class="project-desc">🔥 3.5k+ Star 的开源 Agent Skill：用规则工程化流程让 AI 生成极简可爱的 IP 吉祥物 Logo（扁平几何、圆润厚重、双色+纯色背景，32×32 仍可辨识）。</span>
						</span>
						<span class="project-arrow">→</span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
