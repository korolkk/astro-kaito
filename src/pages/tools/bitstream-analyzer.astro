}

/* ================================================================
   Utility Functions
   ================================================================ */
function fmtSize(bytes) {
	if (bytes === 0) return '0 B';
	if (bytes < 1024) return bytes + ' B';
	if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
	if (bytes < 1073741824) return (bytes / 1048576).toFixed(2) + ' MB';
	return (bytes / 1073741824).toFixed(2) + ' GB';
}

function showError(msg) {
	var el = document.getElementById('errorMsg');
	el.textContent = msg;
	el.style.display = 'block';
	document.getElementById('warningMsg').style.display = 'none';
}

function showWarning(msg) {
	var el = document.getElementById('warningMsg');
	el.textContent = msg;
	el.style.display = 'block';
	document.getElementById('errorMsg').style.display = 'none';
}

function hideMessages() {
	document.getElementById('errorMsg').style.display = 'none';
	document.getElementById('warningMsg').style.display = 'none';
}

function showProcessing(text) {
	document.getElementById('processingText').textContent = text || '处理中...';
	document.getElementById('processingOverlay').classList.add('show');
}

function hideProcessing() {
	document.getElementById('processingOverlay').classList.remove('show');
}

function updateFileInfoBar(file, format, codecInfo) {
	document.getElementById('fileInfoBar').style.display = 'flex';
	document.getElementById('infoFilename').textContent = file.name;
	document.getElementById('infoSize').textContent = fmtSize(file.size);
	document.getElementById('infoFormat').textContent = format ? format.toUpperCase() : '?';
	document.getElementById('infoCodec').textContent = codecInfo && codecInfo.codec ? codecInfo.codec.toUpperCase() : '检测中...';
	document.getElementById('infoResolution').textContent = (codecInfo && codecInfo.width) ? codecInfo.width + '×' + codecInfo.height : '—';
}

/* ================================================================
   Main Processing Pipeline
   ================================================================ */
function processFile(file, fileBuffer) {
	hideMessages();
	showProcessing('正在检测文件格式...');

	// Detect format
	var format = detectFormat(fileBuffer);
	if (!format) {
		hideProcessing();
		showError('无法识别文件格式，请上传 .h264 / .h265 / .hevc / .mp4 / .m4v / .mov 文件');
		return;
	}

	updateFileInfoBar(file, format, null);

	var nalUnits = [];
	var codecInfo = null;
	var mp4FrameInfo = null;
	var moovBox = null;
	var mdatBox = null;

	if (format === 'mp4') {
		showProcessing('正在解析 MP4 容器...');

		// Parse MP4 boxes
		var boxes = parseMP4Boxes(fileBuffer, 0, fileBuffer.byteLength);
		moovBox = findBoxByType(boxes, 'moov');
		mdatBox = findBoxByType(boxes, 'mdat');

		if (!moovBox) {
			hideProcessing();
			showError('MP4 文件缺少 moov box，可能是不完整或损坏的文件');
			return;
		}
		if (!mdatBox) {
			hideProcessing();
			showError('MP4 文件缺少 mdat box，可能是不完整或损坏的文件');
			return;
		}

		codecInfo = extractMP4CodecInfo(moovBox);
		if (!codecInfo || !codecInfo.codec) {
			hideProcessing();
			showError('无法从 MP4 中提取编码信息，可能是不支持的编码格式');
			return;
		}

		// Extract raw NAL units
		var rawNALUs = extractMP4RawNALUs(mdatBox, codecInfo.nalLengthSize);
		showProcessing('正在分析 NAL 单元... (' + rawNALUs.length + ' 个)');

		// Build NAL unit list from raw NALUs
		var startCode = new Uint8Array([0, 0, 0, 1]);
		for (var ni = 0; ni < rawNALUs.length; ni++) {
			var rawNalu = rawNALUs[ni];
			if (rawNalu.length < 1) continue;
			var naluObj = {
				offset: ni, // virtual offset
				startCodeLen: 4,
				dataOffset: 0,
				size: rawNalu.length,
				data: rawNalu,
				frameType: null,
				type: null,
				typeName: '?',
				layerId: 0
			};

			if (codecInfo.codec === 'h265') {
				if (rawNalu.length >= 2) {
					var hdr = parseH265NALHeader(rawNalu);
					if (hdr) {
						var h265type = hdr.type;
						naluObj.type = H265_NAL_NAMES[h265type] || ('TYPE_' + h265type);
						naluObj.typeName = naluObj.type;
						naluObj.layerId = hdr.layerId;

						if (h265type === 32) naluObj.type = 'VPS';
						else if (h265type === 33) naluObj.type = 'SPS';
						else if (h265type === 34) naluObj.type = 'PPS';
						else if (h265type === 39 || h265type === 40) naluObj.type = h265type === 39 ? 'PREFIX_SEI' : 'SUFFIX_SEI';
						else if (h265type === 35) naluObj.type = 'AUD';

						// Parse SPS for resolution
						if (h265type === 33 && !codecInfo.width) {
							var spsInfo = parseH265SPS(rawNalu);
							if (spsInfo) {
								codecInfo.width = spsInfo.width;
								codecInfo.height = spsInfo.height;
							}
						}

						// Parse slice header for frame type
						if ((h265type <= 9) || (h265type >= 16 && h265type <= 21)) {
							var sh = parseH265SliceHeader(rawNalu);
							if (sh && sh.frameType) {
								naluObj.frameType = sh.frameType;
							} else if (h265type === 19 || h265type === 20 || h265type === 16 || h265type === 17 || h265type === 18 || h265type === 21) {
								naluObj.frameType = 'I'; // IRAP pictures
							}
						}
					}
				}
			} else {
				// H.264
				if (rawNalu.length >= 1) {
					var hdr = parseH264NALHeader(rawNalu);
					if (hdr) {
						var h264type = hdr.type;
						naluObj.typeName = H264_NAL_NAMES[h264type] || ('TYPE_' + h264type);
						naluObj.type = naluObj.typeName;

						if (h264type === 7) naluObj.type = 'SPS';
						else if (h264type === 8) naluObj.type = 'PPS';
						else if (h264type === 6) naluObj.type = 'SEI';
						else if (h264type === 9) naluObj.type = 'AUD';

						// Parse SPS
						if (h264type === 7 && !codecInfo.width) {
							var spsInfo = parseH264SPS(rawNalu);
							if (spsInfo) {
								codecInfo.width = spsInfo.width;
								codecInfo.height = spsInfo.height;
								codecInfo.profileIdc = spsInfo.profileIdc;
								codecInfo.levelIdc = spsInfo.levelIdc;
								codecInfo.profileName = spsInfo.profileName;
								codecInfo.fps = spsInfo.fps;
							}
						}

						// Parse slice header
						if (h264type === 1 || h264type === 5) {
							if (h264type === 5) {
								naluObj.frameType = 'I'; // IDR
							} else if (h264type === 1) {
								var sh = parseH264SliceHeader(rawNalu);
								if (sh && sh.frameType) {
									naluObj.frameType = sh.frameType;
								}
							}
						}
					}
				}
			}

			nalUnits.push(naluObj);
		}

		// Build MP4 frame info
		showProcessing('正在提取 MP4 帧信息...');
		var stbl = findBoxByPath(moovBox.children, ['trak', 'mdia', 'minf', 'stbl']);
		if (stbl) {
			mp4FrameInfo = buildMP4FrameInfo(stbl, codecInfo);
		}
	} else {
		// Raw Annex B stream
		showProcessing('正在扫描 NAL 单元...');
		var rawNALUnits = findNALUnits(fileBuffer, 0, fileBuffer.byteLength);
		if (rawNALUnits.length === 0) {
			hideProcessing();
			showError('未找到任何 NAL 单元，请确认文件是有效的 H.264/H.265 原始码流');
			return;
		}

		codecInfo = { codec: format, profileIdc: 0, levelIdc: 0, width: null, height: null, fps: null };
		showProcessing('正在解析 ' + rawNALUnits.length + ' 个 NAL 单元...');

		for (var ni = 0; ni < rawNALUnits.length; ni++) {
			var rawNalu = rawNALUnits[ni];
			if (rawNalu.data.length < 1) continue;

			var naluObj = {
				offset: rawNalu.offset,
				startCodeLen: rawNalu.startCodeLen,
				dataOffset: rawNalu.dataOffset,
				size: rawNalu.size,
				data: rawNalu.data,
				frameType: null,
				type: null,
				typeName: '?',
				layerId: 0
			};

			if (format === 'h265') {
				if (rawNalu.data.length >= 2) {
					var hdr = parseH265NALHeader(rawNalu.data);
					if (hdr) {
						var h265type = hdr.type;
						naluObj.typeName = H265_NAL_NAMES[h265type] || ('TYPE_' + h265type);
						naluObj.layerId = hdr.layerId;

						if (h265type === 32) naluObj.type = 'VPS';
						else if (h265type === 33) naluObj.type = 'SPS';
						else if (h265type === 34) naluObj.type = 'PPS';
						else if (h265type === 39 || h265type === 40) naluObj.type = h265type === 39 ? 'PREFIX_SEI' : 'SUFFIX_SEI';
						else if (h265type === 35) naluObj.type = 'AUD';
						else naluObj.type = naluObj.typeName;

						if (h265type === 33 && !codecInfo.width) {
							var spsInfo = parseH265SPS(rawNalu.data);
							if (spsInfo) {
								codecInfo.width = spsInfo.width;
								codecInfo.height = spsInfo.height;
							}
						}

						if ((h265type <= 9) || (h265type >= 16 && h265type <= 21)) {
							var sh = parseH265SliceHeader(rawNalu.data);
							if (sh && sh.frameType) {
								naluObj.frameType = sh.frameType;
							} else if (h265type === 19 || h265type === 20 || h265type === 16 || h265type === 17 || h265type === 18 || h265type === 21) {
								naluObj.frameType = 'I';
							}
						}
					}
				}
			} else {
				// H.264
				if (rawNalu.data.length >= 1) {
					var hdr = parseH264NALHeader(rawNalu.data);
					if (hdr) {
						var h264type = hdr.type;
						naluObj.typeName = H264_NAL_NAMES[h264type] || ('TYPE_' + h264type);
						naluObj.type = naluObj.typeName;

						if (h264type === 7) naluObj.type = 'SPS';
						else if (h264type === 8) naluObj.type = 'PPS';
						else if (h264type === 6) naluObj.type = 'SEI';
						else if (h264type === 9) naluObj.type = 'AUD';

						if (h264type === 7 && !codecInfo.width) {
							var spsInfo = parseH264SPS(rawNalu.data);
							if (spsInfo) {
								codecInfo.width = spsInfo.width;
								codecInfo.height = spsInfo.height;
								codecInfo.profileIdc = spsInfo.profileIdc;
								codecInfo.levelIdc = spsInfo.levelIdc;
								codecInfo.profileName = spsInfo.profileName;
								codecInfo.fps = spsInfo.fps;
							}
						}

						if (h264type === 1 || h264type === 5) {
							if (h264type === 5) {
								naluObj.frameType = 'I';
							} else {
								var sh = parseH264SliceHeader(rawNalu.data);
								if (sh && sh.frameType) {
									naluObj.frameType = sh.frameType;
								}
							}
						}
					}
				}
			}

			nalUnits.push(naluObj);
		}
	}

	// Run analysis
	showProcessing('正在分析码流结构...');
	var analysisResult = analyzeBitstream(nalUnits, mp4FrameInfo, codecInfo);
	analysisResult._nalUnits = nalUnits; // attach for table rendering

	// Update file info
	updateFileInfoBar(file, format, codecInfo);

	// Render results
	hideProcessing();
	renderAll(analysisResult, codecInfo);

	// Update tab to summary
	switchTab('summary');

	// Store state for conversion
	window._analyzerState = {
		file: file,
		fileBuffer: fileBuffer,
		format: format,
		nalUnits: nalUnits,
		codecInfo: codecInfo,
		analysisResult: analysisResult,
		moovBox: moovBox,
		mdatBox: mdatBox
	};
}

/* ================================================================
   UI Event Handlers
   ================================================================ */
function switchTab(tabName) {
	var tabs = document.querySelectorAll('.tab-btn');
	for (var i = 0; i < tabs.length; i++) {
		tabs[i].classList.toggle('active', tabs[i].getAttribute('data-tab') === tabName);
	}
	var contents = document.querySelectorAll('.tab-content');
	for (var i = 0; i < contents.length; i++) {
		contents[i].classList.toggle('active', contents[i].id === 'tab' + tabName.charAt(0).toUpperCase() + tabName.slice(1));
	}
	// Re-render charts for newly visible tab (fixes zero-width rendering in hidden tabs)
	var state = window._analyzerState;
	if (!state || !state.analysisResult) return;
	setTimeout(function() {
		if (tabName === 'gop') renderGOPView(state.analysisResult);
		else if (tabName === 'sizes') renderFrameSizeChart(state.analysisResult);
		else if (tabName === 'summary') renderFrameTypeChart(state.analysisResult);
	}, 50);
}

function handleFileSelect(file) {
	if (!file) return;
	hideMessages();

	// Check size
	if (file.size === 0) {
		showError('文件为空');
		return;
	}
	if (file.size > 500 * 1024 * 1024) {
		showWarning('文件较大（>500MB），解析可能需要较长时间，页面可能会暂时无响应');
	}

	document.getElementById('uploadStatus').textContent = '正在读取文件...';

	var reader = new FileReader();
	reader.onload = function(e) {
		document.getElementById('uploadStatus').textContent = '已选择: ' + file.name + ' (' + fmtSize(file.size) + ')';
		document.getElementById('toolLayout').style.display = 'grid';
		document.getElementById('emptyState').style.display = 'none';

		// Store for later processing
		window._pendingFile = file;
		window._pendingBuffer = e.target.result;
	};
	reader.onerror = function() {
		showError('文件读取失败，请重试');
		document.getElementById('uploadStatus').textContent = '读取失败，请重新选择文件';
	};
	reader.readAsArrayBuffer(file);
}

/* ================================================================
   Initialization
   ================================================================ */
(function init() {
	// DOM references
	var uploadZone = document.getElementById('uploadZone');
	var fileInput = document.getElementById('fileInput');
	var analyzeBtn = document.getElementById('analyzeBtn');
	var resetBtn = document.getElementById('resetBtn');
	var convertBtn = document.getElementById('convertBtn');
	var downloadConvertedBtn = document.getElementById('downloadConvertedBtn');
	var convertBtns = document.getElementById('convertBtns');

	// Upload: click
	uploadZone.addEventListener('click', function() {
		fileInput.click();
	});

	// Upload: file selected
	fileInput.addEventListener('change', function(e) {
		if (e.target.files && e.target.files.length > 0) {
			handleFileSelect(e.target.files[0]);
		}
	});

	// Upload: drag and drop
	uploadZone.addEventListener('dragover', function(e) {
		e.preventDefault();
		e.stopPropagation();
		uploadZone.classList.add('drag-over');
	});
	uploadZone.addEventListener('dragleave', function(e) {
		e.preventDefault();
		e.stopPropagation();
		uploadZone.classList.remove('drag-over');
	});
	uploadZone.addEventListener('drop', function(e) {
		e.preventDefault();
		e.stopPropagation();
		uploadZone.classList.remove('drag-over');
		if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
			handleFileSelect(e.dataTransfer.files[0]);
		}
	});

	// Prevent default drag behavior on body
	document.addEventListener('dragover', function(e) { e.preventDefault(); });
	document.addEventListener('drop', function(e) { e.preventDefault(); });

	// Analyze button
	analyzeBtn.addEventListener('click', function() {
		if (window._pendingFile && window._pendingBuffer) {
			processFile(window._pendingFile, window._pendingBuffer);
		} else {
			showError('请先选择视频文件');
		}
	});

	// Reset button
	resetBtn.addEventListener('click', function() {
		window._pendingFile = null;
		window._pendingBuffer = null;
		window._analyzerState = null;
		document.getElementById('toolLayout').style.display = 'none';
		document.getElementById('emptyState').style.display = 'block';
		document.getElementById('fileInfoBar').style.display = 'none';
		document.getElementById('codecDetails').style.display = 'none';
		document.getElementById('gopSummary').style.display = 'none';
		document.getElementById('convertSection').style.display = 'none';
		document.getElementById('convertBtn').style.display = 'none';
		document.getElementById('downloadConvertedBtn').style.display = 'none';
		document.getElementById('sizeCompareConvert').style.display = 'none';
		document.getElementById('uploadStatus').textContent = '尚未选择文件';
		hideMessages();
		fileInput.value = '';
	});

	// Tab switching
	document.getElementById('tabBar').addEventListener('click', function(e) {
		var tabBtn = e.target.closest('.tab-btn');
		if (!tabBtn) return;
		switchTab(tabBtn.getAttribute('data-tab'));
	});

	// NAL table filter
	document.getElementById('nalFilterBar').addEventListener('click', function(e) {
		var btn = e.target.closest('.filter-btn');
		if (!btn) return;
		// Update active state
		var allBtns = document.querySelectorAll('#nalFilterBar .filter-btn');
		for (var i = 0; i < allBtns.length; i++) allBtns[i].classList.remove('active');
		btn.classList.add('active');

		var filter = btn.getAttribute('data-filter');
		var rows = document.querySelectorAll('#nalTableBody tr');
		for (var i = 0; i < rows.length; i++) {
			var row = rows[i];
			if (filter === 'all') { row.style.display = ''; continue; }
			var nalType = row.getAttribute('data-nal-type') || '';
			var frameType = row.getAttribute('data-frame-type') || '';
			if (filter === 'slice') {
				row.style.display = (frameType === 'I' || frameType === 'P' || frameType === 'B') ? '' : 'none';
			} else {
				row.style.display = (nalType.toLowerCase() === filter.toLowerCase()) ? '' : 'none';
			}
		}
	});

	// Frame table filter
	document.getElementById('frameFilterBar').addEventListener('click', function(e) {
		var btn = e.target.closest('.filter-btn');
		if (!btn) return;
		var allBtns = document.querySelectorAll('#frameFilterBar .filter-btn');
		for (var i = 0; i < allBtns.length; i++) allBtns[i].classList.remove('active');
		btn.classList.add('active');

		var filter = btn.getAttribute('data-filter');
		var rows = document.querySelectorAll('#frameTableBody tr');
		for (var i = 0; i < rows.length; i++) {
			var row = rows[i];
			if (filter === 'all') { row.style.display = ''; continue; }
			var ft = row.getAttribute('data-frame-type') || '';
			row.style.display = (ft === filter) ? '' : 'none';
		}
	});

	// Conversion target selection
	convertBtns.addEventListener('click', function(e) {
		var btn = e.target.closest('.format-btn');
		if (!btn) return;
		var allBtns = convertBtns.querySelectorAll('.format-btn');
		for (var i = 0; i < allBtns.length; i++) allBtns[i].classList.remove('active');
		btn.classList.add('active');
	});

	// Convert button
	convertBtn.addEventListener('click', function() {
		var state = window._analyzerState;
		if (!state) { showError('请先解析码流'); return; }

		var activeBtn = convertBtns.querySelector('.format-btn.active');
		var direction = activeBtn ? activeBtn.getAttribute('data-convert') : 'toRaw';

		showProcessing('正在转换...');
		setTimeout(function() {
			try {
				if (direction === 'toRaw') {
					// MP4 → Raw
					if (state.format !== 'mp4') {
						hideProcessing();
						showError('导出原始码流仅适用于 MP4 文件。当前文件已是原始码流格式。');
						return;
					}
					if (!state.mdatBox) {
						hideProcessing();
						showError('无法提取 mdat 数据');
						return;
					}
					var rawData = convertMP4ToRawAnnexB(state.fileBuffer, state.codecInfo, state.moovBox, state.mdatBox);
					if (!rawData) {
						hideProcessing();
						showError('转换失败：无法提取视频数据');
						return;
					}
					var ext = state.codecInfo.codec === 'h265' ? 'h265' : 'h264';
					window._convertedData = rawData;
					window._convertedExt = ext;
					showConvertResult(state.file.size, rawData.length, ext);
				} else {
					// Raw → MP4
					if (state.format === 'mp4') {
						hideProcessing();
						showError('转换为 MP4 仅适用于原始码流文件。当前文件已是 MP4 格式。');
						return;
					}
					var result = convertRawToMP4(state.fileBuffer, state.format);
					if (result.error) {
						hideProcessing();
						showError('转换失败：' + result.error);
						return;
					}
					window._convertedData = result.data;
					window._convertedExt = result.ext;
					showConvertResult(state.file.size, result.data.length, 'mp4');
				}
				hideProcessing();
			} catch(err) {
				hideProcessing();
				showError('转换过程出错：' + (err.message || err));
			}
		}, 50);
	});

	// Download converted file
	downloadConvertedBtn.addEventListener('click', function() {
		var data = window._convertedData;
		var ext = window._convertedExt;
		var state = window._analyzerState;
		if (!data || !state) return;

		var origName = state.file.name;
		var baseName = origName.replace(/\.[^.]+$/, '');
		var newName = 'converted-' + baseName + '.' + ext;

		var blob = new Blob([data], { type: 'application/octet-stream' });
		var url = URL.createObjectURL(blob);
		var a = document.createElement('a');
		a.href = url;
		a.download = newName;
		document.body.appendChild(a);
		a.click();
		document.body.removeChild(a);
		URL.revokeObjectURL(url);
	});

	function showConvertResult(origSize, newSize, newExt) {
		document.getElementById('downloadConvertedBtn').style.display = 'inline-block';
		var compareDiv = document.getElementById('sizeCompareConvert');
		compareDiv.style.display = 'block';

		var maxSize = Math.max(origSize, newSize);
		var origPct = (origSize / maxSize * 100).toFixed(1);
		var newPct = (newSize / maxSize * 100).toFixed(1);
		var delta = newSize - origSize;
		var deltaPct = origSize > 0 ? (Math.abs(delta) / origSize * 100).toFixed(1) : '0';
		var deltaClass = delta <= 0 ? 'smaller' : 'larger';
		var deltaSign = delta <= 0 ? '-' : '+';

		compareDiv.innerHTML =
			'<div class="size-compare-label">文件大小对比</div>' +
			'<div class="size-bar-wrap">' +
			'<span class="size-bar-label">原始</span>' +
			'<div class="size-bar-track"><div class="size-bar-fill original" style="width:' + origPct + '%"></div></div>' +
			'<span class="size-bar-size">' + fmtSize(origSize) + '</span>' +
			'</div>' +
			'<div class="size-bar-wrap">' +
			'<span class="size-bar-label">转换后</span>' +
			'<div class="size-bar-track"><div class="size-bar-fill converted" style="width:' + newPct + '%"></div></div>' +
			'<span class="size-bar-size">' + fmtSize(newSize) + '</span>' +
			'</div>' +
			'<div class="size-delta ' + deltaClass + '">' + deltaSign + deltaPct + '% (' + fmtSize(Math.abs(delta)) + ') → .' + newExt + '</div>';
			applyCID(compareDiv);
	}
})();
})();
</script>
</body>
</html>
