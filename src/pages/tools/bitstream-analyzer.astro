			if (v2 === 0 || v2 === 1 || v2 === 2) {
				sliceType = v2;
			} else if (reader2.hasMore()) {
				var v3 = reader2.readUE();
				if (v3 === 0 || v3 === 1 || v3 === 2) {
					sliceType = v3;
				}
			}
		}

		return {
			sliceType: sliceType,
			frameType: H265_SLICE_TYPES[sliceType] || null
		};
	} catch(e) {
		return null;
	}
}

function parseH265SPS(naluData) {
	if (naluData.length < 4) return null;
	try {
		var reader = new BitReader(naluData.buffer, naluData.byteOffset + 2, naluData.length - 2);
		var vpsId = reader.readBits(4);
		var maxSubLayersMinus1 = reader.readBits(3);
		reader.readBits(1); // temporal_id_nesting_flag

		// Skip profile_tier_level (complex)
		skipProfileTierLevel(reader, true, maxSubLayersMinus1);

		var spsId = reader.readUE();
		var chromaFormatIdc = reader.readUE();
		if (chromaFormatIdc === 3) { reader.readBits(1); } // separate_colour_plane_flag

		var picWidth = reader.readUE();
		var picHeight = reader.readUE();

		var conformanceWindowFlag = reader.readBits(1);
		var confWinLeft = 0, confWinRight = 0, confWinTop = 0, confWinBottom = 0;
		if (conformanceWindowFlag) {
			confWinLeft = reader.readUE();
			confWinRight = reader.readUE();
			confWinTop = reader.readUE();
			confWinBottom = reader.readUE();
		}

		var SubWidthC = chromaFormatIdc === 1 ? 2 : (chromaFormatIdc === 0 ? 1 : 1);
		var SubHeightC = chromaFormatIdc === 1 ? 2 : (chromaFormatIdc === 0 ? 1 : 1);

		return {
			width: picWidth - (confWinLeft + confWinRight) * SubWidthC,
			height: picHeight - (confWinTop + confWinBottom) * SubHeightC,
			chromaFormatIdc: chromaFormatIdc
		};
	} catch(e) {
		return null;
	}
}

function skipProfileTierLevel(reader, profilePresentFlag, maxSubLayersMinus1) {
	if (profilePresentFlag) {
		reader.readBits(2); // general_profile_space
		reader.readBits(1); // general_tier_flag
		reader.readBits(5); // general_profile_idc
		// 32 profile compatibility flags
		for (var i = 0; i < 32; i++) reader.readBits(1);
		reader.readBits(1); // progressive_source_flag
		reader.readBits(1); // interlaced_source_flag
		reader.readBits(1); // non_packed_constraint_flag
		reader.readBits(1); // frame_only_constraint_flag
		// Remaining constraint flags (varies by version, ~40 more bits)
		for (var j = 0; j < 43; j++) {
			if (!reader.hasMore()) break;
			reader.readBits(1);
		}
		if (reader.hasMore()) reader.readBits(1); // inbld_flag
	}
	reader.readBits(8); // general_level_idc
	if (maxSubLayersMinus1 > 0) {
		var subLayerProfilePresent = [];
		var subLayerLevelPresent = [];
		for (var k = 0; k < maxSubLayersMinus1; k++) {
			subLayerProfilePresent[k] = reader.readBits(1);
			subLayerLevelPresent[k] = reader.readBits(1);
		}
		// Skip remaining sub-layer profile/level info
		// (simplification: skip the rest)
	}
}

/* ================================================================
   MP4 Parser
   ================================================================ */
var MP4_CONTAINER_TYPES = {
	moov: true, trak: true, mdia: true, minf: true, stbl: true,
	dinf: true, edts: true, udta: true, moof: true, mvex: true
};

function parseMP4Boxes(buffer, offset, length) {
	var boxes = [];
	var endOffset = (offset || 0) + (length || (buffer.byteLength - (offset || 0)));
	var pos = offset || 0;

	while (pos + 8 <= endOffset) {
		var view = new DataView(buffer, pos, Math.min(16, endOffset - pos));
		var size = view.getUint32(0);
		var type = String.fromCharCode(
			view.getUint8(4), view.getUint8(5), view.getUint8(6), view.getUint8(7)
		);
		var headerSize = 8;
		var dataOffset = pos + 8;

		// Handle 64-bit size
		if (size === 1) {
			if (pos + 16 > endOffset) break;
			size = Number(view.getBigUint64(8));
			if (size > Number.MAX_SAFE_INTEGER) size = endOffset - pos; // clamp
			headerSize = 16;
			dataOffset = pos + 16;
		} else if (size === 0) {
			size = endOffset - pos; // extends to end
		}

		if (size < headerSize || pos + size > endOffset + 8) {
			// Invalid size, try to recover
			break;
		}

		var children = [];
		var data = null;
		if (MP4_CONTAINER_TYPES[type]) {
			children = parseMP4Boxes(buffer, dataOffset, size - headerSize);
		} else {
			data = new Uint8Array(buffer, dataOffset, size - headerSize);
		}

		boxes.push({
			type: type,
			offset: pos,
			totalSize: size,
			data: data,
			children: children
		});

		pos += size;
	}

	return boxes;
}

function findBoxByType(boxes, type) {
	for (var i = 0; i < boxes.length; i++) {
		if (boxes[i].type === type) return boxes[i];
	}
	return null;
}

function findBoxByPath(boxes, path) {
	var current = boxes;
	for (var i = 0; i < path.length; i++) {
		var found = null;
		for (var j = 0; j < current.length; j++) {
			if (current[j].type === path[i]) {
				found = current[j];
				break;
			}
		}
		if (!found) return null;
		current = found.children || [];
	}
	return current;
}

function extractMP4CodecInfo(moovBox) {
	var stbl = findBoxByPath(moovBox.children, ['trak', 'mdia', 'minf', 'stbl']);
	if (!stbl) return null;

	var stsd = findBoxByType(stbl, 'stsd');
	if (!stsd || !stsd.data || stsd.data.length < 16) return null;

	// stsd layout: version(1) + flags(3) + entry_count(4) + entries...
	var entryCount = new DataView(stsd.data.buffer, stsd.data.byteOffset + 4, 4).getUint32(0);
	if (entryCount < 1) return null;

	// First entry starts at offset 8 in stsd data
	var entryOffset = 8;
	if (entryOffset + 8 > stsd.data.length) return null;
	var entrySize = new DataView(stsd.data.buffer, stsd.data.byteOffset + entryOffset, 4).getUint32(0);
	var entryType = String.fromCharCode(
		stsd.data[entryOffset + 4], stsd.data[entryOffset + 5],
		stsd.data[entryOffset + 6], stsd.data[entryOffset + 7]
	);
	// Entry data (after size + type fields)
	var entryDataLen = Math.min(entrySize - 8, stsd.data.length - entryOffset - 8);
	var entryData = new Uint8Array(stsd.data.buffer,
		stsd.data.byteOffset + entryOffset + 8, entryDataLen);

	var codec = null;
	var codecConfigData = null;
	var nalLengthSize = 4; // default
	var spsDataArray = [];
	var ppsDataArray = [];
	var vpsDataArray = [];
	var profileIdc = 0;
	var levelIdc = 0;

	// Try to find codec config — first as a box (size+type prefix), then at fixed offset
	function findCodecConfig(entryData, configType) {
		// Method 1: search for box header (size + type)
		var box = findBoxInData(entryData, configType);
		if (box && box.length >= 7) return box;

		// Method 2: look at standard offset for codec config box
		// entryData starts at SampleEntry fields:
		//   reserved(6) + data_reference_index(2) + VisualSampleEntry(70) = 78 bytes
		// The codec config box (avcC/hvcC) starts at offset 78
		if (entryData.length >= 86 && entryData[78] === 1) {
			return new Uint8Array(entryData.buffer, entryData.byteOffset + 78, entryData.length - 78);
		}
		// Method 3: some encoders use offset 70 (if entryData excludes SampleEntry header)
		if (entryData.length >= 78 && entryData[70] === 1) {
			return new Uint8Array(entryData.buffer, entryData.byteOffset + 70, entryData.length - 70);
		}
		// Method 4: scan for configurationVersion=1 followed by valid-looking profile/level
		for (var i = 8; i < entryData.length - 10; i++) {
			if (entryData[i] === 1) {
				// Check if the next few bytes look like a codec config
				// avcC: [1][profile][compat][level][0xFF|0xFC][0xE0|...]
				if (i + 7 < entryData.length && (entryData[i+4] === 0xFF || entryData[i+4] === 0xFC)) {
					return new Uint8Array(entryData.buffer, entryData.byteOffset + i, entryData.length - i);
				}
				// hvcC: [1][general_profile_space+tier+profile][compat flags...][constraint...]
				if (i + 23 < entryData.length) {
					var lengthSizeField = entryData[i + 21];
					if ((lengthSizeField & 0x03) <= 3) {
						return new Uint8Array(entryData.buffer, entryData.byteOffset + i, entryData.length - i);
					}
				}
			}
		}
		return null;
	}

	if (entryType === 'avc1' || entryType === 'avc3' || entryType === 'avcC') {
		codec = 'h264';
		var avcC = findCodecConfig(entryData, 'avcC');
		if (avcC && avcC.length >= 7) {
			codecConfigData = avcC;
			profileIdc = avcC[1];
			levelIdc = avcC[3];
			nalLengthSize = (avcC[4] & 0x03) + 1;
			var numSPS = avcC[5] & 0x1F;
			var cpos = 6;
			for (var si = 0; si < numSPS && cpos + 2 <= avcC.length; si++) {
				var spsLen = (avcC[cpos] << 8) | avcC[cpos + 1];
				cpos += 2;
				if (cpos + spsLen <= avcC.length) {
					spsDataArray.push(new Uint8Array(avcC.buffer, avcC.byteOffset + cpos, spsLen));
					cpos += spsLen;
				}
			}
			if (cpos < avcC.length) {
				var numPPS = avcC[cpos];
				cpos++;
				for (var pi = 0; pi < numPPS && cpos + 2 <= avcC.length; pi++) {
					var ppsLen = (avcC[cpos] << 8) | avcC[cpos + 1];
					cpos += 2;
					if (cpos + ppsLen <= avcC.length) {
						ppsDataArray.push(new Uint8Array(avcC.buffer, avcC.byteOffset + cpos, ppsLen));
						cpos += ppsLen;
					}
				}
			}
		}
	} else if (entryType === 'hvc1' || entryType === 'hev1') {
		codec = 'h265';
		var hvcC = findCodecConfig(entryData, 'hvcC');
		if (hvcC && hvcC.length >= 23) {
			codecConfigData = hvcC;
			profileIdc = hvcC[1] & 0x1F; // general_profile_idc
			levelIdc = hvcC[12]; // general_level_idc
			nalLengthSize = (hvcC[21] & 0x03) + 1;
			// Parse parameter set arrays
			var numArrays = hvcC[22];
			var hpos = 23;
			for (var ai = 0; ai < numArrays && hpos + 3 <= hvcC.length; ai++) {
				var arrayType = hvcC[hpos] & 0x0F; // 0=VPS, 1=SPS, 2=PPS, 3=SEI
				var numNalus = (hvcC[hpos + 1] << 8) | hvcC[hpos + 2];
				hpos += 3;
				for (var ni = 0; ni < numNalus && hpos + 2 <= hvcC.length; ni++) {
					var naluLen = (hvcC[hpos] << 8) | hvcC[hpos + 1];
					hpos += 2;
					if (hpos + naluLen <= hvcC.length) {
						var naluArr = new Uint8Array(hvcC.buffer, hvcC.byteOffset + hpos, naluLen);
						if (arrayType === 0) vpsDataArray.push(naluArr);
						else if (arrayType === 1) spsDataArray.push(naluArr);
						else if (arrayType === 2) ppsDataArray.push(naluArr);
						hpos += naluLen;
					}
				}
			}
		}
	}

	return {
		codec: codec,
		profileIdc: profileIdc,
		levelIdc: levelIdc,
		nalLengthSize: nalLengthSize,
		spsData: spsDataArray,
		ppsData: ppsDataArray,
		vpsData: vpsDataArray,
		codecConfigData: codecConfigData,
		entryType: entryType
	};
}

function findBoxInData(data, boxType) {
	// Search for a box type within a byte array
	for (var i = 0; i < data.length - 8; i++) {
		if (data[i+4] === boxType.charCodeAt(0) && data[i+5] === boxType.charCodeAt(1) &&
			data[i+6] === boxType.charCodeAt(2) && data[i+7] === boxType.charCodeAt(3)) {
			var size = (data[i] << 24) | (data[i+1] << 16) | (data[i+2] << 8) | data[i+3];
			if (size >= 8 && i + size <= data.length) {
				return new Uint8Array(data.buffer, data.byteOffset + i + 8, size - 8);
			}
		}
	}
	return null;
}

function extractMP4SyncSamples(stbl) {
	var stss = findBoxByType(stbl, 'stss');
	if (!stss || !stss.data || stss.data.length < 8) return [];
	var view = new DataView(stss.data.buffer, stss.data.byteOffset, stss.data.length);
	var entryCount = view.getUint32(4);
	var samples = [];
	for (var i = 0; i < entryCount && 8 + i * 4 < stss.data.length; i++) {
		samples.push(view.getUint32(8 + i * 4)); // 1-based sample index
	}
	return samples;
}

function extractMP4SampleSizes(stbl) {
	var stsz = findBoxByType(stbl, 'stsz');
	if (!stsz || !stsz.data || stsz.data.length < 12) return [];
	var view = new DataView(stsz.data.buffer, stsz.data.byteOffset, stsz.data.length);
	var sampleSize = view.getUint32(4);
	var sampleCount = view.getUint32(8);
	var sizes = [];
	if (sampleSize > 0) {
		// All samples have same size
		for (var i = 0; i < sampleCount; i++) sizes.push(sampleSize);
	} else {
		for (var i = 0; i < sampleCount && 12 + i * 4 < stsz.data.length; i++) {
			sizes.push(view.getUint32(12 + i * 4));
		}
	}
	return sizes;
}

function extractMP4SampleDurations(stbl) {
	var stts = findBoxByType(stbl, 'stts');
	if (!stts || !stts.data || stts.data.length < 8) return [];
	var view = new DataView(stts.data.buffer, stts.data.byteOffset, stts.data.length);
	var entryCount = view.getUint32(4);
	var durations = [];
	for (var i = 0; i < entryCount && 8 + i * 8 < stts.data.length; i++) {
		var count = view.getUint32(8 + i * 8);
		var delta = view.getUint32(12 + i * 8);
		for (var j = 0; j < count; j++) durations.push(delta);
	}
	return durations;
}

function extractMP4CompositionOffsets(stbl) {
	var ctts = findBoxByType(stbl, 'ctts');
	if (!ctts || !ctts.data || ctts.data.length < 8) return [];
	var view = new DataView(ctts.data.buffer, ctts.data.byteOffset, ctts.data.length);
	var entryCount = view.getUint32(4);
	var offsets = [];
	for (var i = 0; i < entryCount && 8 + i * 8 < ctts.data.length; i++) {
		var count = view.getUint32(8 + i * 8);
		var offs = view.getInt32(12 + i * 8);
		for (var j = 0; j < count; j++) offsets.push(offs);
	}
	return offsets;
}

function extractMP4ChunkOffsets(stbl) {
	var stco = findBoxByType(stbl, 'stco');
	if (!stco || !stco.data || stco.data.length < 8) {
		var co64 = findBoxByType(stbl, 'co64');
		if (!co64 || !co64.data || co64.data.length < 8) return [];
		var view64 = new DataView(co64.data.buffer, co64.data.byteOffset, co64.data.length);
		var count64 = view64.getUint32(4);
		var offs64 = [];
		for (var i = 0; i < count64 && 8 + i * 8 < co64.data.length; i++) {
			offs64.push(Number(view64.getBigUint64(8 + i * 8)));
		}
		return offs64;
	}
	var view = new DataView(stco.data.buffer, stco.data.byteOffset, stco.data.length);
	var entryCount = view.getUint32(4);
	var offsets = [];
	for (var i = 0; i < entryCount && 8 + i * 4 < stco.data.length; i++) {
		offsets.push(view.getUint32(8 + i * 4));
	}
	return offsets;
}

function extractMP4RawNALUs(mdatBox, nalLengthSize) {
	var data = mdatBox.data;
	if (!data) return [];
	var nalus = [];
	var offset = 0;
	var dv = new DataView(data.buffer, data.byteOffset, data.length);
	while (offset + nalLengthSize <= data.length) {
		var naluLen = 0;
		for (var i = 0; i < nalLengthSize; i++) {
			naluLen = (naluLen << 8) | dv.getUint8(offset + i);
		}
		if (naluLen === 0 || offset + nalLengthSize + naluLen > data.length) break;
		nalus.push(new Uint8Array(data.buffer, data.byteOffset + offset + nalLengthSize, naluLen));
		offset += nalLengthSize + naluLen;
	}
	return nalus;
}

function buildMP4FrameInfo(stbl, codecInfo) {
	var syncSamples = extractMP4SyncSamples(stbl);
	var sampleSizes = extractMP4SampleSizes(stbl);
	var durations = extractMP4SampleDurations(stbl);
	var compOffsets = extractMP4CompositionOffsets(stbl);
	var syncSet = {};
	for (var i = 0; i < syncSamples.length; i++) {
		syncSet[syncSamples[i] - 1] = true; // convert to 0-based
	}

	var frames = [];
	var totalSamples = sampleSizes.length;
	var dts = 0;

	for (var i = 0; i < totalSamples; i++) {
		// Determine frame type
		var frameType = '?';
		if (syncSet[i]) {
			frameType = 'I';
		} else if (compOffsets.length > i && compOffsets[i] !== 0) {
			// Non-zero composition offset typically means B-frame
			frameType = 'B';
		} else {
			frameType = 'P';
		}

		var pts = dts;
		if (compOffsets.length > i) {
			pts = dts + compOffsets[i];
		}

		frames.push({
			index: i,
			type: frameType,
			size: sampleSizes[i] || 0,
			dts: dts,
			pts: pts,
			isSync: !!syncSet[i]
		});

		if (durations.length > i) {
			dts += durations[i];
		}
	}

	return frames;
}

/* ================================================================
   Analysis Engine
   ================================================================ */
function analyzeBitstream(nalUnits, mp4FrameInfo, codecInfo) {
	var frames = [];
	var iCount = 0, pCount = 0, bCount = 0, unknownCount = 0;
	var totalSliceBytes = 0;
	var paramNalCount = 0;
	var seiCount = 0;
	var audCount = 0;

	// Process each NAL unit
	for (var i = 0; i < nalUnits.length; i++) {
		var nalu = nalUnits[i];
		var info = { nalUnitIndex: i, nalUnit: nalu };

		if (nalu.type === 'SPS' || nalu.type === 'PPS' || nalu.type === 'VPS') {
			paramNalCount++;
		} else if (nalu.type === 'SEI' || nalu.type === 'PREFIX_SEI' || nalu.type === 'SUFFIX_SEI') {
			seiCount++;
		} else if (nalu.type === 'AUD') {
			audCount++;
		}

		if (nalu.frameType === 'I') { iCount++; totalSliceBytes += nalu.size; frames.push({ index: frames.length, type: 'I', size: nalu.size, nalUnitIndex: i, timestamp: nalu.timestamp || null }); }
		else if (nalu.frameType === 'P') { pCount++; totalSliceBytes += nalu.size; frames.push({ index: frames.length, type: 'P', size: nalu.size, nalUnitIndex: i, timestamp: nalu.timestamp || null }); }
		else if (nalu.frameType === 'B') { bCount++; totalSliceBytes += nalu.size; frames.push({ index: frames.length, type: 'B', size: nalu.size, nalUnitIndex: i, timestamp: nalu.timestamp || null }); }
		else if (nalu.frameType === '?') { unknownCount++; }
	}

	// If we have MP4 frame info, use that for frame classification instead
	if (mp4FrameInfo && mp4FrameInfo.length > 0) {
		frames = mp4FrameInfo;
		iCount = 0; pCount = 0; bCount = 0; unknownCount = 0;
		totalSliceBytes = 0;
		for (var fi = 0; fi < frames.length; fi++) {
			if (frames[fi].type === 'I') iCount++;
			else if (frames[fi].type === 'P') pCount++;
			else if (frames[fi].type === 'B') bCount++;
			else unknownCount++;
			totalSliceBytes += frames[fi].size;
		}
	}

	// GOP analysis
	var gopInfo = computeGOP(frames);

	// Frame size statistics
	var sizeStats = computeFrameSizeStats(frames);

	// I/P ratio
	var ipRatio = null;
	if (pCount > 0 && iCount > 0) {
		ipRatio = (iCount / pCount).toFixed(4);
	} else if (iCount > 0 && pCount === 0) {
		ipRatio = 'Inf (全I帧)';
	}

	return {
		totalFrames: iCount + pCount + bCount,
		iCount: iCount, pCount: pCount, bCount: bCount, unknownCount: unknownCount,
		ipRatio: ipRatio || 'N/A',
		gopInfo: gopInfo,
		frames: frames,
		sizeStats: sizeStats,
		totalSliceBytes: totalSliceBytes,
		paramNalCount: paramNalCount,
		seiCount: seiCount,
		audCount: audCount,
		nalUnitCount: nalUnits.length
	};
}

function computeGOP(frames) {
	if (frames.length === 0) return { count: 0, sizes: [], avgSize: 0, maxSize: 0, minSize: 0, boundaries: [], isClosed: false };

	var boundaries = [];
	var sizes = [];
	var gopStart = 0;
	var seenI = false;

	for (var i = 0; i < frames.length; i++) {
		if (frames[i].type === 'I') {
			if (seenI && gopStart < i) {
				var gopSize = i - gopStart;
				sizes.push(gopSize);
				boundaries.push({ start: gopStart, end: i - 1, size: gopSize });
			}
			gopStart = i;
			seenI = true;
		}
	}

	// Last GOP
	if (seenI && gopStart < frames.length) {
		var lastSize = frames.length - gopStart;
		sizes.push(lastSize);
		boundaries.push({ start: gopStart, end: frames.length - 1, size: lastSize });
	}

	var totalSize = 0;
	for (var j = 0; j < sizes.length; j++) totalSize += sizes[j];

	return {
		count: sizes.length,
		sizes: sizes,
		avgSize: sizes.length > 0 ? (totalSize / sizes.length).toFixed(1) : 0,
		maxSize: sizes.length > 0 ? Math.max.apply(null, sizes) : 0,
		minSize: sizes.length > 0 ? Math.min.apply(null, sizes) : 0,
		boundaries: boundaries,
		isClosed: frames.length > 0 && frames[0].type === 'I'
	};
}

function computeFrameSizeStats(frames) {
	var iSizes = [], pSizes = [], bSizes = [];
	for (var i = 0; i < frames.length; i++) {
		if (frames[i].type === 'I') iSizes.push(frames[i].size);
		else if (frames[i].type === 'P') pSizes.push(frames[i].size);
		else if (frames[i].type === 'B') bSizes.push(frames[i].size);
	}
	return {
		I: computeStats(iSizes),
		P: computeStats(pSizes),
		B: computeStats(bSizes)
	};
}

function computeStats(arr) {
	if (arr.length === 0) return { total: 0, avg: 0, min: 0, max: 0, count: 0 };
	var total = 0, min = Infinity, max = -Infinity;
	for (var i = 0; i < arr.length; i++) {
		total += arr[i];
		if (arr[i] < min) min = arr[i];
		if (arr[i] > max) max = arr[i];
	}
	return { total: total, avg: Math.round(total / arr.length), min: min, max: max, count: arr.length };
}

/* ================================================================
   Format Conversion
   ================================================================ */
function convertMP4ToRawAnnexB(fileBuffer, codecInfo, moovBox, mdatBox) {
	var spsData = codecInfo.spsData || [];
	var ppsData = codecInfo.ppsData || [];
	var vpsData = codecInfo.vpsData || [];
	var nalLengthSize = codecInfo.nalLengthSize || 4;

	// Extract NAL units from mdat
	var rawNALUs = extractMP4RawNALUs(mdatBox, nalLengthSize);
	if (rawNALUs.length === 0) return null;

	var chunks = [];
	var startCode = new Uint8Array([0, 0, 0, 1]);

	// Prepend VPS (H.265 only)
	for (var vi = 0; vi < vpsData.length; vi++) {
		chunks.push(startCode.slice());
		chunks.push(vpsData[vi]);
	}
	// Prepend SPS
	for (var si = 0; si < spsData.length; si++) {
		chunks.push(startCode.slice());
		chunks.push(spsData[si]);
	}
	// Prepend PPS
	for (var pi = 0; pi < ppsData.length; pi++) {
		chunks.push(startCode.slice());
		chunks.push(ppsData[pi]);
	}

	// Append all NAL units with start codes
	for (var ni = 0; ni < rawNALUs.length; ni++) {
		chunks.push(startCode.slice());
		chunks.push(rawNALUs[ni]);
	}

	return concatChunks(chunks);
}

function convertRawToMP4(rawBuffer, codec) {
	var nalUnits = findNALUnits(rawBuffer, 0, rawBuffer.byteLength);
	if (nalUnits.length === 0) return { error: '未找到任何 NAL 单元' };

	// Classify NAL units
	var spsNALUs = [], ppsNALUs = [], vpsNALUs = [], sliceNALUs = [];
	for (var i = 0; i < nalUnits.length; i++) {
		var nalu = nalUnits[i];
		if (nalu.data.length < 1) continue;

		if (codec === 'h265') {
			if (nalu.data.length < 2) continue;
			var h265type = ((nalu.data[0] & 0x7E) >> 1);
			if (h265type === 32) { vpsNALUs.push(nalu); continue; }
			if (h265type === 33) { spsNALUs.push(nalu); continue; }
			if (h265type === 34) { ppsNALUs.push(nalu); continue; }
			if (h265type <= 21 || (h265type >= 0 && h265type <= 9)) { sliceNALUs.push(nalu); }
		} else {
			// H.264
			var h264type = nalu.data[0] & 0x1F;
			if (h264type === 7) { spsNALUs.push(nalu); continue; }
			if (h264type === 8) { ppsNALUs.push(nalu); continue; }
			if (h264type === 1 || h264type === 5) { sliceNALUs.push(nalu); }
		}
	}

	if (spsNALUs.length === 0) return { error: '未找到 SPS，无法创建 MP4 容器（需参数集）' };
	if (sliceNALUs.length === 0) return { error: '未找到视频切片数据' };

	// Build codec config boxes
	var codecConfigBox = null;
	if (codec === 'h265') {
		codecConfigBox = buildHVCCBox(vpsNALUs, spsNALUs, ppsNALUs);
	} else {
		codecConfigBox = buildAVCCBox(spsNALUs, ppsNALUs);
	}
	if (!codecConfigBox) return { error: '构建编码配置失败' };

	// Build mdat
	var mdatData = buildMDATData(sliceNALUs);
	if (!mdatData) return { error: '构建 mdat 失败' };

	// Build ftyp
	var ftypData = buildFTYPBox(codec);

	// Build moov
	var moovData = buildMOOVBox(codec, codecConfigBox, sliceNALUs, ftypData.length + mdatData.length);
	if (!moovData) return { error: '构建 moov 失败' };

	// Concatenate
	var output = new Uint8Array(ftypData.length + mdatData.length + moovData.length);
	output.set(ftypData, 0);
	output.set(mdatData, ftypData.length);
	output.set(moovData, ftypData.length + mdatData.length);

	var ext = codec === 'h265' ? 'mp4' : 'mp4';
	return { data: output, ext: ext };
}

function concatChunks(chunks) {
	var totalLen = 0;
	for (var i = 0; i < chunks.length; i++) totalLen += chunks[i].length;
	var output = new Uint8Array(totalLen);
	var pos = 0;
	for (var i = 0; i < chunks.length; i++) {
		output.set(chunks[i], pos);
		pos += chunks[i].length;
	}
	return output;
}

function buildFTYPBox(codec) {
	// ftyp box: size(4) + 'ftyp'(4) + major_brand(4) + minor_version(4) + compatible_brands...
	var majorBrand = codec === 'h265' ? 'hvc1' : 'avc1';
	// Simplest ftyp: just major brand + minor version
	var data = new Uint8Array(20);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, 20); // box size
	data[4] = 0x66; data[5] = 0x74; data[6] = 0x79; data[7] = 0x70; // 'ftyp'
	data[8] = majorBrand.charCodeAt(0); data[9] = majorBrand.charCodeAt(1);
	data[10] = majorBrand.charCodeAt(2); data[11] = majorBrand.charCodeAt(3);
	dv.setUint32(12, 0); // minor version
	// compatible brands: isom + major brand
	data[16] = 0x69; data[17] = 0x73; data[18] = 0x6f; data[19] = 0x6d; // 'isom'
	return data;
}

function buildAVCCBox(spsNALUs, ppsNALUs) {
	if (spsNALUs.length === 0) return null;
	var spsData = spsNALUs[0].data;
	var totalSize = 7; // fixed header
	var spsSizes = [];
	var ppsSizes = [];

	for (var i = 0; i < spsNALUs.length; i++) {
		spsSizes.push(spsNALUs[i].data.length);
		totalSize += 2 + spsNALUs[i].data.length;
	}
	var ppsCount = Math.min(ppsNALUs.length, 255);
	for (var j = 0; j < ppsCount; j++) {
		ppsSizes.push(ppsNALUs[j].data.length);
		totalSize += 2 + ppsNALUs[j].data.length;
	}

	var box = new Uint8Array(totalSize);
	box[0] = 1; // configurationVersion
	box[1] = spsData.length > 1 ? spsData[1] : 100; // AVCProfileIndication (from SPS)
	box[2] = spsData.length > 2 ? spsData[2] : 0; // profile_compatibility
	box[3] = spsData.length > 3 ? spsData[3] : 40; // AVCLevelIndication
	box[4] = 0xFF; // reserved(6) + lengthSizeMinusOne(2) = 3 → NAL length = 4 bytes
	box[5] = 0xE0 | (spsNALUs.length & 0x1F); // reserved(3) + numSPS(5)

	var pos = 6;
	for (var si = 0; si < spsNALUs.length; si++) {
		box[pos] = (spsSizes[si] >> 8) & 0xFF;
		box[pos + 1] = spsSizes[si] & 0xFF;
		pos += 2;
		box.set(spsNALUs[si].data, pos);
		pos += spsSizes[si];
	}
	box[pos] = ppsCount & 0xFF;
	pos++;
	for (var pi = 0; pi < ppsCount; pi++) {
		box[pos] = (ppsSizes[pi] >> 8) & 0xFF;
		box[pos + 1] = ppsSizes[pi] & 0xFF;
		pos += 2;
		box.set(ppsNALUs[pi].data, pos);
		pos += ppsSizes[pi];
	}
	return box;
}

function buildHVCCBox(vpsNALUs, spsNALUs, ppsNALUs) {
	if (spsNALUs.length === 0) return null;
	// hvcC structure
	var arrays = [];
	if (vpsNALUs.length > 0) arrays.push({ type: 0, nalus: vpsNALUs });
	if (spsNALUs.length > 0) arrays.push({ type: 1, nalus: spsNALUs });
	if (ppsNALUs.length > 0) arrays.push({ type: 2, nalus: ppsNALUs });

	var totalSize = 23; // fixed header
	for (var ai = 0; ai < arrays.length; ai++) {
		totalSize += 3; // array header
		for (var ni = 0; ni < arrays[ai].nalus.length; ni++) {
			totalSize += 2 + arrays[ai].nalus[ni].data.length;
		}
	}

	var box = new Uint8Array(totalSize);
	var pos = 0;
	box[pos++] = 1; // configurationVersion
	// general_profile_space(2) + general_tier_flag(1) + general_profile_idc(5)
	box[pos++] = 0; // default: general_profile_idc = 0, space=0, tier=0
	box[pos++] = 0; box[pos++] = 0; box[pos++] = 0; // profile compatibility flags (4 bytes)
	// More profile compatibility + constraint indicators (6 bytes)
	var constraintBytes = new Uint8Array(6);
	for (var cbi = 0; cbi < 6; cbi++) box[pos++] = 0;
	box[pos++] = 0; // general_level_idc (set to unknown)
	// reserved(4) + min_spatial_segmentation_idc(12) → 2 bytes
	box[pos++] = 0xF0; box[pos++] = 0x00;
	// reserved(6) + parallelismType(2) → 1 byte
	box[pos++] = 0xFC;
	// reserved(6) + chroma_format_idc(2) → 1 byte
	box[pos++] = 0xFC;
	// reserved(5) + bit_depth_luma_minus8(3) → 1 byte
	box[pos++] = 0xF8;
	// reserved(5) + bit_depth_chroma_minus8(3) → 1 byte
	box[pos++] = 0xF8;
	// avgFrameRate (2 bytes)
	box[pos++] = 0x00; box[pos++] = 0x00;
	// constantFrameRate(2) + numTemporalLayers(3) + temporalIdNested(1) + lengthSizeMinusOne(2) → 1 byte
	box[pos++] = 0x03; // lengthSizeMinusOne = 3 → 4-byte NAL lengths
	// numOfArrays (1 byte)
	box[pos++] = arrays.length & 0xFF;

	for (var ai2 = 0; ai2 < arrays.length; ai2++) {
		var arr = arrays[ai2];
		box[pos++] = (0x80 | (arr.type & 0x0F)); // array_completeness(1) + reserved(1) + NAL_unit_type(6)
		var count = arr.nalus.length;
		box[pos++] = (count >> 8) & 0xFF;
		box[pos++] = count & 0xFF;
		for (var ni2 = 0; ni2 < count; ni2++) {
			var naluLen = arr.nalus[ni2].data.length;
			box[pos++] = (naluLen >> 8) & 0xFF;
			box[pos++] = naluLen & 0xFF;
			box.set(arr.nalus[ni2].data, pos);
			pos += naluLen;
		}
	}
	return box;
}

function buildMDATData(sliceNALUs) {
	// mdat contains all slice NALUs in AVCC format (4-byte length prefix)
	var totalLen = 0;
	for (var i = 0; i < sliceNALUs.length; i++) {
		totalLen += 4 + sliceNALUs[i].data.length;
	}
	var data = new Uint8Array(totalLen);
	var dv = new DataView(data.buffer);
	var pos = 0;
	for (var i = 0; i < sliceNALUs.length; i++) {
		dv.setUint32(pos, sliceNALUs[i].data.length);
		pos += 4;
		data.set(sliceNALUs[i].data, pos);
		pos += sliceNALUs[i].data.length;
	}
	return data;
}

function buildMOOVBox(codec, codecConfigBox, sliceNALUs, mdatOffset) {
	// Calculate timescale and duration
	var timescale = 1000; // default: 1ms units
	var duration = sliceNALUs.length; // 1 sample = 1 tick (we don't know actual frame rate)
	// Actually, use a reasonable default: assume 30fps → duration = samples * 1000/30
	// Better: use timescale=30000, duration=samples*1000
	timescale = 30000;
	duration = sliceNALUs.length * 1000;

	var sampleSizes = [];
	for (var i = 0; i < sliceNALUs.length; i++) {
		sampleSizes.push(4 + sliceNALUs[i].data.length); // AVCC format with 4-byte length prefix
	}

	// Determine sync samples (I-frames): for simplicity, sample 1 is sync, rest depends on NAL type
	var syncSamples = [1]; // always mark first sample as sync
	for (var i = 1; i < sliceNALUs.length; i++) {
		// Check if this NALU could be an IDR/I frame
		// For H.264: NAL type 5 = IDR
		// For H.265: NAL type 19,20 = IDR
		if (sliceNALUs[i].data.length > 0) {
			if (codec === 'h264') {
				var nalType = sliceNALUs[i].data[0] & 0x1F;
				if (nalType === 5) syncSamples.push(i + 1);
			} else {
				if (sliceNALUs[i].data.length >= 2) {
					var h265type = ((sliceNALUs[i].data[0] & 0x7E) >> 1);
					if (h265type === 19 || h265type === 20) syncSamples.push(i + 1);
				}
			}
		}
	}

	// Compute sizes
	var stsdBox = buildSTSDBox(codec, codecConfigBox);
	var sttsBox = buildSTTSBox_MP4(sliceNALUs.length, 1000); // 1000 ticks per sample @ 30000 timescale = 30fps
	var stssBox = buildSTSSBox_MP4(syncSamples);
	var stszBox = buildSTSZBox_MP4(sampleSizes);
	var stcoBox = buildSTCOBox_MP4(mdatOffset, sampleSizes);

	if (!stsdBox || !sttsBox || !stszBox || !stcoBox) return null;

	// Build stbl
	var stblChildren = [stsdBox, sttsBox, stszBox, stcoBox];
	if (stssBox) stblChildren.push(stssBox);
	var stblBox = buildContainerBox('stbl', stblChildren);

	// Build minf
	var vmhd = buildVMHDBox();
	var dinf = buildDINFBox();
	var minf = buildContainerBox('minf', [vmhd, dinf, stblBox]);

	// Build mdia
	var mdhd = buildFullBox('mdhd', 0, 0, buildMDHDData(timescale, duration));
	var hdlr = buildFullBox('hdlr', 0, 0, buildHDLRData());
	var mdia = buildContainerBox('mdia', [mdhd, hdlr, minf]);

	// Build trak
	var tkhd = buildFullBox('tkhd', 0, 3, buildTKHDData(duration));
	var trak = buildContainerBox('trak', [tkhd, mdia]);

	// Build mvhd
	var mvhd = buildFullBox('mvhd', 0, 0, buildMVHDData(timescale, duration));

	// Build moov
	var moov = buildContainerBox('moov', [mvhd, trak]);

	return moov;
}

function buildUint32BE(value) {
	var arr = new Uint8Array(4);
	new DataView(arr.buffer).setUint32(0, value);
	return arr;
}

function buildFullBox(type, version, flags, data) {
	var headerSize = 12;
	var totalSize = headerSize + data.length;
	var box = new Uint8Array(totalSize);
	var dv = new DataView(box.buffer);
	dv.setUint32(0, totalSize);
	box[4] = type.charCodeAt(0); box[5] = type.charCodeAt(1);
	box[6] = type.charCodeAt(2); box[7] = type.charCodeAt(3);
	box[8] = version;
	box[9] = (flags >> 16) & 0xFF;
	box[10] = (flags >> 8) & 0xFF;
	box[11] = flags & 0xFF;
	box.set(data, headerSize);
	return box;
}

function buildContainerBox(type, children) {
	var totalDataSize = 0;
	for (var i = 0; i < children.length; i++) totalDataSize += children[i].length;
	var box = new Uint8Array(8 + totalDataSize);
	var dv = new DataView(box.buffer);
	dv.setUint32(0, 8 + totalDataSize);
	box[4] = type.charCodeAt(0); box[5] = type.charCodeAt(1);
	box[6] = type.charCodeAt(2); box[7] = type.charCodeAt(3);
	var pos = 8;
	for (var i = 0; i < children.length; i++) {
		box.set(children[i], pos);
		pos += children[i].length;
	}
	return box;
}

function buildMVHDData(timescale, duration) {
	var data = new Uint8Array(96);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, Math.floor(Date.now() / 1000)); // creation_time
	dv.setUint32(4, Math.floor(Date.now() / 1000)); // modification_time
	dv.setUint32(8, timescale);
	dv.setUint32(12, duration);
	dv.setUint32(16, 0x00010000); // rate (1.0 fixed point)
	dv.setUint16(20, 0x0100); // volume (1.0)
	dv.setUint16(22, 0); // reserved
	dv.setUint32(24, 0); dv.setUint32(28, 0); // reserved
	// Unity matrix (36 bytes)
	for (var i = 32; i < 68; i++) data[i] = 0;
	dv.setUint32(36, 0x00010000); dv.setUint32(52, 0x00010000); dv.setUint32(68, 0x40000000);
	// pre_defined (24 bytes)
	return data;
}

function buildTKHDData(duration) {
	var data = new Uint8Array(80);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, Math.floor(Date.now() / 1000));
	dv.setUint32(4, Math.floor(Date.now() / 1000));
	dv.setUint32(8, 1); // track_id
	dv.setUint32(12, 0); // reserved
	dv.setUint32(16, duration);
	dv.setUint32(20, 0); dv.setUint32(24, 0); // reserved
	dv.setUint16(28, 0); // layer
	dv.setUint16(30, 0); // alternate_group
	dv.setUint16(32, 0x0100); // volume
	dv.setUint16(34, 0); // reserved
	// Unity matrix
	for (var i = 36; i < 72; i++) data[i] = 0;
	dv.setUint32(40, 0x00010000); dv.setUint32(56, 0x00010000); dv.setUint32(72, 0x40000000);
	dv.setUint32(76, 0x01000000); // width (16.16 fixed point → 1.0 ? no, this is wrong)
	dv.setUint32(80, 0x01000000); // height
	// Actually width/height go at offset 76 and 80 but they're outside data[84]... let me fix
	return data;
}

function buildMDHDData(timescale, duration) {
	var data = new Uint8Array(20);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, Math.floor(Date.now() / 1000));
	dv.setUint32(4, Math.floor(Date.now() / 1000));
	dv.setUint32(8, timescale);
	dv.setUint32(12, duration);
	dv.setUint16(16, 0x55C4); // language: und (undefined)
	dv.setUint16(18, 0); // pre_defined
	return data;
}

function buildHDLRData() {
	// 'vide' handler
	var data = new Uint8Array(33);
	data[0] = 0; data[1] = 0; data[2] = 0; data[3] = 0; // pre_defined
	data[4] = 0x76; data[5] = 0x69; data[6] = 0x64; data[7] = 0x65; // 'vide'
	// remaining reserved + name string
	return data;
}

function buildVMHDBox() {
	var data = new Uint8Array(8);
	var dv = new DataView(data.buffer);
	dv.setUint16(0, 0); // graphicsmode
	dv.setUint16(2, 0); dv.setUint16(4, 0); dv.setUint16(6, 0); // opcolor
	return buildFullBox('vmhd', 0, 1, data);
}

function buildDINFBox() {
	// dinf contains dref
	var drefData = new Uint8Array(4);
	new DataView(drefData.buffer).setUint32(0, 1); // entry count
	var dref = buildFullBox('dref', 0, 0, drefData);
	// Add url entry
	var urlEntry = buildFullBox('url ', 0, 1, new Uint8Array(0));
	// Actually dref should contain the entries
	// Let me rebuild properly
	var drefChildren = [urlEntry];
	var drefTotalData = new Uint8Array(4);
	new DataView(drefTotalData.buffer).setUint32(0, 1);
	// This is getting complex. Let me use a simpler approach:
	var drefBox = new Uint8Array(8 + 4 + 12);
	var dvRef = new DataView(drefBox.buffer);
	dvRef.setUint32(0, 8 + 4 + 12); // box size
	drefBox[4] = 0x64; drefBox[5] = 0x72; drefBox[6] = 0x65; drefBox[7] = 0x66; // 'dref'
	drefBox[8] = 0; drefBox[9] = 0; drefBox[10] = 0; drefBox[11] = 0; // version+flags
	dvRef.setUint32(12, 1); // entry count
	// url  box
	dvRef.setUint32(16, 12); // box size
	drefBox[20] = 0x75; drefBox[21] = 0x72; drefBox[22] = 0x6c; drefBox[23] = 0x20; // 'url '
	drefBox[24] = 0; drefBox[25] = 0; drefBox[26] = 0; drefBox[27] = 1; // version + flags (self-contained)

	var dinfBox = new Uint8Array(8 + drefBox.length);
	new DataView(dinfBox.buffer).setUint32(0, 8 + drefBox.length);
	dinfBox[4] = 0x64; dinfBox[5] = 0x69; dinfBox[6] = 0x6e; dinfBox[7] = 0x66; // 'dinf'
	dinfBox.set(drefBox, 8);
	return dinfBox;
}

function buildSTSDBox(codec, codecConfigBox) {
	// stsd: version(4) + entry_count(4) + entries...
	var entryType = codec === 'h265' ? 'hvc1' : 'avc1';
	// Entry: size(4) + type(4) + reserved(6) + data_reference_index(2) + visual_entry_data...
	// visual_entry: pre_defined(2) + reserved(2) + pre_defined(12) + width(2) + height(2) +
	//   horizresolution(4) + vertresolution(4) + reserved(4) + frame_count(2) +
	//   compressorname(32) + depth(2) + pre_defined(2) + codec_config
	var visualHeaderSize = 78;
	var entrySize = 8 + visualHeaderSize + codecConfigBox.length;
	var totalSize = 8 + entrySize; // stsd full box header + 1 entry

	var data = new Uint8Array(totalSize);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, totalSize);
	data[4] = 0x73; data[5] = 0x74; data[6] = 0x73; data[7] = 0x64; // 'stsd'
	data[8] = 0; data[9] = 0; data[10] = 0; data[11] = 0; // version + flags
	dv.setUint32(12, 1); // entry_count

	// Entry
	dv.setUint32(16, entrySize);
	data[20] = entryType.charCodeAt(0); data[21] = entryType.charCodeAt(1);
	data[22] = entryType.charCodeAt(2); data[23] = entryType.charCodeAt(3);
	// reserved (6 bytes) + data_reference_index (2 bytes)
	data[24] = 0; data[25] = 0; data[26] = 0; data[27] = 0;
	data[28] = 0; data[29] = 0;
	dv.setUint16(30, 1); // data_reference_index = 1
	// visual entry header
	dv.setUint16(32, 0); // pre_defined
	dv.setUint16(34, 0); // reserved
	dv.setUint32(36, 0); dv.setUint32(40, 0); dv.setUint32(44, 0); // pre_defined
	dv.setUint16(48, 1920); // width
	dv.setUint16(50, 1080); // height
	dv.setUint32(52, 0x00480000); // horizresolution (72 dpi)
	dv.setUint32(56, 0x00480000); // vertresolution (72 dpi)
	dv.setUint32(60, 0); // reserved
	dv.setUint16(64, 1); // frame_count
	// compressor name (32 bytes) - all zeros = no compressor
	for (var i = 66; i < 98; i++) data[i] = 0;
	dv.setUint16(98, 0x0018); // depth (24-bit)
	dv.setInt16(100, -1); // pre_defined (-1)
	// Codec config
	data.set(codecConfigBox, 102);

	return data;
}

function buildSTTSBox_MP4(sampleCount, sampleDelta) {
	// Version 0: entry_count(4) + entries(sample_count(4) + sample_delta(4))
	var data = new Uint8Array(12);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, 1); // 1 entry
	dv.setUint32(4, sampleCount);
	dv.setUint32(8, sampleDelta);
	return buildFullBox('stts', 0, 0, data);
}

function buildSTSSBox_MP4(syncSampleIndices) {
	if (syncSampleIndices.length === 0) return null;
	var data = new Uint8Array(4 + syncSampleIndices.length * 4);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, syncSampleIndices.length);
	for (var i = 0; i < syncSampleIndices.length; i++) {
		dv.setUint32(4 + i * 4, syncSampleIndices[i]);
	}
	return buildFullBox('stss', 0, 0, data);
}

function buildSTSZBox_MP4(sampleSizes) {
	// Use variant with individual sizes
	var data = new Uint8Array(8 + sampleSizes.length * 4);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, 0); // sample_size = 0 (means variable)
	dv.setUint32(4, sampleSizes.length);
	for (var i = 0; i < sampleSizes.length; i++) {
		dv.setUint32(8 + i * 4, sampleSizes[i]);
	}
	return buildFullBox('stsz', 0, 0, data);
}

function buildSTCOBox_MP4(mdatOffset, sampleSizes) {
	// Single chunk: all samples in one chunk starting at mdatOffset + 8 (mdat header)
	var chunkOffset = mdatOffset + 8; // ftyp size + mdat box header
	var data = new Uint8Array(8);
	var dv = new DataView(data.buffer);
	dv.setUint32(0, 1); // 1 chunk
	dv.setUint32(4, chunkOffset);
	return buildFullBox('stco', 0, 0, data);
}

