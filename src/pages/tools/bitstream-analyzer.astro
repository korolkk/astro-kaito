---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`视频码流分析工具 - ${SITE_TITLE}`} description="H.264/H.265/MP4 码流解析、帧类型分析、GOP结构可视化、格式转换 — 纯浏览器端处理" />
		<style>
			main {
				width: 1140px;
				max-width: calc(100% - 2em);
				padding-left: 2em;
				padding-right: 2em;
			}
			.page-title {
				font-size: 1.6em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.3em;
				text-align: center;
			}
			.page-desc {
				font-size: 0.9em;
				color: rgb(var(--gray));
				text-align: center;
				margin: 0 0 1.5em;
				line-height: 1.5;
			}

			/* Upload Zone */
			.upload-zone {
				border: 2px dashed rgb(var(--gray-light));
				border-radius: 16px;
				padding: 3em 2em;
				text-align: center;
				cursor: pointer;
				transition: all 0.2s ease;
				background: var(--card-bg);
				margin-bottom: 1em;
			}
			.upload-zone:hover,
			.upload-zone.drag-over {
				border-color: var(--accent);
				background: rgba(var(--accent-rgb), 0.03);
			}
			.upload-icon {
				font-size: 2.8em;
				display: block;
				margin-bottom: 0.4em;
			}
			.upload-text {
				font-size: 1em;
				font-weight: 600;
				color: rgb(var(--black));
				margin: 0 0 0.3em;
			}
			.upload-hint {
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin: 0;
			}
			.upload-supported {
				font-size: 0.78em;
				color: rgb(var(--gray));
				margin: 0.5em 0 0;
			}

			/* File Info Bar */
			.file-info-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em 1.2em;
				padding: 0.7em 1.2em;
				background: var(--card-bg);
				border-radius: 12px;
				margin-bottom: 1em;
				font-size: 0.85em;
				color: rgb(var(--gray-dark));
				box-shadow: 0 1px 6px rgba(var(--black), 0.03);
			}
			.file-info-item {
				white-space: nowrap;
			}
			.file-info-item strong {
				color: rgb(var(--black));
			}

			/* Error / Warning */
			.error-msg {
				background: rgba(255, 76, 76, 0.08);
				border: 1px solid rgba(255, 76, 76, 0.2);
				border-radius: 10px;
				padding: 0.8em 1.2em;
				color: #d32f2f;
				font-size: 0.88em;
				margin-bottom: 1em;
				animation: fadeIn 0.3s ease;
			}
			[data-theme='dark'] .error-msg {
				color: #ff6b6b;
			}
			.warning-msg {
				background: rgba(255, 152, 0, 0.08);
				border: 1px solid rgba(255, 152, 0, 0.2);
				border-radius: 10px;
				padding: 0.8em 1.2em;
				color: #e65100;
				font-size: 0.88em;
				margin-bottom: 1em;
			}
			[data-theme='dark'] .warning-msg {
				color: #ffb74d;
			}
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(-4px); }
				to { opacity: 1; transform: translateY(0); }
			}

			/* Tool Layout */
			.tool-layout {
				display: grid;
				grid-template-columns: 340px 1fr;
				gap: 1.5em;
				align-items: start;
			}

			/* Panels */
			.panel {
				background: var(--card-bg);
				border-radius: 20px;
				padding: 1.5em;
				box-shadow: 0 2px 12px rgba(var(--black), 0.04);
			}
			.panel-title {
				font-size: 0.9em;
				font-weight: 700;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin: 0 0 1em;
				padding-bottom: 0.6em;
				border-bottom: 2px solid rgb(var(--gray-light));
			}

			/* Buttons */
			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.4em;
				padding: 0.6em 1.2em;
				border: none;
				border-radius: 10px;
				font-size: 0.88em;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
				font-family: var(--font-atkinson);
			}
			.btn-primary {
				background: var(--accent);
				color: #fff;
			}
			.btn-primary:hover {
				filter: brightness(1.1);
				transform: translateY(-1px);
			}
			.btn-secondary {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.btn-secondary:hover {
				background: rgb(var(--gray));
				color: #fff;
			}
			.btn-small {
				padding: 0.35em 0.7em;
				font-size: 0.78em;
				border-radius: 8px;
			}
			.btn:disabled {
				opacity: 0.4;
				pointer-events: none;
			}

			/* Action Buttons Row */
			.action-btns {
				display: flex;
				flex-direction: column;
				gap: 0.5em;
				margin-bottom: 1.2em;
			}
			.action-btns .btn {
				width: 100%;
			}

			/* Control Group */
			.control-group {
				margin-bottom: 1.2em;
			}
			.control-label {
				font-size: 0.85em;
				font-weight: 700;
				color: rgb(var(--gray-dark));
				margin-bottom: 0.4em;
			}
			.control-value {
				font-size: 0.8em;
				color: var(--accent);
				font-variant-numeric: tabular-nums;
			}

			/* Format Buttons */
			.format-btns {
				display: flex;
				gap: 0.4em;
			}
			.format-btn {
				flex: 1;
				padding: 0.45em 0.5em;
				border: 1.5px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: transparent;
				cursor: pointer;
				font-size: 0.82em;
				font-weight: 500;
				color: rgb(var(--gray-dark));
				transition: all 0.15s ease;
				font-family: var(--font-atkinson);
				text-align: center;
			}
			.format-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.format-btn.active {
				background: var(--accent);
				color: #fff;
				border-color: var(--accent);
			}

			/* Detail rows */
			.detail-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0.4em 0;
				font-size: 0.84em;
				border-bottom: 1px solid rgba(var(--gray-light), 0.5);
			}
			.detail-row span:first-child {
				color: rgb(var(--gray));
			}
			.detail-row span:last-child {
				color: rgb(var(--black));
				font-weight: 600;
				font-variant-numeric: tabular-nums;
			}

			/* Stat Cards Grid */
			.stat-cards {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
				gap: 0.7em;
				margin-bottom: 1em;
			}
			.stat-card {
				background: rgb(var(--gray-light));
				border-radius: 12px;
				padding: 0.9em 1em;
				text-align: center;
			}
			.stat-value {
				font-size: 1.4em;
				font-weight: 700;
				color: var(--accent);
				line-height: 1.2;
			}
			.stat-label {
				font-size: 0.75em;
				color: rgb(var(--gray));
				margin-top: 0.2em;
			}
			.stat-sub {
				font-size: 0.7em;
				color: rgb(var(--gray));
			}

			/* Tab Bar */
			.tab-bar {
				display: flex;
				gap: 0.3em;
				margin-bottom: 1em;
				flex-wrap: wrap;
				border-bottom: 2px solid rgb(var(--gray-light));
				padding-bottom: 0;
			}
			.tab-btn {
				padding: 0.45em 0.9em;
				border: none;
				background: transparent;
				cursor: pointer;
				font-size: 0.84em;
				font-weight: 500;
				color: rgb(var(--gray));
				border-radius: 8px 8px 0 0;
				transition: all 0.15s ease;
				font-family: var(--font-atkinson);
				margin-bottom: -2px;
				border-bottom: 2px solid transparent;
			}
			.tab-btn:hover {
				color: rgb(var(--black));
				background: rgb(var(--gray-light));
			}
			.tab-btn.active {
				color: var(--accent);
				border-bottom-color: var(--accent);
				font-weight: 700;
			}
			.tab-content {
				display: none;
			}
			.tab-content.active {
				display: block;
			}

			/* Filter Bar */
			.filter-bar {
				display: flex;
				gap: 0.3em;
				margin-bottom: 0.8em;
				flex-wrap: wrap;
			}
			.filter-btn {
				padding: 0.3em 0.7em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: transparent;
				cursor: pointer;
				font-size: 0.76em;
				color: rgb(var(--gray-dark));
				transition: all 0.15s ease;
				font-family: var(--font-atkinson);
			}
			.filter-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.filter-btn.active {
				background: var(--accent);
				color: #fff;
				border-color: var(--accent);
			}

			/* NAL Table */
			.nal-table-wrap {
				max-height: 420px;
				overflow-y: auto;
				border-radius: 10px;
				border: 1px solid rgb(var(--gray-light));
			}
			.nal-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.8em;
				font-variant-numeric: tabular-nums;
			}
			.nal-table thead {
				position: sticky;
				top: 0;
				z-index: 1;
			}
			.nal-table th {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-weight: 700;
				padding: 0.5em 0.6em;
				text-align: left;
				font-size: 0.9em;
				white-space: nowrap;
			}
			.nal-table td {
				padding: 0.35em 0.6em;
				border-bottom: 1px solid rgba(var(--gray-light), 0.4);
				color: rgb(var(--black));
				white-space: nowrap;
			}
			.nal-table tbody tr:hover {
				background: rgba(var(--accent-rgb), 0.04);
			}
			.nal-table .row-I { border-left: 3px solid var(--accent); }
			.nal-table .row-P { border-left: 3px solid #ff9800; }
			.nal-table .row-B { border-left: 3px solid #4caf50; }
			.nal-table .row-param { border-left: 3px solid rgb(var(--gray)); }
			.nal-table .tag {
				display: inline-block;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				font-size: 0.82em;
				font-weight: 600;
			}
			.tag-I { background: rgba(var(--accent-rgb), 0.12); color: var(--accent); }
			.tag-P { background: rgba(255,152,0,0.12); color: #e65100; }
			.tag-B { background: rgba(76,175,80,0.12); color: #2e7d32; }
			.tag-param { background: rgba(var(--gray), 0.1); color: rgb(var(--gray-dark)); }
			.tag-unknown { background: rgba(var(--gray), 0.06); color: rgb(var(--gray)); }

			/* Canvas Charts */
			.analysis-chart {
				display: block;
				max-width: 100%;
				margin-bottom: 1em;
				border-radius: 10px;
				background: rgb(var(--gray-light));
			}

			/* GOP Boundaries List */
			.gop-boundaries {
				font-size: 0.82em;
				color: rgb(var(--gray-dark));
				line-height: 1.8;
				max-height: 300px;
				overflow-y: auto;
			}
			.gop-boundary-item {
				padding: 0.2em 0.5em;
				border-bottom: 1px solid rgba(var(--gray-light), 0.3);
			}

			/* Size Compare Bar */
			.size-compare {
				margin-top: 1em;
				padding: 1em;
				background: rgb(var(--gray-light));
				border-radius: 10px;
			}
			.size-compare-label {
				font-size: 0.82em;
				font-weight: 600;
				color: rgb(var(--gray-dark));
				margin-bottom: 0.5em;
			}
			.size-bar-wrap {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin-bottom: 0.5em;
			}
			.size-bar-label {
				font-size: 0.75em;
				color: rgb(var(--gray));
				width: 55px;
				text-align: right;
				flex-shrink: 0;
			}
			.size-bar-track {
				flex: 1;
				height: 20px;
				background: rgba(var(--black), 0.06);
				border-radius: 10px;
				overflow: hidden;
				position: relative;
			}
			.size-bar-fill {
				height: 100%;
				border-radius: 10px;
				transition: width 0.3s ease;
			}
			.size-bar-fill.original { background: rgb(var(--gray)); }
			.size-bar-fill.converted { background: var(--accent); }
			.size-bar-size {
				font-size: 0.78em;
				color: rgb(var(--gray-dark));
				width: 80px;
				flex-shrink: 0;
				font-variant-numeric: tabular-nums;
			}
			.size-delta {
				font-size: 0.8em;
				font-weight: 600;
				text-align: center;
			}
			.size-delta.smaller { color: #2e7d32; }
			.size-delta.larger { color: #d32f2f; }
			[data-theme='dark'] .size-delta.smaller { color: #66bb6a; }
			[data-theme='dark'] .size-delta.larger { color: #ff6b6b; }

			/* Processing Overlay */
			.processing-overlay {
				display: none;
				position: fixed;
				inset: 0;
				background: rgba(0,0,0,0.3);
				justify-content: center;
				align-items: center;
				z-index: 100;
			}
			.processing-overlay.show { display: flex; }
			.processing-box {
				background: var(--card-bg);
				border-radius: 16px;
				padding: 2em 3em;
				text-align: center;
				box-shadow: 0 8px 32px rgba(0,0,0,0.15);
			}
			.processing-spinner {
				width: 36px;
				height: 36px;
				border: 3px solid rgb(var(--gray-light));
				border-top-color: var(--accent);
				border-radius: 50%;
				animation: spin 0.8s linear infinite;
				margin: 0 auto 0.8em;
			}
			@keyframes spin {
				to { transform: rotate(360deg); }
			}
			.processing-text {
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
			}

			/* Empty State */
			.empty-state {
				text-align: center;
				padding: 3em 1em;
				color: rgb(var(--gray));
			}
			.empty-state-icon {
				font-size: 3em;
				display: block;
				margin-bottom: 0.5em;
			}

			/* Responsive */
			@media (max-width: 768px) {
				.tool-layout {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 500px) {
				.panel {
					padding: 1em;
				}
				.upload-zone {
					padding: 2em 1em;
				}
				.stat-cards {
					grid-template-columns: repeat(2, 1fr);
				}
				.nal-table-wrap {
					max-height: 300px;
				}
				.file-info-bar {
					font-size: 0.78em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">视频码流分析工具</h1>
			<p class="page-desc">H.264/H.265/MP4 码流解析、帧类型分析、GOP 结构可视化、格式转换 — 纯浏览器端处理</p>

			<!-- Upload Zone -->
			<div class="upload-zone" id="uploadZone">
				<span class="upload-icon">🎬</span>
				<p class="upload-text">拖拽视频文件到此处，或点击选择文件</p>
				<p class="upload-hint">支持 .h264 / .h265 / .hevc / .mp4 / .m4v / .mov 格式</p>
				<p class="upload-supported" id="uploadStatus">尚未选择文件</p>
			</div>
			<input type="file" id="fileInput" accept=".h264,.h265,.265,.hevc,.mp4,.m4v,.mov" style="display:none">

			<!-- Messages -->
			<div class="error-msg" id="errorMsg" style="display:none"></div>
			<div class="warning-msg" id="warningMsg" style="display:none"></div>

			<!-- File Info Bar -->
			<div class="file-info-bar" id="fileInfoBar" style="display:none">
				<span class="file-info-item">📄 <strong id="infoFilename">—</strong></span>
				<span class="file-info-item">📦 <strong id="infoSize">—</strong></span>
				<span class="file-info-item">📋 <strong id="infoFormat">—</strong></span>
				<span class="file-info-item">🎞️ <strong id="infoCodec">—</strong></span>
				<span class="file-info-item">📐 <strong id="infoResolution">—</strong></span>
			</div>

			<!-- Tool Layout -->
			<div class="tool-layout" id="toolLayout" style="display:none">
				<!-- Left Column: Controls -->
				<div class="panel" id="leftPanel">
					<div class="panel-title">控制面板</div>

					<div class="action-btns">
						<button class="btn btn-primary" id="analyzeBtn">🔍 解析码流</button>
						<button class="btn btn-secondary" id="resetBtn">🔄 重新选择文件</button>
					</div>

					<!-- Conversion Section -->
					<div class="control-group" id="convertSection" style="display:none">
						<div class="control-label">格式转换</div>
						<div class="format-btns" id="convertBtns">
							<button class="format-btn active" data-convert="toRaw">导出为 Raw (.h264/.h265)</button>
							<button class="format-btn" data-convert="toMP4">转换为 MP4</button>
						</div>
						<button class="btn btn-primary" id="convertBtn" style="display:none; width:100%; margin-top:0.5em">开始转换</button>
						<button class="btn btn-secondary" id="downloadConvertedBtn" style="display:none; width:100%; margin-top:0.3em">📥 下载转换结果</button>
						<div class="size-compare" id="sizeCompareConvert" style="display:none; margin-top:0.8em"></div>
					</div>

					<!-- Codec Details -->
					<div class="control-group" id="codecDetails" style="display:none">
						<div class="control-label">编码详情</div>
						<div class="detail-row"><span>编码格式</span><span id="detailCodec">—</span></div>
						<div class="detail-row"><span>Profile</span><span id="detailProfile">—</span></div>
						<div class="detail-row"><span>Level</span><span id="detailLevel">—</span></div>
						<div class="detail-row"><span>分辨率</span><span id="detailRes">—</span></div>
						<div class="detail-row"><span>帧率</span><span id="detailFPS">—</span></div>
						<div class="detail-row"><span>NAL 单元总数</span><span id="detailNALCount">—</span></div>
						<div class="detail-row"><span>切片 NAL 数</span><span id="detailSliceCount">—</span></div>
					</div>

					<!-- GOP Summary -->
					<div class="control-group" id="gopSummary" style="display:none">
						<div class="control-label">GOP 统计</div>
						<div class="detail-row"><span>GOP 数量</span><span id="gopCount">—</span></div>
						<div class="detail-row"><span>平均 GOP 大小</span><span id="gopAvg">—</span></div>
						<div class="detail-row"><span>最大 GOP</span><span id="gopMax">—</span></div>
						<div class="detail-row"><span>最小 GOP</span><span id="gopMin">—</span></div>
						<div class="detail-row"><span>总帧数</span><span id="gopTotalFrames">—</span></div>
					</div>
				</div>

				<!-- Right Column: Results -->
				<div class="panel" id="rightPanel">
					<div class="panel-title">分析结果</div>

					<!-- Tab Bar -->
					<div class="tab-bar" id="tabBar">
						<button class="tab-btn active" data-tab="summary">📊 概览</button>
						<button class="tab-btn" data-tab="frames">🎞️ 帧分析</button>
						<button class="tab-btn" data-tab="nalunits">📋 NAL 单元</button>
						<button class="tab-btn" data-tab="gop">🔗 GOP 结构</button>
						<button class="tab-btn" data-tab="sizes">📈 帧大小</button>
					</div>

					<!-- Summary Tab -->
					<div class="tab-content active" id="tabSummary">
						<div class="stat-cards" id="summaryCards"></div>
						<canvas id="frameTypeChart" class="analysis-chart" height="180"></canvas>
					</div>

					<!-- Frames Tab -->
					<div class="tab-content" id="tabFrames">
						<div class="filter-bar" id="frameFilterBar">
							<button class="filter-btn active" data-filter="all">全部</button>
							<button class="filter-btn" data-filter="I">I 帧</button>
							<button class="filter-btn" data-filter="P">P 帧</button>
							<button class="filter-btn" data-filter="B">B 帧</button>
						</div>
						<div class="nal-table-wrap">
							<table class="nal-table" id="frameTable">
								<thead><tr>
