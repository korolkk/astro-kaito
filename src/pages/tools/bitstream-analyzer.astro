function setupHiDPICanvas(canvas, width, height) {
	// Guard against zero-width (hidden tab containers)
	if (width < 10) width = 600;
	if (height < 10) height = 150;
	var dpr = window.devicePixelRatio || 1;
	canvas.width = width * dpr;
	canvas.height = height * dpr;
	canvas.style.width = width + 'px';
	canvas.style.height = height + 'px';
	var ctx = canvas.getContext('2d');
	ctx.scale(dpr, dpr);
	return { ctx: ctx, w: width, h: height };
}

function getAccentColor() {
	var style = getComputedStyle(document.documentElement);
	return style.getPropertyValue('--accent').trim() || '#2337ff';
}

function getTextColor() {
	var style = getComputedStyle(document.documentElement);
	var black = style.getPropertyValue('--black').trim();
	if (black && black.indexOf(',') !== -1) {
		return 'rgb(' + black + ')';
	}
	return '#0f1219';
}

function renderFrameTypeChart(result) {
	var canvas = document.getElementById('frameTypeChart');
	if (!canvas) return;
	var total = result.iCount + result.pCount + result.bCount;
	if (total === 0) { canvas.style.display = 'none'; return; }
	canvas.style.display = 'block';

	var containerWidth = canvas.parentElement.clientWidth - 2;
	var chartW = Math.min(containerWidth, 700);
	var chartH = 180;
	var setup = setupHiDPICanvas(canvas, chartW, chartH);
	var ctx = setup.ctx;
	var w = setup.w, h = setup.h;

	var accent = getAccentColor();
	var pColor = '#ff9800';
	var bColor = '#4caf50';
	var bgColor = getComputedStyle(document.documentElement).getPropertyValue('--gray-light').trim();
	if (bgColor && bgColor.indexOf(',') !== -1) bgColor = 'rgb(' + bgColor + ')';

	ctx.clearRect(0, 0, w, h);

	var margin = { top: 20, right: 20, bottom: 40, left: 60 };
	var barH = 32;
	var barGap = 20;
	var startY = margin.top;

	var maxVal = Math.max(result.iCount, result.pCount, result.bCount, 1);
	var barW = w - margin.left - margin.right;

	var bars = [
		{ label: 'I 帧', value: result.iCount, color: accent },
		{ label: 'P 帧', value: result.pCount, color: pColor },
		{ label: 'B 帧', value: result.bCount, color: bColor }
	];

	// Title
	ctx.fillStyle = getTextColor();
	ctx.font = '12px ' + getComputedStyle(document.body).fontFamily;
	ctx.textAlign = 'center';
	ctx.fillText('帧类型分布', w / 2, margin.top);

	for (var i = 0; i < bars.length; i++) {
		var y = startY + (barH + barGap) * i;
		var fillW = Math.max((bars[i].value / maxVal) * barW, bars[i].value > 0 ? 4 : 0);

		// Label
		ctx.fillStyle = getTextColor();
		ctx.font = '11px ' + getComputedStyle(document.body).fontFamily;
		ctx.textAlign = 'right';
		ctx.fillText(bars[i].label, margin.left - 8, y + barH / 2 + 4);

		// Bar
		ctx.fillStyle = bars[i].color;
		ctx.fillRect(margin.left, y, fillW, barH);

		// Count + percentage
		var pct = total > 0 ? (bars[i].value / total * 100).toFixed(1) : '0.0';
		ctx.fillStyle = getTextColor();
		ctx.font = 'bold 12px ' + getComputedStyle(document.body).fontFamily;
		ctx.textAlign = 'left';
		ctx.fillText(bars[i].value + ' (' + pct + '%)', margin.left + fillW + 8, y + barH / 2 + 4);
	}
}

function renderNALTable(result) {
	var tbody = document.getElementById('nalTableBody');
	if (!tbody) return;
	var html = '';
	var allNals = result._nalUnits || [];

	for (var i = 0; i < allNals.length; i++) {
		var nalu = allNals[i];
		var rowClass = '';
		var frameTypeTag = '';
		var nalTypeName = nalu.typeName || nalu.type || '?';

		if (nalu.frameType === 'I') { rowClass = 'row-I'; frameTypeTag = '<span class="tag tag-I">I</span>'; }
		else if (nalu.frameType === 'P') { rowClass = 'row-P'; frameTypeTag = '<span class="tag tag-P">P</span>'; }
		else if (nalu.frameType === 'B') { rowClass = 'row-B'; frameTypeTag = '<span class="tag tag-B">B</span>'; }
		else if (nalu.type === 'SPS' || nalu.type === 'PPS' || nalu.type === 'VPS') {
			rowClass = 'row-param'; frameTypeTag = '<span class="tag tag-param">参数</span>';
		} else if (nalu.type === 'SEI' || nalu.type === 'PREFIX_SEI' || nalu.type === 'SUFFIX_SEI') {
			rowClass = 'row-param'; frameTypeTag = '<span class="tag tag-param">SEI</span>';
		}

		html += '<tr class="' + rowClass + '" data-nal-type="' + (nalu.type || 'unknown') + '"' +
			(nalu.frameType ? ' data-frame-type="' + nalu.frameType + '"' : '') + '>' +
			'<td>' + (i + 1) + '</td>' +
			'<td>' + nalu.offset.toLocaleString() + '</td>' +
			'<td>' + nalTypeName + '</td>' +
			'<td>' + (nalu.layerId !== undefined ? nalu.layerId : '-') + '</td>' +
			'<td>' + frameTypeTag + '</td>' +
			'<td>' + fmtSize(nalu.size) + '</td>' +
			'<td>' + (nalu.startCodeLen === 4 ? '4字节' : nalu.startCodeLen === 3 ? '3字节' : 'AVCC') + '</td>' +
			'</tr>';
	}

	tbody.innerHTML = html;
		applyCID(tbody);
		// Store NAL data for filtering
	tbody.parentElement._allNals = allNals;
}

function renderFrameTable(result) {
	var tbody = document.getElementById('frameTableBody');
	if (!tbody) return;
	var frames = result.frames || [];
	var html = '';
	for (var i = 0; i < frames.length; i++) {
		var f = frames[i];
		var tagClass = 'tag-' + f.type;
		var tagLabel = f.type;
		var ts = f.pts !== undefined ? f.pts : (f.timestamp !== null ? f.timestamp : '-');
		html += '<tr data-frame-type="' + f.type + '">' +
			'<td>' + (i + 1) + '</td>' +
			'<td><span class="tag ' + tagClass + '">' + tagLabel + '</span></td>' +
			'<td>' + fmtSize(f.size) + '</td>' +
			'<td>' + (f.nalUnitIndex !== undefined ? f.nalUnitIndex + 1 : '-') + '</td>' +
			'<td>' + (f.nalUnitIndex !== undefined ? 'NAL#' + (f.nalUnitIndex + 1) : '-') + '</td>' +
			'<td>' + ts + '</td>' +
			'</tr>';
	}
	tbody.innerHTML = html;
		applyCID(tbody);
}

function renderGOPView(result) {
	var gopInfo = result.gopInfo;

	// GOP stats cards
	var cardsContainer = document.getElementById('gopStatsCards');
	if (cardsContainer) {
		var totalFrames = result.iCount + result.pCount + result.bCount;
		cardsContainer.innerHTML =
			'<div class="stat-card"><div class="stat-value">' + gopInfo.count + '</div><div class="stat-label">GOP 数量</div></div>' +
			'<div class="stat-card"><div class="stat-value">' + gopInfo.avgSize + '</div><div class="stat-label">平均 GOP</div></div>' +
			'<div class="stat-card"><div class="stat-value">' + gopInfo.maxSize + '</div><div class="stat-label">最大 GOP</div></div>' +
			'<div class="stat-card"><div class="stat-value">' + gopInfo.minSize + '</div><div class="stat-label">最小 GOP</div></div>' +
			'<div class="stat-card"><div class="stat-value">' + (gopInfo.isClosed ? 'Closed' : 'Open') + '</div><div class="stat-label">GOP 类型</div></div>';
		applyCID(cardsContainer);
	}

	// GOP boundaries list
	var boundaryList = document.getElementById('gopBoundaryList');
	if (boundaryList) {
		var html = '<div style="font-weight:700;margin-bottom:0.5em">GOP 边界列表</div>';
		for (var i = 0; i < gopInfo.boundaries.length; i++) {
			var b = gopInfo.boundaries[i];
			html += '<div class="gop-boundary-item">GOP #' + (i + 1) + ': 帧 ' + b.start + ' → ' + b.end + ' (' + b.size + ' 帧)</div>';
		}
		boundaryList.innerHTML = html;
		applyCID(boundaryList);
	}

	// GOP chart
	var canvas = document.getElementById('gopChart');
	if (!canvas) return;
	if (gopInfo.count === 0) { canvas.style.display = 'none'; return; }
	canvas.style.display = 'block';

	var containerWidth = canvas.parentElement.clientWidth - 2;
	var chartW = Math.min(containerWidth, 700);
	var chartH = Math.min(gopInfo.count * 22 + 40, 400);
	var setup = setupHiDPICanvas(canvas, chartW, chartH);
	var ctx = setup.ctx;
	var w = setup.w, h = setup.h;

	var accent = getAccentColor();
	var pColor = '#ff9800';
	var bColor = '#4caf50';
	var frames = result.frames || [];
	var margin = { top: 10, right: 10, bottom: 20, left: 60 };
	var plotW = w - margin.left - margin.right;
	var maxGopSize = gopInfo.maxSize || 1;
	var rectW = Math.max(2, Math.floor(plotW / maxGopSize));
	var rectH = 18;
	var gap = 3;

	ctx.clearRect(0, 0, w, h);
	var y = margin.top;

	for (var gi = 0; gi < gopInfo.boundaries.length && y + rectH <= h - margin.bottom; gi++) {
		var gop = gopInfo.boundaries[gi];
		ctx.fillStyle = getTextColor();
		ctx.font = '10px ' + getComputedStyle(document.body).fontFamily;
		ctx.textAlign = 'right';
		ctx.fillText('GOP' + (gi + 1), margin.left - 6, y + rectH / 2 + 3);

		for (var fi = gop.start; fi <= gop.end && fi < frames.length; fi++) {
			var x = margin.left + (fi - gop.start) * (rectW + 1);
			if (x + rectW > w - margin.right) break;
			ctx.fillStyle = frames[fi].type === 'I' ? accent : frames[fi].type === 'P' ? pColor : bColor;
			ctx.fillRect(x, y, rectW, rectH);
		}
		y += rectH + gap;
	}
}

function renderFrameSizeChart(result) {
	var canvas = document.getElementById('frameSizeChart');
	if (!canvas) return;
	var frames = result.frames || [];
	if (frames.length === 0) { canvas.style.display = 'none'; return; }
	canvas.style.display = 'block';

	var containerWidth = canvas.parentElement.clientWidth - 2;
	var chartW = Math.min(containerWidth, 700);
	var chartH = 250;
	var setup = setupHiDPICanvas(canvas, chartW, chartH);
	var ctx = setup.ctx;
	var w = setup.w, h = setup.h;

	var accent = getAccentColor();
	var pColor = '#ff9800';
	var bColor = '#4caf50';
	var textColor = getTextColor();

	ctx.clearRect(0, 0, w, h);

	var margin = { top: 20, right: 15, bottom: 40, left: 55 };
	var plotW = w - margin.left - margin.right;
	var plotH = h - margin.top - margin.bottom;

	// Sample frames if too many
	var step = Math.max(1, Math.floor(frames.length / plotW));
	var sampledFrames = [];
	for (var i = 0; i < frames.length; i += step) {
		sampledFrames.push(frames[i]);
	}

	// Find max size for scale
	var maxSize = 0;
	for (var i = 0; i < frames.length; i++) {
		if (frames[i].size > maxSize) maxSize = frames[i].size;
	}
	if (maxSize === 0) maxSize = 1;

	var barW = Math.max(1, plotW / sampledFrames.length - 0.5);

	// Y axis labels
	ctx.fillStyle = textColor;
	ctx.font = '10px ' + getComputedStyle(document.body).fontFamily;
	ctx.textAlign = 'right';
	var ySteps = 4;
	for (var yi = 0; yi <= ySteps; yi++) {
		var val = Math.round(maxSize * yi / ySteps);
		var yPos = margin.top + plotH - (plotH * yi / ySteps);
		ctx.fillText(fmtSize(val), margin.left - 6, yPos + 4);
		ctx.strokeStyle = 'rgba(128,128,128,0.15)';
		ctx.beginPath();
		ctx.moveTo(margin.left, yPos);
		ctx.lineTo(margin.left + plotW, yPos);
		ctx.stroke();
	}

	// X axis
	ctx.strokeStyle = 'rgba(128,128,128,0.3)';
	ctx.beginPath();
	ctx.moveTo(margin.left, margin.top);
	ctx.lineTo(margin.left, margin.top + plotH);
	ctx.lineTo(margin.left + plotW, margin.top + plotH);
	ctx.stroke();

	// Draw bars
	for (var si = 0; si < sampledFrames.length; si++) {
		var f = sampledFrames[si];
		var barH = Math.max(1, (f.size / maxSize) * plotH);
		var x = margin.left + si * (barW + 0.5);
		var y = margin.top + plotH - barH;

		ctx.fillStyle = f.type === 'I' ? accent : f.type === 'P' ? pColor : f.type === 'B' ? bColor : '#999';
		ctx.fillRect(x, y, barW, barH);
	}

	// X axis labels
	ctx.fillStyle = textColor;
	ctx.font = '10px ' + getComputedStyle(document.body).fontFamily;
	ctx.textAlign = 'center';
	var xLabelCount = Math.min(5, sampledFrames.length);
	for (var xi = 0; xi < xLabelCount; xi++) {
		var frameIdx = Math.floor(xi * sampledFrames.length / xLabelCount);
		if (frameIdx < sampledFrames.length) {
			ctx.fillText('#' + (sampledFrames[frameIdx].index + 1),
				margin.left + frameIdx * (barW + 0.5), margin.top + plotH + 15);
		}
	}

	// Title
	ctx.fillText('帧大小分布 (共 ' + frames.length + ' 帧)', w / 2, margin.top - 2);
}

function showConversionSection(codecInfo) {
	document.getElementById('convertSection').style.display = 'block';
