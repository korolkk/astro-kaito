		{ value: result.iCount, label: 'I 帧', sub: totalFrames > 0 ? (result.iCount / totalFrames * 100).toFixed(1) + '%' : '' },
		{ value: result.pCount, label: 'P 帧', sub: totalFrames > 0 ? (result.pCount / totalFrames * 100).toFixed(1) + '%' : '' },
