---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`图片处理工具 - ${SITE_TITLE}`} description="在线图片压缩、格式转换、缩放和滤镜工具，完全在浏览器中运行" />
		<style>
			main {
				width: 1140px;
				max-width: calc(100% - 2em);
				padding-left: 2em;
				padding-right: 2em;
			}
			.page-title {
				font-size: 1.6em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.3em;
				text-align: center;
			}
			.page-desc {
				text-align: center;
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-bottom: 2em;
			}

			/* Upload zone */
			.upload-zone {
				border: 2px dashed rgb(var(--gray-light));
				border-radius: 16px;
				padding: 3em 2em;
				text-align: center;
				background: var(--card-bg);
				cursor: pointer;
				transition: border-color 0.2s ease, background 0.2s ease;
				margin-bottom: 1em;
			}
			.upload-zone:hover,
			.upload-zone.drag-over {
				border-color: var(--accent);
				background: rgba(var(--accent-rgb), 0.04);
			}
			.upload-icon {
				font-size: 2.5em;
				display: block;
				margin-bottom: 0.4em;
			}
			.upload-text {
				font-size: 1em;
				font-weight: 600;
				color: rgb(var(--black));
				margin: 0 0 0.3em;
			}
			.upload-hint {
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin: 0;
			}
			.upload-supported {
				font-size: 0.75em;
				color: rgb(var(--gray));
				margin: 0.6em 0 0;
				opacity: 0.7;
			}

			/* Error message */
			.error-msg {
				display: flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.7em 1em;
				background: rgba(220, 53, 69, 0.08);
				border: 1px solid rgba(220, 53, 69, 0.2);
				border-radius: 10px;
				color: #dc3545;
				font-size: 0.85em;
				margin-bottom: 1em;
				animation: fadeIn 0.2s ease;
			}
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(-4px); }
				to { opacity: 1; transform: translateY(0); }
			}

			/* Tool layout */
			.tool-layout {
				display: grid;
				grid-template-columns: 340px 1fr;
				gap: 1.5em;
				align-items: start;
			}

			/* Panels */
			.panel {
				background: var(--card-bg);
				border-radius: 20px;
				padding: 1.5em;
				box-shadow: 0 2px 12px rgba(var(--black), 0.04);
			}
			.panel-title {
				font-size: 0.9em;
				font-weight: 700;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin: 0 0 1em;
				padding-bottom: 0.6em;
				border-bottom: 2px solid rgb(var(--gray-light));
			}

			/* Control groups */
			.control-group {
				margin-bottom: 1.2em;
			}
			.control-group:last-child {
				margin-bottom: 0;
			}
			.control-label {
				display: flex;
				align-items: center;
				justify-content: space-between;
				font-size: 0.85em;
				font-weight: 600;
				color: rgb(var(--black));
				margin-bottom: 0.4em;
			}
			.control-value {
				font-weight: 400;
				color: var(--accent);
				font-variant-numeric: tabular-nums;
			}

			/* Slider */
			input[type="range"] {
				-webkit-appearance: none;
				width: 100%;
				height: 6px;
				border-radius: 3px;
				background: rgb(var(--gray-light));
				outline: none;
			}
			input[type="range"]::-webkit-slider-thumb {
				-webkit-appearance: none;
				width: 18px;
				height: 18px;
				border-radius: 50%;
				background: var(--accent);
				cursor: pointer;
				transition: transform 0.15s ease;
			}
			input[type="range"]::-webkit-slider-thumb:hover {
				transform: scale(1.15);
			}
			input[type="range"]:disabled {
				opacity: 0.35;
				cursor: not-allowed;
			}

			/* Format selector */
			.format-btns {
				display: flex;
				gap: 0.4em;
			}
			.format-btn {
				flex: 1;
				padding: 0.5em 0.3em;
				border: 1.5px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--card-bg);
				color: rgb(var(--gray-dark));
				font-family: inherit;
				font-size: 0.82em;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
				text-align: center;
			}
			.format-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.format-btn.active {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}

			/* Resize inputs */
			.resize-row {
				display: flex;
				align-items: center;
				gap: 0.4em;
			}
			.resize-input {
				flex: 1;
				min-width: 0;
				padding: 0.45em 0.6em;
				border: 1.5px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--card-bg);
				color: rgb(var(--black));
				font-family: inherit;
				font-size: 0.85em;
				font-variant-numeric: tabular-nums;
				outline: none;
				transition: border-color 0.2s ease;
			}
			.resize-input:focus {
				border-color: var(--accent);
			}
			.resize-sep {
				color: rgb(var(--gray));
				font-size: 0.85em;
				flex-shrink: 0;
			}
			.lock-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 34px;
				height: 34px;
				border: 1.5px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--card-bg);
				color: rgb(var(--gray));
				cursor: pointer;
				transition: all 0.2s ease;
				flex-shrink: 0;
			}
			.lock-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.lock-btn.locked {
				background: rgba(var(--accent-rgb), 0.08);
				border-color: var(--accent);
				color: var(--accent);
			}
			.lock-btn svg {
				width: 16px;
				height: 16px;
			}

			/* Filter buttons */
			.filter-btns {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35em;
			}
			.filter-btn {
				padding: 0.35em 0.7em;
				border: 1.5px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: var(--card-bg);
				color: rgb(var(--gray-dark));
				font-family: inherit;
				font-size: 0.78em;
				cursor: pointer;
				transition: all 0.2s ease;
				white-space: nowrap;
			}
			.filter-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.filter-btn.active {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}

			/* Action buttons */
			.action-btns {
				display: flex;
				gap: 0.5em;
				margin-top: 0.3em;
			}
			.btn {
				padding: 0.55em 1.2em;
				border-radius: 10px;
				font-family: inherit;
				font-size: 0.88em;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
				border: none;
				text-align: center;
			}
			.btn-primary {
				flex: 1;
				background: var(--accent);
				color: #fff;
			}
			.btn-primary:hover {
				opacity: 0.85;
			}
			.btn-secondary {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.btn-secondary:hover {
				background: rgb(var(--gray));
				color: #fff;
			}

			/* Mode switch */
			.mode-switch {
				display: flex;
				gap: 0.4em;
				margin-bottom: 1.2em;
			}
			.mode-btn {
				flex: 1;
				padding: 0.5em 0.3em;
				border: 1.5px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--card-bg);
				color: rgb(var(--gray-dark));
				font-family: inherit;
				font-size: 0.82em;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
				text-align: center;
			}
			.mode-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.mode-btn.active {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}

			/* Grid size buttons */
			.grid-size-btns {
				display: flex;
				gap: 0.4em;
			}
			.grid-size-btn {
				flex: 1;
				padding: 0.5em 0.3em;
				border: 1.5px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--card-bg);
				color: rgb(var(--gray-dark));
				font-family: inherit;
				font-size: 0.82em;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
				text-align: center;
			}
			.grid-size-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.grid-size-btn.active {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
			}

			/* Shuffle randomize button */
			.shuffle-btn {
				width: 100%;
				padding: 0.55em;
				border: 1.5px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: var(--card-bg);
				color: rgb(var(--gray-dark));
				font-family: inherit;
				font-size: 0.85em;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.2s ease;
				margin-top: 0.3em;
			}
			.shuffle-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.04);
			}

			/* Preview panel */
			.preview-dual {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.8em;
				margin-bottom: 1em;
			}
			.preview-item {
				text-align: center;
			}
			.preview-label {
				font-size: 0.75em;
				font-weight: 700;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 0.4em;
			}
			.preview-label.after {
				color: var(--accent);
			}
			.preview-canvas-wrap {
				background: rgb(var(--gray-light));
				border-radius: 12px;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 120px;
				position: relative;
			}
			.preview-canvas-wrap canvas {
				display: block;
				max-width: 100%;
				height: auto;
			}

			/* Size comparison */
			.size-compare {
				background: rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1em;
			}
			.size-compare-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.6em;
			}
			.size-label {
				font-size: 0.8em;
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
			.size-saved {
				font-size: 0.82em;
				font-weight: 700;
				color: #28a745;
			}
			.size-bar {
				height: 8px;
				border-radius: 4px;
				background: rgb(var(--gray-light));
				position: relative;
				overflow: hidden;
				margin-bottom: 0.5em;
			}
			.size-bar-original {
				position: absolute;
				inset: 0;
				background: rgb(var(--gray));
				border-radius: 4px;
				opacity: 0.4;
				width: 100%;
			}
			.size-bar-processed {
				position: absolute;
				inset: 0;
				background: var(--accent);
				border-radius: 4px;
				transition: width 0.3s ease;
			}
			.size-details {
				display: flex;
				justify-content: space-between;
				font-size: 0.75em;
				color: rgb(var(--gray));
			}
			.size-original-val {
				color: rgb(var(--gray-dark));
			}
			.size-processed-val {
				color: var(--accent);
				font-weight: 600;
			}

			/* No image placeholder */
			.no-image-placeholder {
				color: rgb(var(--gray));
				font-size: 0.85em;
				text-align: center;
				padding: 2em 1em;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5em;
			}
			.no-image-placeholder .placeholder-icon {
				font-size: 2em;
				opacity: 0.5;
			}

			/* Disabled state */
			.controls-disabled {
				pointer-events: none;
				opacity: 0.45;
			}

			/* Lightbox */
			.lightbox-overlay {
				display: none;
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.85);
				z-index: 9999;
				align-items: center;
				justify-content: center;
				cursor: pointer;
			}
			.lightbox-overlay.active {
				display: flex;
			}
			.lightbox-content {
				position: relative;
				max-width: 95vw;
				max-height: 95vh;
				cursor: default;
			}
			.lightbox-content img {
				display: block;
				max-width: 95vw;
				max-height: 90vh;
				object-fit: contain;
				border-radius: 4px;
				box-shadow: 0 8px 40px rgba(0,0,0,0.5);
			}
			.lightbox-close {
				position: absolute;
				top: -40px;
				right: 0;
				width: 36px;
				height: 36px;
				border: none;
				background: rgba(255,255,255,0.15);
				color: #fff;
				font-size: 1.3em;
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: background 0.2s;
			}
			.lightbox-close:hover {
				background: rgba(255,255,255,0.3);
			}
			.lightbox-label {
				color: rgba(255,255,255,0.7);
				font-size: 0.85em;
				text-align: center;
				margin-top: 0.5em;
			}
			.preview-canvas-wrap {
				cursor: pointer;
				position: relative;
			}
			.preview-canvas-wrap::after {
				content: '🔍';
				position: absolute;
				top: 6px;
				right: 8px;
				font-size: 0.75em;
				opacity: 0;
				transition: opacity 0.2s;
				pointer-events: none;
			}
			.preview-canvas-wrap:hover::after {
				opacity: 0.7;
			}

			@media (max-width: 768px) {
				.tool-layout {
					grid-template-columns: 1fr;
				}
				.preview-dual {
					grid-template-columns: 1fr 1fr;
				}
			}
			@media (max-width: 500px) {
				.panel {
					padding: 1em;
				}
				.preview-dual {
					grid-template-columns: 1fr;
				}
				.upload-zone {
					padding: 2em 1em;
				}
				.format-btns {
					flex-wrap: wrap;
				}
				.format-btn {
					flex: 1 1 auto;
					min-width: 60px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">🖼️ 图片处理工具</h1>
			<p class="page-desc">图片压缩、格式转换、缩放和滤镜 — 所有处理都在浏览器本地完成，不会上传到任何服务器</p>

			<!-- Upload Zone -->
			<div class="upload-zone" id="uploadZone">
				<span class="upload-icon">📁</span>
				<p class="upload-text">拖拽图片到此处，或点击选择文件</p>
				<p class="upload-hint">支持 JPEG · PNG · WebP 格式</p>
				<p class="upload-supported" id="uploadStatus">尚未选择文件</p>
			</div>
			<input type="file" id="fileInput" accept="image/jpeg,image/png,image/webp" style="display:none">

			<!-- Error message -->
			<div class="error-msg" id="errorMsg" style="display:none">
				<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zM7 3h2v5H7V3zm0 7h2v2H7v-2z"/></svg>
				<span id="errorText"></span>
			</div>

			<!-- Tool Layout (hidden until image loaded) -->
			<div class="tool-layout" id="toolLayout" style="display:none">
				<!-- Controls Panel -->
				<div class="panel" id="controlsPanel">
					<div class="panel-title">⚙️ 控制面板</div>

					<!-- Mode Switch -->
					<div class="mode-switch" id="modeSwitch">
						<button class="mode-btn active" data-mode="basic">基础处理</button>
						<button class="mode-btn" data-mode="shuffle">网格打乱</button>
					</div>

					<!-- Basic Controls -->
					<div id="basicControls">
						<div class="control-group">
							<div class="control-label">
								<span>压缩质量</span>
								<span class="control-value" id="qualityValue">85%</span>
							</div>
							<input type="range" id="qualitySlider" min="10" max="100" value="85" step="1">
						</div>

						<div class="control-group">
							<div class="control-label">输出格式</div>
							<div class="format-btns" id="formatBtns">
								<button class="format-btn active" data-format="image/jpeg">JPEG</button>
								<button class="format-btn" data-format="image/png">PNG</button>
								<button class="format-btn" data-format="image/webp">WebP</button>
							</div>
						</div>

						<div class="control-group">
							<div class="control-label">图片尺寸</div>
							<div class="resize-row">
								<input type="number" class="resize-input" id="widthInput" placeholder="宽度" min="1" max="4096">
								<span class="resize-sep">×</span>
								<input type="number" class="resize-input" id="heightInput" placeholder="高度" min="1" max="4096">
								<button class="lock-btn locked" id="lockBtn" title="锁定宽高比">
									<svg id="lockIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
								</button>
							</div>
						</div>

						<div class="control-group">
							<div class="control-label">滤镜效果</div>
							<div class="filter-btns" id="filterBtns">
								<button class="filter-btn active" data-filter="none">原图</button>
								<button class="filter-btn" data-filter="grayscale(1)">灰度</button>
								<button class="filter-btn" data-filter="sepia(0.75)">复古</button>
								<button class="filter-btn" data-filter="brightness(1.2)">提亮</button>
								<button class="filter-btn" data-filter="brightness(0.75)">压暗</button>
								<button class="filter-btn" data-filter="contrast(1.3)">增强对比</button>
							</div>
						</div>
					</div>

					<!-- Shuffle Controls (hidden by default) -->
					<div id="shuffleControls" style="display:none">
						<div class="control-group">
							<div class="control-label">网格大小</div>
							<div class="grid-size-btns" id="gridSizeBtns">
								<button class="grid-size-btn active" data-grid="3">3×3</button>
								<button class="grid-size-btn" data-grid="4">4×4</button>
							</div>
						</div>
						<div class="control-group">
							<div class="control-label">
								<span>打乱数量</span>
								<span class="control-value" id="shuffleCountValue">5</span>
							</div>
							<input type="range" id="shuffleCountSlider" min="1" max="9" value="5" step="1">
						</div>
						<button class="shuffle-btn" id="reshuffleBtn">🎲 重新随机</button>
					</div>

					<div class="action-btns">
						<button class="btn btn-primary" id="downloadBtn">⬇ 下载图片</button>
						<button class="btn btn-secondary" id="resetBtn">↺ 重置</button>
					</div>
				</div>

				<!-- Preview Panel -->
				<div class="panel" id="previewPanel">
					<div class="panel-title">👁️ 预览对比</div>

					<div class="preview-dual">
						<div class="preview-item">
							<div class="preview-label">原始图片</div>
							<div class="preview-canvas-wrap">
								<canvas id="beforeCanvas"></canvas>
							</div>
						</div>
						<div class="preview-item">
							<div class="preview-label after">处理后</div>
							<div class="preview-canvas-wrap">
								<canvas id="afterCanvas"></canvas>
							</div>
						</div>
					</div>

					<div class="size-compare" id="sizeCompare" style="display:none">
						<div class="size-compare-header">
							<span class="size-label">文件大小对比</span>
							<span class="size-saved" id="sizeSaved"></span>
						</div>
						<div class="size-bar">
							<div class="size-bar-original"></div>
							<div class="size-bar-processed" id="sizeBarProcessed" style="width:85%"></div>
						</div>
						<div class="size-details">
							<span>原始: <span class="size-original-val" id="sizeOriginal">—</span></span>
							<span>处理后: <span class="size-processed-val" id="sizeProcessed">—</span></span>
						</div>
					</div>

					<!-- Lightbox -->
					<div class="lightbox-overlay" id="lightboxOverlay">
						<div class="lightbox-content">
							<button class="lightbox-close" id="lightboxClose">✕</button>
							<img id="lightboxImg" src="" alt="预览大图">
							<div class="lightbox-label" id="lightboxLabel"></div>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				// ========== DOM References ==========
				var uploadZone = document.getElementById('uploadZone');
				var fileInput = document.getElementById('fileInput');
				var uploadStatus = document.getElementById('uploadStatus');
				var errorMsg = document.getElementById('errorMsg');
				var errorText = document.getElementById('errorText');
				var toolLayout = document.getElementById('toolLayout');
				var controlsPanel = document.getElementById('controlsPanel');
				var qualitySlider = document.getElementById('qualitySlider');
				var qualityValue = document.getElementById('qualityValue');
				var formatBtns = document.getElementById('formatBtns');
				var widthInput = document.getElementById('widthInput');
				var heightInput = document.getElementById('heightInput');
				var lockBtn = document.getElementById('lockBtn');
				var filterBtns = document.getElementById('filterBtns');
				var downloadBtn = document.getElementById('downloadBtn');
				var resetBtn = document.getElementById('resetBtn');
				var beforeCanvas = document.getElementById('beforeCanvas');
				var afterCanvas = document.getElementById('afterCanvas');
				var sizeCompare = document.getElementById('sizeCompare');
				var sizeSaved = document.getElementById('sizeSaved');
				var sizeBarProcessed = document.getElementById('sizeBarProcessed');
				var sizeOriginal = document.getElementById('sizeOriginal');
				var sizeProcessed = document.getElementById('sizeProcessed');
				var modeSwitch = document.getElementById('modeSwitch');
				var basicControls = document.getElementById('basicControls');
				var shuffleControls = document.getElementById('shuffleControls');
				var gridSizeBtns = document.getElementById('gridSizeBtns');
				var shuffleCountSlider = document.getElementById('shuffleCountSlider');
				var shuffleCountValue = document.getElementById('shuffleCountValue');
				var reshuffleBtn = document.getElementById('reshuffleBtn');

				// ========== State ==========
				var originalImage = null;
				var originalFile = null;
				var originalFileName = '';
				var currentBlob = null;
				var processedCanvas = null;
				var quality = 0.85;
				var format = 'image/jpeg';
				var targetWidth = 0;
				var targetHeight = 0;
				var origWidth = 0;
				var origHeight = 0;
				var aspectLocked = true;
				var activeFilter = 'none';
				var updateTimer = 0;
				var mode = 'basic';
				var gridSize = 3;
				var shuffleCount = 5;

				// ========== Helpers ==========
				function fmtSize(bytes) {
					if (bytes === 0) return '0 B';
					if (bytes < 1024) return bytes + ' B';
					if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
					return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
				}

				function showError(msg) {
					errorText.textContent = msg;
					errorMsg.style.display = 'flex';
					clearTimeout(errorMsg._timer);
					errorMsg._timer = setTimeout(function () {
						errorMsg.style.display = 'none';
					}, 4000);
				}

				function hideError() {
					errorMsg.style.display = 'none';
					clearTimeout(errorMsg._timer);
				}

				function setControlsEnabled(enabled) {
					if (enabled) {
						controlsPanel.classList.remove('controls-disabled');
					} else {
						controlsPanel.classList.add('controls-disabled');
					}
				}

				function getFormatExt() {
					if (format === 'image/jpeg') return 'jpg';
					if (format === 'image/png') return 'png';
					return 'webp';
				}

				function isPNG() {
					return format === 'image/png';
				}

				// ========== Image Loading ==========
				function loadImage(file) {
					hideError();

					// Validate file type
					if (!file.type.match(/^image\/(jpeg|png|webp)$/)) {
						if (file.type === 'image/svg+xml') {
							showError('SVG 格式暂不支持，请使用 JPEG、PNG 或 WebP 图片');
						} else if (file.type.startsWith('image/')) {
							showError('不支持的图片格式: ' + file.type + '，请使用 JPEG、PNG 或 WebP');
						} else {
							showError('请上传图片文件（JPEG、PNG 或 WebP）');
						}
						return;
					}

					if (file.size === 0) {
						showError('文件为空，请选择有效的图片文件');
						return;
					}

					originalFile = file;
					originalFileName = file.name.replace(/\.[^.]+$/, '');

					var reader = new FileReader();
					reader.onload = function (e) {
						var img = new Image();
						img.onload = function () {
							originalImage = img;
							origWidth = img.naturalWidth;
							origHeight = img.naturalHeight;

							// Clamp to max 4096
							if (origWidth > 4096 || origHeight > 4096) {
								var scale = 4096 / Math.max(origWidth, origHeight);
								origWidth = Math.round(origWidth * scale);
								origHeight = Math.round(origHeight * scale);
							}

							targetWidth = origWidth;
							targetHeight = origHeight;

							// Update inputs
							widthInput.value = targetWidth;
							heightInput.value = targetHeight;
							widthInput.max = origWidth * 2;
							heightInput.max = origHeight * 2;

							// Show tool layout
							toolLayout.style.display = '';
							setControlsEnabled(true);

							// Update quality slider state for PNG
							updateQualitySliderState();

							// Initial render
							renderPreview();
							processImage();

							// Update status
							uploadStatus.textContent = '已加载: ' + file.name + ' (' + fmtSize(file.size) + ')';
						};
						img.onerror = function () {
							showError('图片加载失败，文件可能已损坏');
						};
						img.src = e.target.result;
					};
					reader.onerror = function () {
						showError('文件读取失败，请重试');
					};
					reader.readAsDataURL(file);
				}

				// ========== Preview Rendering ==========
				function renderPreview() {
					if (!originalImage) return;

					// Before canvas: show original image
					var maxDisplayW = Math.min(beforeCanvas.parentElement.clientWidth - 4, 400);
					var scale = Math.min(maxDisplayW / origWidth, 1);
					var displayW = Math.round(origWidth * scale);
					var displayH = Math.round(origHeight * scale);

					beforeCanvas.width = displayW;
					beforeCanvas.height = displayH;
					var bCtx = beforeCanvas.getContext('2d');
					bCtx.imageSmoothingEnabled = true;
					bCtx.imageSmoothingQuality = 'high';
					bCtx.drawImage(originalImage, 0, 0, displayW, displayH);

					// After canvas: render processed image
					renderAfterPreview(displayW, displayH);
				}

				function renderAfterPreview(maxW, maxH) {
					if (!originalImage) return;
					maxW = maxW || Math.min(afterCanvas.parentElement.clientWidth - 4, 400);
					maxH = maxH || maxW;

					var source = processedCanvas || originalImage;
					var srcW = processedCanvas ? processedCanvas.width : origWidth;
					var srcH = processedCanvas ? processedCanvas.height : origHeight;

					var scale = Math.min(maxW / srcW, maxH / srcH, 1);
					var displayW = Math.round(srcW * scale);
					var displayH = Math.round(srcH * scale);

					afterCanvas.width = displayW;
					afterCanvas.height = displayH;
					var aCtx = afterCanvas.getContext('2d');
					aCtx.imageSmoothingEnabled = true;
					aCtx.imageSmoothingQuality = 'high';

					aCtx.clearRect(0, 0, displayW, displayH);
					aCtx.drawImage(source, 0, 0, displayW, displayH);
				}

				// ========== Image Processing ==========
				function processImage() {
					if (!originalImage) return;

					if (mode === 'shuffle') {
						shuffleImage();
						return;
					}

					// Create offscreen canvas at target dimensions
					var offscreen = document.createElement('canvas');
					offscreen.width = targetWidth;
					offscreen.height = targetHeight;
					var ctx = offscreen.getContext('2d');
					ctx.imageSmoothingEnabled = true;
					ctx.imageSmoothingQuality = 'high';

					// Apply filter if active
					if (activeFilter !== 'none') {
						ctx.filter = activeFilter;
					}
					ctx.drawImage(originalImage, 0, 0, targetWidth, targetHeight);

					// Store processed canvas for preview
					processedCanvas = offscreen;

					// Convert to blob
					var mimeType = format;
					var q = isPNG() ? undefined : quality;

					if (offscreen.toBlob) {
						offscreen.toBlob(function (blob) {
							if (!blob) {
								// Fallback
								blobFromDataURL(offscreen, mimeType);
								return;
							}
							currentBlob = blob;
							updateSizeDisplay();
							renderAfterPreview();
						}, mimeType, q);
					} else {
						blobFromDataURL(offscreen, mimeType);
					}
				}

				function blobFromDataURL(canvas, mimeType) {
					var dataURL = canvas.toDataURL(mimeType, isPNG() ? undefined : quality);
					var byteString = atob(dataURL.split(',')[1]);
					var ab = new ArrayBuffer(byteString.length);
					var ia = new Uint8Array(ab);
					for (var i = 0; i < byteString.length; i++) {
						ia[i] = byteString.charCodeAt(i);
					}
					currentBlob = new Blob([ab], { type: mimeType });
					updateSizeDisplay();
					renderAfterPreview();
				}

				// ========== Grid Shuffle ==========
				function shuffleImage() {
					if (!originalImage) return;

					var grid = gridSize;
					var totalCells = grid * grid;
					var cellW = Math.floor(targetWidth / grid);
					var cellH = Math.floor(targetHeight / grid);
	
					// Step 1: draw original to offscreen canvas
					var offscreen = document.createElement('canvas');
					offscreen.width = targetWidth;
					offscreen.height = targetHeight;
					var octx = offscreen.getContext('2d');
					octx.imageSmoothingEnabled = true;
					octx.imageSmoothingQuality = 'high';
					octx.drawImage(originalImage, 0, 0, targetWidth, targetHeight);

					// Step 2: record each cell's source rect (no ImageData needed)
					var cells = [];
					for (var row = 0; row < grid; row++) {
						for (var col = 0; col < grid; col++) {
							var x = col * cellW;
							var y = row * cellH;
							var w = (col === grid - 1) ? targetWidth - x : cellW;
							var h = (row === grid - 1) ? targetHeight - y : cellH;
							cells.push({ x: x, y: y, w: w, h: h, idx: row * grid + col });
						}
					}

					// Step 3: select cells to shuffle
					var count = Math.min(shuffleCount, totalCells);
					var allIndices = [];
					for (var i = 0; i < totalCells; i++) allIndices.push(i);
					for (var i = 0; i < count; i++) {
						var rand = i + Math.floor(Math.random() * (totalCells - i));
						var tmp = allIndices[i];
						allIndices[i] = allIndices[rand];
						allIndices[rand] = tmp;
					}
					var selectedPositions = allIndices.slice(0, count);

					// Step 4: Fisher-Yates shuffle the selected positions to create mapping
					var shuffledPositions = selectedPositions.slice();
					for (var i = shuffledPositions.length - 1; i > 0; i--) {
						var j = Math.floor(Math.random() * (i + 1));
						var t = shuffledPositions[i];
						shuffledPositions[i] = shuffledPositions[j];
						shuffledPositions[j] = t;
					}

					// Build mapping: selectedPositions[i] → shuffledPositions[i]
					var mapping = {};
					for (var i = 0; i < selectedPositions.length; i++) {
						mapping[selectedPositions[i]] = shuffledPositions[i];
					}

					// Step 5: draw cells at full size, then overlay grid lines
					var result = document.createElement('canvas');
					result.width = targetWidth;
					result.height = targetHeight;
					var rctx = result.getContext('2d');

					// Draw each cell: source determines content, destination determines size
					for (var i = 0; i < totalCells; i++) {
						var destIdx = mapping[i] !== undefined ? mapping[i] : i;
						var srcCell = cells[i];
						var destCol = destIdx % grid;
						var destRow = Math.floor(destIdx / grid);

						// Source rect (where to read from the offscreen canvas)
						var sx = srcCell.x, sy = srcCell.y, sw = srcCell.w, sh = srcCell.h;
						// Destination rect (size matches DESTINATION column/row)
						var dx = destCol * cellW;
						var dy = destRow * cellH;
						var dw = (destCol === grid - 1) ? (targetWidth - dx) : cellW;
						var dh = (destRow === grid - 1) ? (targetHeight - dy) : cellH;

						rctx.drawImage(offscreen, sx, sy, sw, sh, dx, dy, dw, dh);
					}

					// Overlay 1px white grid lines for visual separation
					rctx.strokeStyle = '#ffffff';
					rctx.lineWidth = 4;
					for (var col = 1; col < grid; col++) {
						rctx.beginPath();
						rctx.moveTo(col * cellW + 0.5, 0);
						rctx.lineTo(col * cellW + 0.5, targetHeight);
						rctx.stroke();
					}
					for (var row = 1; row < grid; row++) {
						rctx.beginPath();
						rctx.moveTo(0, row * cellH + 0.5);
						rctx.lineTo(targetWidth, row * cellH + 0.5);
						rctx.stroke();
					}

					processedCanvas = result;

					// Update preview immediately (synchronous)
					renderAfterPreview();

					// Step 6: convert to blob
					var mimeType = format;
					var q = isPNG() ? undefined : quality;

					if (result.toBlob) {
						result.toBlob(function (blob) {
							if (!blob) {
								blobFromDataURL(result, mimeType);
								return;
							}
							currentBlob = blob;
							updateSizeDisplay();
							renderAfterPreview();
						}, mimeType, q);
					} else {
						blobFromDataURL(result, mimeType);
					}
				}

				function updateSizeDisplay() {
					if (!originalFile || !currentBlob) return;

					var origSize = originalFile.size;
					var newSize = currentBlob.size;
					var savedPct = origSize > 0 ? Math.round((1 - newSize / origSize) * 100) : 0;
					var barWidth = origSize > 0 ? Math.max(1, Math.round((newSize / origSize) * 100)) : 100;

					sizeCompare.style.display = '';
					sizeOriginal.textContent = fmtSize(origSize);
					sizeProcessed.textContent = fmtSize(newSize);
					sizeBarProcessed.style.width = barWidth + '%';

					if (savedPct > 0) {
						sizeSaved.textContent = '节省 ' + savedPct + '%';
						sizeSaved.style.color = '#28a745';
					} else if (savedPct < 0) {
						sizeSaved.textContent = '增大 ' + Math.abs(savedPct) + '%';
						sizeSaved.style.color = '#dc3545';
					} else {
						sizeSaved.textContent = '大小相同';
						sizeSaved.style.color = 'rgb(var(--gray))';
					}
				}

				// ========== Control Handlers ==========
				function updateQualitySliderState() {
					if (isPNG()) {
						qualitySlider.disabled = true;
						qualityValue.textContent = '无损';
					} else {
						qualitySlider.disabled = false;
						qualityValue.textContent = Math.round(quality * 100) + '%';
					}
				}

				function scheduleUpdate() {
					clearTimeout(updateTimer);
					updateTimer = setTimeout(function () {
						processImage();
					}, 80);
				}

				// Quality slider
				qualitySlider.addEventListener('input', function () {
					quality = parseInt(this.value) / 100;
					qualityValue.textContent = this.value + '%';
					scheduleUpdate();
				});

				// Format buttons
				formatBtns.addEventListener('click', function (e) {
					var btn = e.target.closest('.format-btn');
					if (!btn) return;

					format = btn.getAttribute('data-format');
					var btns = formatBtns.querySelectorAll('.format-btn');
					for (var i = 0; i < btns.length; i++) {
						btns[i].classList.remove('active');
					}
					btn.classList.add('active');
					updateQualitySliderState();
					scheduleUpdate();
				});

				// Width/Height inputs
				widthInput.addEventListener('input', function () {
					var w = parseInt(this.value);
					if (isNaN(w) || w < 1) return;
					targetWidth = w;
					if (aspectLocked && origWidth > 0) {
						targetHeight = Math.round(targetWidth * (origHeight / origWidth));
						heightInput.value = targetHeight;
					}
					scheduleUpdate();
				});

				heightInput.addEventListener('input', function () {
					var h = parseInt(this.value);
					if (isNaN(h) || h < 1) return;
					targetHeight = h;
					if (aspectLocked && origHeight > 0) {
						targetWidth = Math.round(targetHeight * (origWidth / origHeight));
						widthInput.value = targetWidth;
					}
					scheduleUpdate();
				});

				// Lock button
				lockBtn.addEventListener('click', function () {
					aspectLocked = !aspectLocked;
					if (aspectLocked) {
						lockBtn.classList.add('locked');
						// Re-sync aspect ratio
						if (origWidth > 0 && origHeight > 0) {
							targetHeight = Math.round(targetWidth * (origHeight / origWidth));
							heightInput.value = targetHeight;
							scheduleUpdate();
						}
					} else {
						lockBtn.classList.remove('locked');
					}
				});

				// Filter buttons
				filterBtns.addEventListener('click', function (e) {
					var btn = e.target.closest('.filter-btn');
					if (!btn) return;

					activeFilter = btn.getAttribute('data-filter');
					var btns = filterBtns.querySelectorAll('.filter-btn');
					for (var i = 0; i < btns.length; i++) {
						btns[i].classList.remove('active');
					}
					btn.classList.add('active');
					scheduleUpdate();
				});

				// ========== Download ==========
				downloadBtn.addEventListener('click', function () {
					if (!currentBlob) return;

					var ext = getFormatExt();
					var filename = 'processed-' + (originalFileName || 'image') + '-' + targetWidth + 'x' + targetHeight + '.' + ext;

					var url = URL.createObjectURL(currentBlob);
					var a = document.createElement('a');
					a.href = url;
					a.download = filename;
					document.body.appendChild(a);
					a.click();
					document.body.removeChild(a);
					setTimeout(function () {
						URL.revokeObjectURL(url);
					}, 100);
				});

				// ========== Reset ==========
				resetBtn.addEventListener('click', function () {
					if (!originalImage) return;

					quality = 0.85;
					format = 'image/jpeg';
					targetWidth = origWidth;
					targetHeight = origHeight;
					activeFilter = 'none';
					gridSize = 3;
					shuffleCount = 5;
					processedCanvas = null;

					// Reset UI — basic controls
					qualitySlider.value = '85';
					qualityValue.textContent = '85%';
					widthInput.value = targetWidth;
					heightInput.value = targetHeight;

					var fBtns = formatBtns.querySelectorAll('.format-btn');
					for (var i = 0; i < fBtns.length; i++) {
						fBtns[i].classList.remove('active');
						if (fBtns[i].getAttribute('data-format') === 'image/jpeg') {
							fBtns[i].classList.add('active');
						}
					}

					var fltBtns = filterBtns.querySelectorAll('.filter-btn');
					for (var j = 0; j < fltBtns.length; j++) {
						fltBtns[j].classList.remove('active');
						if (fltBtns[j].getAttribute('data-filter') === 'none') {
							fltBtns[j].classList.add('active');
						}
					}

					// Reset UI — shuffle controls
					shuffleCountSlider.value = '5';
					shuffleCountValue.textContent = '5';
					shuffleCountSlider.max = '9';
					var gBtns = gridSizeBtns.querySelectorAll('.grid-size-btn');
					for (var k = 0; k < gBtns.length; k++) {
						gBtns[k].classList.remove('active');
						if (gBtns[k].getAttribute('data-grid') === '9') {
							gBtns[k].classList.add('active');
						}
					}

					// Switch to basic mode
					if (mode === 'shuffle') {
						mode = 'basic';
						basicControls.style.display = '';
						shuffleControls.style.display = 'none';
						var mBtns = modeSwitch.querySelectorAll('.mode-btn');
						for (var m = 0; m < mBtns.length; m++) {
							mBtns[m].classList.remove('active');
							if (mBtns[m].getAttribute('data-mode') === 'basic') {
								mBtns[m].classList.add('active');
							}
						}
					}

					updateQualitySliderState();
					renderPreview();
					processImage();
				});

				// ========== Mode Switch ==========
				modeSwitch.addEventListener('click', function (e) {
					var btn = e.target.closest('.mode-btn');
					if (!btn) return;

					var newMode = btn.getAttribute('data-mode');
					if (newMode === mode) return;

					mode = newMode;

					// Update active button
					var btns = modeSwitch.querySelectorAll('.mode-btn');
					for (var i = 0; i < btns.length; i++) {
						btns[i].classList.remove('active');
					}
					btn.classList.add('active');

					// Toggle controls visibility
					if (mode === 'shuffle') {
						basicControls.style.display = 'none';
						shuffleControls.style.display = '';
					} else {
						basicControls.style.display = '';
						shuffleControls.style.display = 'none';
					}

					// Reprocess with new mode
					if (originalImage) {
						processedCanvas = null;
						processImage();
					}
				});

				// ========== Grid Size ==========
				gridSizeBtns.addEventListener('click', function (e) {
					var btn = e.target.closest('.grid-size-btn');
					if (!btn) return;

					gridSize = parseInt(btn.getAttribute('data-grid'));
					var maxCells = gridSize * gridSize;

					// Update active button
					var btns = gridSizeBtns.querySelectorAll('.grid-size-btn');
					for (var i = 0; i < btns.length; i++) {
						btns[i].classList.remove('active');
					}
					btn.classList.add('active');

					// Update shuffle count slider max = total cells (gridSize²)
					var maxCells = gridSize * gridSize;
					shuffleCountSlider.max = maxCells;
					// Proportionally adjust shuffleCount to new total
					var oldMax = (gridSize === 3 ? 16 : 9);
					shuffleCount = Math.max(1, Math.round(shuffleCount / oldMax * maxCells));
					shuffleCountSlider.value = shuffleCount;
					shuffleCountValue.textContent = shuffleCount;

					if (mode === 'shuffle' && originalImage) {
						processImage();
					}
				});

				// ========== Shuffle Count Slider ==========
				shuffleCountSlider.addEventListener('input', function () {
					shuffleCount = parseInt(this.value);
					shuffleCountValue.textContent = shuffleCount;
					if (mode === 'shuffle' && originalImage) {
						processImage();
					}
				});

				// ========== Reshuffle Button ==========
				reshuffleBtn.addEventListener('click', function () {
					if (mode === 'shuffle' && originalImage) {
						processImage();
					}
				});

				// ========== Upload Handlers ==========
				uploadZone.addEventListener('click', function () {
					fileInput.click();
				});

				fileInput.addEventListener('change', function () {
					if (this.files && this.files[0]) {
						loadImage(this.files[0]);
					}
				});

				// Drag and drop
				uploadZone.addEventListener('dragover', function (e) {
					e.preventDefault();
					e.stopPropagation();
					this.classList.add('drag-over');
				});

				uploadZone.addEventListener('dragenter', function (e) {
					e.preventDefault();
					e.stopPropagation();
					this.classList.add('drag-over');
				});

				uploadZone.addEventListener('dragleave', function (e) {
					e.preventDefault();
					e.stopPropagation();
					this.classList.remove('drag-over');
				});

				uploadZone.addEventListener('drop', function (e) {
					e.preventDefault();
					e.stopPropagation();
					this.classList.remove('drag-over');

					var files = e.dataTransfer.files;
					if (files && files[0]) {
						loadImage(files[0]);
					}
				});

				// Global drag events to prevent browser opening the file
				document.addEventListener('dragover', function (e) {
					e.preventDefault();
				});
				document.addEventListener('drop', function (e) {
					e.preventDefault();
				});

				// ========== Initial State ==========
				setControlsEnabled(false);
				// ========== Lightbox ==========
				var lightboxOverlay = document.getElementById('lightboxOverlay');
				var lightboxImg = document.getElementById('lightboxImg');
				var lightboxLabel = document.getElementById('lightboxLabel');
				var lightboxClose = document.getElementById('lightboxClose');

				function openLightbox(canvas, label) {
					lightboxImg.src = canvas.toDataURL();
					lightboxLabel.textContent = label;
					lightboxOverlay.classList.add('active');
					document.body.style.overflow = 'hidden';
				}

				function closeLightbox() {
					lightboxOverlay.classList.remove('active');
					document.body.style.overflow = '';
					lightboxImg.src = '';
				}

				document.getElementById('beforeCanvas').parentElement.addEventListener('click', function () {
					if (originalImage) openLightbox(beforeCanvas, '原始图片');
				});
				document.getElementById('afterCanvas').parentElement.addEventListener('click', function () {
					if (originalImage) {
						var canvas = processedCanvas ? (function() {
							var c = document.createElement('canvas');
							c.width = processedCanvas.width;
							c.height = processedCanvas.height;
							c.getContext('2d').drawImage(processedCanvas, 0, 0);
							return c;
						})() : beforeCanvas;
						openLightbox(canvas, mode === 'shuffle' ? '网格打乱' : '处理后');
					}
				});

				lightboxClose.addEventListener('click', function (e) {
					e.stopPropagation();
					closeLightbox();
				});
				lightboxOverlay.addEventListener('click', function (e) {
					if (e.target === lightboxOverlay) closeLightbox();
				});
				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape' && lightboxOverlay.classList.contains('active')) {
						closeLightbox();
					}
				});

			})();
		</script>
	</body>
</html>
