---
import AboutHeroImage from '../assets/kaito_1.jpg';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title="关于我"
			description="Kaito 的个人介绍与技术博客 — 嵌入式软件工程师，音视频开发方向，热爱技术写作与开源探索"
		/>
		<style>
			/* ===== Layout basics ===== */
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 0 1em 3em;
			}

			/* ===== Hero ===== */
			.hero {
				position: relative;
				margin: 0 -1em 2.5em;
				overflow: hidden;
			}
			.hero-banner {
				width: 100%;
				max-height: 260px;
				overflow: hidden;
			}
			.hero-banner img {
				display: block;
				width: 100%;
				height: auto;
				max-height: 260px;
				object-fit: cover;
				border-radius: 0 0 20px 20px;
				box-shadow: var(--box-shadow);
			}
			.hero-content {
				position: relative;
				margin-top: 0;
				padding: 4em 1.5em 0;
				text-align: center;
			}
			.hero-name {
				font-size: 1.8em;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0 0 0.15em;
				line-height: 1.2;
			}
			.hero-tagline {
				font-size: 0.95em;
				color: rgb(var(--gray));
				margin: 0 0 0.8em;
				line-height: 1.6;
			}
			.hero-socials {
				display: flex;
				justify-content: center;
				gap: 0.6em;
				flex-wrap: wrap;
			}
			.hero-socials a {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				padding: 0.3em 0.8em;
				border-radius: 999px;
				font-size: 0.82em;
				font-weight: 600;
				text-decoration: none;
				background: rgba(var(--accent-rgb), 0.06);
				color: rgb(var(--black));
				border: 1px solid rgba(var(--gray-light), 0.6);
				transition: background 0.2s, border-color 0.2s;
			}
			.hero-socials a:hover {
				background: rgba(var(--accent-rgb), 0.12);
				border-color: var(--accent);
			}

			/* ===== Section spacing ===== */
			section {
				margin-bottom: 2.8em;
			}
			.section-title {
				display: flex;
				align-items: center;
				gap: 0.4em;
				margin: 0 0 1em;
				font-size: 1.05em;
				font-weight: 700;
				color: rgb(var(--black));
				letter-spacing: -0.01em;
			}
			.section-title::after {
				content: '';
				flex: 1;
				height: 2px;
				background: linear-gradient(90deg, rgba(var(--accent-rgb), 0.15), transparent);
				margin-left: 0.5em;
			}

			/* ===== Intro ===== */
			.intro p {
				margin: 0 0 0.6em;
				font-size: 0.95em;
				line-height: 1.75;
				color: rgb(var(--gray-dark));
			}
			.intro p:last-child {
				margin-bottom: 0;
			}

			/* ===== Two-column layout ===== */
			.two-col {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5em;
			}

			/* ===== Now grid ===== */
			.now-grid {
				display: flex;
				flex-direction: column;
				gap: 0.6em;
			}
			.now-card {
				display: flex;
				gap: 0.7em;
				align-items: flex-start;
				background: var(--card-bg);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 0.9em 1em;
				transition: box-shadow 0.2s, border-color 0.2s;
			}
			.now-card:hover {
				box-shadow: 0 2px 12px rgba(var(--black), 0.04);
				border-color: rgba(var(--accent-rgb), 0.2);
			}
			.now-icon {
				font-size: 1.3em;
				flex-shrink: 0;
				line-height: 1.3;
			}
			.now-card strong {
				display: block;
				font-size: 0.88em;
				color: rgb(var(--black));
				margin-bottom: 0.15em;
			}
			.now-card p {
				margin: 0;
				font-size: 0.8em;
				color: rgb(var(--gray));
				line-height: 1.55;
			}

			/* ===== Blog stats ===== */
			.blog-stats {
				display: flex;
				gap: 0.6em;
				margin-bottom: 0.8em;
			}
			.bs-card {
				flex: 1;
				text-align: center;
				background: var(--card-bg);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 0.8em 0.6em;
			}
			.bs-num {
				display: block;
				font-size: 1.6em;
				font-weight: 700;
				color: var(--accent);
				line-height: 1.2;
			}
			.bs-label {
				font-size: 0.75em;
				color: rgb(var(--gray));
			}
			.bs-desc {
				font-size: 0.82em;
				color: rgb(var(--gray));
				line-height: 1.6;
				margin: 0;
			}

			/* ===== Timeline ===== */
			.timeline {
				position: relative;
				padding: 0.3em 0;
			}
			.tl-item {
				display: grid;
				grid-template-columns: 28px 1fr;
				gap: 0.9em;
				position: relative;
			}
			.tl-item:not(:last-child) {
				padding-bottom: 0.8em;
			}

			.tl-marker {
				display: flex;
				flex-direction: column;
				align-items: center;
				position: relative;
			}
			.tl-dot {
				width: 11px;
				height: 11px;
				border-radius: 50%;
				background: var(--accent);
				flex-shrink: 0;
				margin-top: 0.5em;
				position: relative;
				z-index: 2;
				box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.10);
			}
			.tl-item:not(:last-child) .tl-marker::after {
				content: '';
				width: 2px;
				flex: 1;
				background: rgba(var(--accent-rgb), 0.12);
				margin-top: 6px;
				min-height: calc(100% + 0.8em);
			}

			.tl-card {
				background: var(--card-bg);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 0.8em 1em;
				transition: box-shadow 0.2s;
			}
			.tl-item:hover .tl-card {
				box-shadow: 0 2px 14px rgba(var(--black), 0.04);
			}
			.tl-header {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.4em;
				margin-bottom: 0.2em;
			}
			.tl-date {
				font-size: 0.75em;
				font-weight: 600;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.06);
				padding: 0.12em 0.55em;
				border-radius: 999px;
			}
			.tl-duration {
				font-size: 0.72em;
				color: rgb(var(--gray));
			}
			.tl-card h3 {
				margin: 0 0 0.1em;
				font-size: 0.95em;
				font-weight: 700;
				color: rgb(var(--black));
			}
			.tl-sub {
				font-size: 0.78em;
				color: rgb(var(--gray));
				margin-bottom: 0.4em;
			}
			.tl-card p {
				margin: 0 0 0.4em;
				font-size: 0.82em;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
			.tl-skills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25em;
			}
			.tl-skills span {
				font-size: 0.7em;
				padding: 0.1em 0.5em;
				border-radius: 999px;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.06);
			}

			/* ===== Tech stack ===== */
			.stack-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.6em;
			}
			.stack-cat {
				background: var(--card-bg);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 0.8em 1em;
			}
			.stack-cat h3 {
				margin: 0 0 0.4em;
				font-size: 0.85em;
				color: rgb(var(--black));
			}
			.stack-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25em;
			}
			.stack-tags span {
				font-size: 0.73em;
				padding: 0.15em 0.5em;
				border-radius: 999px;
				font-weight: 600;
			}
			.st-primary {
				color: #fff;
				background: var(--accent);
			}
			.st-secondary {
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.07);
			}

			/* ===== Dev environment ===== */
			.dev-env {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.5em;
			}
			.de-item {
				display: flex;
				gap: 0.5em;
				align-items: flex-start;
				background: var(--card-bg);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				padding: 0.6em 0.8em;
			}
			.de-icon {
				font-size: 1.1em;
				flex-shrink: 0;
			}
			.de-item strong {
				display: block;
				font-size: 0.82em;
				color: rgb(var(--black));
				margin-bottom: 0.05em;
			}
			.de-item p {
				margin: 0;
				font-size: 0.75em;
				color: rgb(var(--gray));
			}

			/* ===== Beyond code ===== */
			.beyond-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.5em;
			}
			.bc-item {
				display: flex;
				gap: 0.5em;
				align-items: center;
				background: var(--card-bg);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				padding: 0.55em 0.8em;
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.bc-icon {
				font-size: 1.1em;
				flex-shrink: 0;
			}

			/* ===== Contact ===== */
			.contact-grid {
				display: flex;
				gap: 0.6em;
				margin-top: 0.6em;
			}
			.contact-card {
				flex: 1;
				display: flex;
				align-items: center;
				gap: 0.6em;
				background: var(--card-bg);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 0.9em 1em;
				text-decoration: none;
				transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
			}
			.contact-card:hover {
				box-shadow: 0 2px 12px rgba(var(--black), 0.05);
				border-color: var(--accent);
				transform: translateY(-1px);
			}
			.cc-icon {
				font-size: 1.5em;
				flex-shrink: 0;
			}
			.cc-body strong {
				display: block;
				color: rgb(var(--black));
				font-size: 0.9em;
			}
			.cc-body span {
				color: rgb(var(--gray));
				font-size: 0.78em;
			}

			/* ===== Site info ===== */
			.site-info p {
				margin: 0 0 0.5em;
				font-size: 0.88em;
				color: rgb(var(--gray-dark));
				line-height: 1.7;
			}
			.site-info p:last-child {
				margin-bottom: 0;
			}

			/* ===== Footer quote ===== */
			.footer-quote {
				text-align: center;
				padding: 1.8em 0 0;
				color: rgb(var(--gray));
				font-size: 0.88em;
				font-style: italic;
			}
			.footer-quote::before {
				content: '';
				display: block;
				width: 48px;
				height: 3px;
				background: rgba(var(--accent-rgb), 0.15);
				border-radius: 2px;
				margin: 0 auto 1em;
			}

			/* ===== Responsive ===== */
			@media (max-width: 768px) {
				.two-col {
					grid-template-columns: 1fr;
					gap: 1.2em;
				}
				.hero-content {
					padding: 2em 1em 0;
				}
				.hero-tagline {
					font-size: 0.88em;
				}
				section {
					margin-bottom: 2.2em;
				}
				.blog-stats {
					flex-wrap: wrap;
				}
			}

			@media (max-width: 600px) {
				.stack-grid,
				.dev-env,
				.beyond-grid {
					grid-template-columns: 1fr;
				}
				.contact-grid {
					flex-direction: column;
				}
				.tl-item {
					grid-template-columns: 22px 1fr;
					gap: 0.6em;
				}
				.tl-dot {
					width: 9px;
					height: 9px;
				}
				.hero-name {
					font-size: 1.4em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<!-- ==================== Hero ==================== -->
			<div class="hero">
				<div class="hero-banner">
					<Image src={AboutHeroImage} alt="" width={720} height={260} />
				</div>
				<div class="hero-content">
										<h1 class="hero-name">Kaito</h1>
					<p class="hero-tagline">
						嵌入式软件工程师 · 深耕音视频编解码与流媒体传输 ·
						<br />
						在技术写作中持续成长
					</p>
					<div class="hero-socials">
						<a href="https://github.com/korolkk" target="_blank">🐙 GitHub</a>
						<a href="mailto:704788475@qq.com">📧 Email</a>
					</div>
				</div>
			</div>

			<!-- ==================== 关于我 ==================== -->
			<section>
				<h2 class="section-title">👤 关于我</h2>
				<div class="intro">
					<p>
						你好，我是 Kaito，目前就职于<strong>浙江大华</strong>，担任嵌入式软件工程师，
						专注于<strong>音视频编解码</strong>与<strong>流媒体传输</strong>方向。
						日常与海思、联咏、星宸等芯片平台打交道，用 C/C++ 在底层世界里解决问题。
					</p>
					<p>
						工作之余运营 <strong>KaitoHub</strong> 技术博客，相信「输出倒逼输入」——
						写作不仅是记录，更是深度思考的过程。目前已累计发表 77 篇文章，
						内容覆盖嵌入式开发、算法题解、项目实战与工具教程。
					</p>
					<p>
						杭州电子科技大学计算机专业毕业，曾获数学建模美赛 F 奖（全球 &lt; 2%），
						字节跳动青训营优秀学员。持续学习中，保持好奇，保持饥饿。
					</p>
				</div>
			</section>

			<!-- ==================== 当前在做 + 博客数据 ==================== -->
			<section>
				<div class="two-col">
					<div>
						<h2 class="section-title">🔭 当前在做</h2>
						<div class="now-grid">
							<div class="now-card">
								<span class="now-icon">📝</span>
								<div>
									<strong>持续写作</strong>
									<p>维护 KaitoHub 技术博客，目标每月至少 2 篇高质量文章。</p>
								</div>
							</div>
							<div class="now-card">
								<span class="now-icon">🤖</span>
								<div>
									<strong>AI 辅助编程实践</strong>
									<p>深度使用 Claude Code、Cursor 等工具，探索 AI × 嵌入式的最佳实践。</p>
								</div>
							</div>
							<div class="now-card">
								<span class="now-icon">🎯</span>
								<div>
									<strong>音视频技术深耕</strong>
									<p>深入 H.264/H.265 编码原理、WebRTC 协议栈、流媒体框架。</p>
								</div>
							</div>
						</div>
					</div>

					<div>
						<h2 class="section-title">📊 博客数据</h2>
						<div class="blog-stats">
							<div class="bs-card">
								<span class="bs-num">77</span>
								<span class="bs-label">技术文章</span>
							</div>
							<div class="bs-card">
								<span class="bs-num">3+</span>
								<span class="bs-label">年持续写作</span>
							</div>
							<div class="bs-card">
								<span class="bs-num">4</span>
								<span class="bs-label">内容板块</span>
							</div>
						</div>
						<p class="bs-desc">
							覆盖 <strong>嵌入式开发</strong> · <strong>算法题解</strong> · <strong>项目实战</strong> · <strong>工具教程</strong> 四大方向，
							从底层驱动到上层应用。
						</p>
					</div>
				</div>
			</section>

			<!-- ==================== 成长历程 ==================== -->
			<section>
				<h2 class="section-title">📌 成长历程</h2>
				<div class="timeline">
					<div class="tl-item">
						<div class="tl-marker">
							<div class="tl-dot"></div>
						</div>
						<div class="tl-card">
							<div class="tl-header">
								<span class="tl-date">2024.06 — 至今</span>
								<span class="tl-duration">2 年</span>
							</div>
							<h3>KaitoHub · 技术写作</h3>
							<div class="tl-sub">个人技术博客，累计文章 77 篇</div>
							<p>从 Hexo 迁移至 Astro 6 全面重设计，持续输出嵌入式、算法、项目实战内容。</p>
							<div class="tl-skills">
								<span>Astro</span><span>Markdown</span><span>SEO</span><span>AI 工具</span>
							</div>
						</div>
					</div>

					<div class="tl-item">
						<div class="tl-marker">
							<div class="tl-dot"></div>
						</div>
						<div class="tl-card">
							<div class="tl-header">
								<span class="tl-date">2023.07 — 至今</span>
								<span class="tl-duration">3 年</span>
							</div>
							<h3>浙江大华 · 嵌入式软件工程师</h3>
							<div class="tl-sub">杭州 · 音视频编解码与流媒体传输</div>
							<p>C/C++ 开发，深度接触海思、联咏、星宸芯片平台，积累底层系统与性能优化经验。</p>
							<div class="tl-skills">
								<span>C/C++</span><span>音视频编解码</span><span>海思</span><span>联咏</span><span>星宸</span>
							</div>
						</div>
					</div>

					<div class="tl-item">
						<div class="tl-marker">
							<div class="tl-dot"></div>
						</div>
						<div class="tl-card">
							<div class="tl-header">
								<span class="tl-date">2023.04 — 2023.06</span>
								<span class="tl-duration">3 个月</span>
							</div>
							<h3>ROS2 · 机器人公司实习</h3>
							<div class="tl-sub">嵌入式开发实习 · 深度图像 → 点云数据转换</div>
							<p>自学 ROS2 协议栈后完成实习，将理论与工程实践结合，获得软硬结合开发经验。</p>
							<div class="tl-skills">
								<span>ROS2</span><span>OpenCV</span><span>点云处理</span><span>Python</span>
							</div>
						</div>
					</div>

					<div class="tl-item">
						<div class="tl-marker">
							<div class="tl-dot"></div>
						</div>
						<div class="tl-card">
							<div class="tl-header">
								<span class="tl-date">2023.01 — 2023.03</span>
								<span class="tl-duration">3 个月</span>
							</div>
							<h3>字节跳动青训营 · 后端方向</h3>
							<div class="tl-sub">优秀学员 · Hertz / Kitex 框架实战</div>
							<p>深入 Go 语言、微服务架构与分布式系统，结项项目获得优秀学员称号。</p>
							<div class="tl-skills">
								<span>Go</span><span>Hertz</span><span>Kitex</span><span>微服务</span>
							</div>
						</div>
					</div>

					<div class="tl-item">
						<div class="tl-marker">
							<div class="tl-dot"></div>
						</div>
						<div class="tl-card">
							<div class="tl-header">
								<span class="tl-date">2022.02</span>
								<span class="tl-duration">美赛 F 奖</span>
