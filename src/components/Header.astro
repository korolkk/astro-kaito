---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="nav-inner">
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="nav-right">
			<button class="search-btn" id="searchBtn" aria-label="Search">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
					<path fill="currentColor" d="M10 18a7.952 7.952 0 0 0 4.897-1.688l4.396 4.396 1.414-1.414-4.396-4.396A7.952 7.952 0 0 0 18 10c0-4.411-3.589-8-8-8s-8 3.589-8 8 3.589 8 8 8zm0-14c3.309 0 6 2.691 6 6s-2.691 6-6 6-6-2.691-6-6 2.691-6 6-6z"/>
				</svg>
			</button>
			<div class="theme-switcher">
				<button class="theme-btn" aria-label="切换主题">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm0-2a8 8 0 1 0 0-16.01A8 8 0 0 0 12 20zm0-2a6 6 0 0 1-6-6h2a4 4 0 0 0 4 4v2zm-6-6a6 6 0 0 1 6-6v2a4 4 0 0 0-4 4H6z"/>
					</svg>
				</button>
				<div class="theme-dropdown" id="themeDropdown">
					<button class="theme-option" data-theme="light">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M8 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 8 1zm0 10a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm5.657-5.657a.5.5 0 0 1 0 .707l-.707.707a.5.5 0 1 1-.707-.707l.707-.707a.5.5 0 0 1 .707 0zM2.343 8.657a.5.5 0 0 1-.707-.707l.707-.707a.5.5 0 0 1 .707.707l-.707.707zM8 13.5a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1a.5.5 0 0 1 .5-.5zm5.657.657a.5.5 0 0 1-.707 0l-.707-.707a.5.5 0 0 1 .707-.707l.707.707a.5.5 0 0 1 0 .707zM2.343 2.343a.5.5 0 0 1 .707 0l.707.707a.5.5 0 1 1-.707.707l-.707-.707a.5.5 0 0 1 0-.707zM8 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/>
						</svg>
						亮色
					</button>
					<button class="theme-option" data-theme="dark">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.013.893A7.99 7.99 0 0 1 8.002 16c-4.414 0-8-3.582-8-7.998a7.999 7.999 0 0 1 5.998-7.724z"/>
						</svg>
						暗色
					</button>
					<button class="theme-option" data-theme="system">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V2zm1 0v10h14V2H1zm1.5 1.5h4v3h-4v-3zm5 0h4v1h-4v-1zm0 2h4v1h-4v-1z"/>
						</svg>
						跟随系统
					</button>
				</div>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: transparent;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1140px;
		margin: 0 auto;
		padding: 0.6em 2em;
		background: var(--card-bg);
		border-top-left-radius: 0;
		border-top-right-radius: 0;
		border-bottom-left-radius: 20px;
		border-bottom-right-radius: 20px;
		box-shadow: 0 2px 12px rgba(var(--black), 0.04);
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.search-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 0.4em 0.6em;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		display: flex;
		align-items: center;
		transition: all 0.2s ease;
	}
	.search-btn:hover {
		background: rgb(var(--gray-light));
		color: var(--accent);
	}

	/* Theme switcher */
	.theme-switcher {
		position: relative;
	}
	.theme-switcher::after {
		content: '';
		position: absolute;
		inset: 100% 0 auto 0;
		height: 10px;
	}
	.theme-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 0.4em 0.6em;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		display: flex;
		align-items: center;
		transition: all 0.2s ease;
	}
	.theme-btn:hover {
		background: rgb(var(--gray-light));
		color: var(--accent);
	}
	.theme-dropdown {
		position: absolute;
		top: 100%;
		right: 0;
		margin-top: 1px;
		background: var(--card-bg);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 0.4em;
		display: none;
		flex-direction: column;
		gap: 0.15em;
		min-width: 140px;
		box-shadow: 0 4px 20px rgba(0,0,0,0.12);
		z-index: 100;
	}
	.theme-switcher:hover .theme-dropdown {
		display: flex;
	}
	.theme-option {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.55em 0.8em;
		border: none;
		border-radius: 6px;
		background: transparent;
		color: rgb(var(--gray-dark));
		font-size: 0.88em;
		cursor: pointer;
		white-space: nowrap;
		transition: background 0.15s ease;
		font-family: inherit;
	}
	.theme-option:hover {
		background: rgb(var(--gray-light));
	}
	.theme-option.active {
		background: rgb(var(--gray-light));
		color: var(--accent);
		font-weight: 600;
	}
</style>
<script>
	function applyTheme(choice) {
		const preferDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		const resolved = choice === 'dark' || choice === 'light' ? choice : (preferDark ? 'dark' : 'light');
		document.documentElement.setAttribute('data-theme', resolved);
		document.documentElement.setAttribute('data-theme-choice', choice);
		localStorage.setItem('theme', choice);
		updateActiveOption(choice);
	}

	function updateActiveOption(choice) {
		document.querySelectorAll('.theme-option').forEach(btn => {
			btn.classList.toggle('active', btn.dataset.theme === choice);
		});
	}

	// Init on page load
	const saved = localStorage.getItem('theme') || 'system';
	updateActiveOption(saved);

	// Click handlers
	document.querySelectorAll('.theme-option').forEach(btn => {
		btn.addEventListener('click', () => {
			applyTheme(btn.dataset.theme);
		});
	});

	// Listen for system theme changes when in "system" mode
	window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
		const current = localStorage.getItem('theme') || 'system';
		if (current === 'system') {
			applyTheme('system');
		}
	});
</script>
