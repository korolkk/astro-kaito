---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header data-base-url={import.meta.env.BASE_URL}>
	<a class="skip-to-content" href="#main-content">跳到主要内容</a>
	<nav class="nav-inner">
		<h2><a href={base}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={base}>首页</HeaderLink>
			<HeaderLink href={`${base}blog`}>文章</HeaderLink>
			<HeaderLink href={`${base}ai-tools`}>AI工具</HeaderLink>
			<HeaderLink href={`${base}about`}>关于</HeaderLink>
		</div>
		<div class="nav-right">
			<div class="search-area" id="searchArea">
				<input
					type="text"
					id="searchInput"
					class="search-input"
					placeholder="搜索..."
					autocomplete="off"
				/>
				<div class="search-results" id="searchResults"></div>
			</div>
			<button class="search-btn" id="searchBtn" aria-label="搜索">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
					<path fill="currentColor" d="M10 18a7.952 7.952 0 0 0 4.897-1.688l4.396 4.396 1.414-1.414-4.396-4.396A7.952 7.952 0 0 0 18 10c0-4.411-3.589-8-8-8s-8 3.589-8 8 3.589 8 8 8zm0-14c3.309 0 6 2.691 6 6s-2.691 6-6 6-6-2.691-6-6 2.691-6 6-6z"/>
				</svg>
			</button>
			<div class="theme-switcher">
				<button class="theme-btn" aria-label="切换主题">
					<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
						<path fill="currentColor" d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zm0-2a8 8 0 1 0 0-16.01A8 8 0 0 0 12 20zm0-2a6 6 0 0 1-6-6h2a4 4 0 0 0 4 4v2zm-6-6a6 6 0 0 1 6-6v2a4 4 0 0 0-4 4H6z"/>
					</svg>
				</button>
				<div class="theme-dropdown" id="themeDropdown">
					<button class="theme-option" data-theme="light">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M8 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1A.5.5 0 0 1 8 1zm0 10a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm5.657-5.657a.5.5 0 0 1 0 .707l-.707.707a.5.5 0 1 1-.707-.707l.707-.707a.5.5 0 0 1 .707 0zM2.343 8.657a.5.5 0 0 1-.707-.707l.707-.707a.5.5 0 0 1 .707.707l-.707.707zM8 13.5a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-1 0v-1a.5.5 0 0 1 .5-.5zm5.657.657a.5.5 0 0 1-.707 0l-.707-.707a.5.5 0 0 1 .707-.707l.707.707a.5.5 0 0 1 0 .707zM2.343 2.343a.5.5 0 0 1 .707 0l.707.707a.5.5 0 1 1-.707.707l-.707-.707a.5.5 0 0 1 0-.707zM8 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/>
						</svg>
						亮色
					</button>
					<button class="theme-option" data-theme="dark">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.013.893A7.99 7.99 0 0 1 8.002 16c-4.414 0-8-3.582-8-7.998a7.999 7.999 0 0 1 5.998-7.724z"/>
						</svg>
						暗色
					</button>
					<button class="theme-option" data-theme="system">
						<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V2zm1 0v10h14V2H1zm1.5 1.5h4v3h-4v-3zm5 0h4v1h-4v-1zm0 2h4v1h-4v-1z"/>
						</svg>
						跟随系统
					</button>
				</div>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0;
		background: transparent;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	/* Skip to content */
	.skip-to-content {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%) translateY(-100%);
		background: var(--accent);
		color: #fff;
		padding: 0.5em 1em;
		border-radius: 0 0 8px 8px;
		z-index: 200;
		font-size: 0.9em;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.2s ease;
	}
	.skip-to-content:focus {
		transform: translateX(-50%) translateY(0);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		max-width: 1140px;
		margin: 0 auto;
		padding: 0.6em 2em;
		background: var(--card-bg);
		border-bottom-left-radius: 20px;
		border-bottom-right-radius: 20px;
		box-shadow: 0 2px 12px rgba(var(--black), 0.04);
		position: relative;
		z-index: 100;
		box-sizing: border-box;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}

	/* Search */
	.search-area {
		position: relative;
		display: flex;
		align-items: center;
	}
	.search-input {
		width: 0;
		padding: 0;
		border: none;
		background: transparent;
		color: rgb(var(--black));
		font-size: 0.9em;
		font-family: inherit;
		outline: none;
		transition: width 0.25s ease, padding 0.25s ease;
	}
	.search-area.open .search-input {
		width: 200px;
		padding: 0.45em 0.6em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: rgb(var(--gray-light));
	}
	.search-input::placeholder {
		color: rgb(var(--gray));
	}
	.search-results {
		position: absolute;
		top: 100%;
		right: 0;
		margin-top: 0.5em;
		width: 320px;
		background: var(--card-bg);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		max-height: 360px;
		overflow-y: auto;
		box-shadow: 0 4px 24px rgba(0,0,0,0.12);
		display: none;
	}
	.search-area.has-results .search-results {
		display: block;
	}
	.search-empty {
		text-align: center;
		padding: 2em 1em;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	.search-result-item {
		display: block;
		padding: 0.85em 1em;
		text-decoration: none;
		border-bottom: 1px solid rgb(var(--gray-light));
		transition: background 0.15s ease;
	}
	.search-result-item:first-child {
		border-radius: 12px 12px 0 0;
	}
	.search-result-item:last-child {
		border-radius: 0 0 12px 12px;
		border-bottom: none;
	}
	.search-result-item:only-child {
		border-radius: 12px;
	}
	.search-result-item:hover,
	.search-result-item.active {
		background: rgb(var(--gray-light));
	}
	.search-result-title {
		font-size: 0.9em;
		font-weight: 600;
		color: rgb(var(--black));
		margin-bottom: 0.15em;
		line-height: 1.3;
	}
	.search-result-title mark {
		background: rgba(var(--accent-rgb), 0.2);
		color: var(--accent);
		border-radius: 2px;
		padding: 0 0.1em;
	}
	.search-result-desc {
		font-size: 0.78em;
		color: rgb(var(--gray));
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Internal links */
	.internal-links {
		display: flex;
		gap: 0;
	}

	/* Search button */
	.search-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 0.4em 0.6em;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		display: flex;
		align-items: center;
		transition: all 0.2s ease;
		flex-shrink: 0;
	}
	.search-btn:hover {
		background: rgb(var(--gray-light));
		color: var(--accent);
	}

	/* Theme switcher */
	.theme-switcher {
		position: relative;
		flex-shrink: 0;
	}
	.theme-switcher::after {
		content: '';
		position: absolute;
		inset: 100% 0 auto 0;
		height: 10px;
	}
	.theme-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 0.4em 0.6em;
		cursor: pointer;
		color: rgb(var(--gray-dark));
		display: flex;
		align-items: center;
		transition: all 0.2s ease;
	}
	.theme-btn:hover {
		background: rgb(var(--gray-light));
		color: var(--accent);
	}
	.theme-dropdown {
		position: absolute;
		top: 100%;
		right: 0;
		margin-top: 1px;
		background: var(--card-bg);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 0.4em;
		display: none;
		flex-direction: column;
		gap: 0.15em;
		min-width: 140px;
		box-shadow: 0 4px 20px rgba(0,0,0,0.12);
		z-index: 200;
	}
	.theme-switcher:hover .theme-dropdown,
	.theme-switcher:focus-within .theme-dropdown {
		display: flex;
	}
	.theme-option {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.55em 0.8em;
		border: none;
		border-radius: 6px;
		background: transparent;
		color: rgb(var(--gray-dark));
		font-size: 0.88em;
		cursor: pointer;
		white-space: nowrap;
		transition: background 0.15s ease;
		font-family: inherit;
	}
	.theme-option:hover {
		background: rgb(var(--gray-light));
	}
	.theme-option.active {
		background: rgb(var(--gray-light));
		color: var(--accent);
		font-weight: 600;
	}

	@media (max-width: 580px) {
		.nav-inner {
			flex-wrap: wrap;
			padding: 0.5em 0.8em;
			border-radius: 0;
			gap: 0.3em 0.5em;
		}
		.internal-links {
			order: 3;
			width: 100%;
			justify-content: center;
		}
		h2 { font-size: 0.9em; }
		nav a { padding: 0.5em 0.4em; font-size: 0.88em; }
		.search-btn,
		.theme-btn { padding: 0.3em 0.45em; }
		.search-btn svg,
		.theme-btn svg { width: 17px; height: 17px; }
		.search-area.open .search-input { width: 120px; }
	}

	@media (max-width: 380px) {
		.nav-inner { padding: 0.4em 0.5em; }
		h2 { font-size: 0.8em; }
		nav a { padding: 0.4em 0.25em; font-size: 0.8em; }
		.nav-right { gap: 0.2em; }
		.search-area.open .search-input { width: 100px; }
	}
</style>

<script is:inline>
	function applyTheme(choice) {
		const preferDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		const resolved = choice === 'dark' || choice === 'light' ? choice : (preferDark ? 'dark' : 'light');
		document.documentElement.setAttribute('data-theme', resolved);
		document.documentElement.setAttribute('data-theme-choice', choice);
		localStorage.setItem('theme', choice);
		updateActiveOption(choice);
	}

	function updateActiveOption(choice) {
		document.querySelectorAll('.theme-option').forEach(btn => {
			btn.classList.toggle('active', btn.dataset.theme === choice);
		});
	}

	// Init on page load
	const saved = localStorage.getItem('theme') || 'system';
	applyTheme(saved);

	// Click handlers
	document.querySelectorAll('.theme-option').forEach(btn => {
		btn.addEventListener('click', () => {
			applyTheme(btn.dataset.theme);
		});
	});

	// Listen for system theme changes when in "system" mode
	window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
		const current = localStorage.getItem('theme') || 'system';
		if (current === 'system') {
			applyTheme('system');
		}
	});

	// ========== Search ==========
	(function() {
		const area = document.getElementById('searchArea');
		const input = document.getElementById('searchInput');
		const results = document.getElementById('searchResults');
		const btn = document.getElementById('searchBtn');
		let index = null;
		let activeIdx = -1;

		function open() {
			area.classList.add('open');
			setTimeout(() => input.focus(), 50);
		}

		function close() {
			area.classList.remove('open');
			area.classList.remove('has-results');
			input.value = '';
			results.innerHTML = '';
			activeIdx = -1;
		}

		btn.addEventListener('click', () => {
			if (area.classList.contains('open')) {
				if (input.value) {
					input.value = '';
					results.innerHTML = '';
					area.classList.remove('has-results');
					activeIdx = -1;
				} else {
					close();
				}
			} else {
				open();
			}
		});

		// Close on outside click
		document.addEventListener('click', (e) => {
			if (!area.contains(e.target) && !btn.contains(e.target)) {
				close();
			}
		});

		// Keyboard
		document.addEventListener('keydown', (e) => {
			if (!area.classList.contains('open')) return;

			const items = results.querySelectorAll('.search-result-item');

			if (e.key === 'Escape') {
				close();
				btn.focus();
			} else if (e.key === 'ArrowDown') {
				e.preventDefault();
				if (items.length > 0) {
					activeIdx = Math.min(activeIdx + 1, items.length - 1);
					items.forEach((item, i) => item.classList.toggle('active', i === activeIdx));
					items[activeIdx]?.scrollIntoView({ block: 'nearest' });
				}
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				if (items.length > 0) {
					activeIdx = Math.max(activeIdx - 1, 0);
					items.forEach((item, i) => item.classList.toggle('active', i === activeIdx));
					items[activeIdx]?.scrollIntoView({ block: 'nearest' });
				}
			} else if (e.key === 'Enter' && activeIdx >= 0) {
				e.preventDefault();
				items[activeIdx]?.click();
			}
		});

		let debounceTimer;
		input.addEventListener('input', () => {
			clearTimeout(debounceTimer);
			debounceTimer = setTimeout(doSearch, 150);
		});

		async function loadIndex() {
			if (index) return index;
			try {
				const resp = await fetch((document.querySelector('header').dataset.baseUrl || '') + 'search-index.json');
				index = await resp.json();
				return index;
			} catch (err) {
				console.error('Failed to load search index:', err);
				return [];
			}
		}

		async function doSearch() {
			const query = input.value.trim().toLowerCase();
			if (!query) {
				results.innerHTML = '';
				area.classList.remove('has-results');
				activeIdx = -1;
				return;
			}

			const posts = await loadIndex();
			const filtered = posts.filter((post) => {
				const t = post.title.toLowerCase();
				const d = post.description.toLowerCase();
				return t.includes(query) || d.includes(query) || (post.tags || []).join(' ').toLowerCase().includes(query);
			});

			if (filtered.length === 0) {
				results.innerHTML = '<div class="search-empty">未找到相关文章</div>';
				area.classList.add('has-results');
				activeIdx = -1;
				return;
			}

			const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
			const highlight = (text, q) => {
				const idx = text.toLowerCase().indexOf(q);
				if (idx === -1) return esc(text);
				const before = text.slice(0, idx);
				const match = text.slice(idx, idx + q.length);
				const after = text.slice(idx + q.length);
				return `${esc(before)}<mark>${esc(match)}</mark>${esc(after)}`;
			};

			results.innerHTML = filtered
				.map(
					(post, i) =>
						`<a href="${post.url}" class="search-result-item" data-idx="${i}">
							<div class="search-result-title">${highlight(post.title, query)}</div>
							<div class="search-result-desc">${highlight(post.description, query)}</div>
						</a>`
				)
				.join('');
			area.classList.add('has-results');
			activeIdx = -1;
		}
	})();
</script>
