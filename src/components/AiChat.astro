<!--
	Floating AI chat widget. Renders a bubble button (bottom-right) and a
	slide-up dialog.  All logic is inline IIFE — no framework needed.
-->
<div id="aiChatRoot">
	<!-- Floating trigger button -->
	<button id="aiChatBtn" class="ai-chat-btn" aria-label="AI 聊天">
		<svg id="aiChatIcon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
			<path fill="currentColor" d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/>
			<circle fill="currentColor" cx="8" cy="10" r="1.5"/>
			<circle fill="currentColor" cx="12" cy="10" r="1.5"/>
			<circle fill="currentColor" cx="16" cy="10" r="1.5"/>
		</svg>
		<svg id="aiChatCloseIcon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" style="display:none;">
			<path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
		</svg>
	</button>

	<!-- Chat dialog -->
	<div id="aiChatDialog" class="ai-chat-dialog" aria-hidden="true">
		<div class="ai-chat-header">
			<div class="ai-chat-avatar">🤖</div>
			<div class="ai-chat-header-text">
				<span class="ai-chat-title">Kaito AI</span>
				<span class="ai-chat-subtitle">在线 · 随时可聊</span>
			</div>
			<button id="aiChatClose" class="ai-chat-close" aria-label="关闭对话">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
				</svg>
			</button>
		</div>
		<div id="aiChatMessages" class="ai-chat-messages">
			<div class="ai-msg ai-bot">
				<div class="ai-chat-bubble">👋 你好！我是 Kaito 的 AI 分身，有什么想聊的？</div>
			</div>
		</div>
		<div class="ai-chat-input-area">
			<textarea
				id="aiChatInput"
				class="ai-chat-input"
				placeholder="输入消息..."
				rows="1"
				maxlength="2000"
				autocomplete="off"
			></textarea>
			<button id="aiChatSend" class="ai-chat-send" aria-label="发送">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path fill="currentColor" d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
				</svg>
			</button>
		</div>
	</div>
</div>

<style>
	/* ----- Trigger button (Siri-like pulse) ----- */
	.ai-chat-btn {
		position: fixed;
		bottom: 5.5em;
		right: 2em;
		z-index: 60;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: none;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: visible;
		animation: ai-btn-breathe 3s ease-in-out infinite;
	}
	.ai-chat-btn:hover {
		animation: none;
		transform: scale(1.12);
	}
	.ai-chat-btn.dragging {
		animation: none;
		cursor: grabbing;
		transition: none !important;
	}
	.ai-chat-btn.dragging:hover {
		transform: none;
	}

	/* Breathing scale + hue shift on the orb itself */
	@keyframes ai-btn-breathe {
		0%, 100% { transform: scale(1);   box-shadow: 0 0 18px rgba(99, 102, 241, 0.3), 0 0 40px rgba(139, 92, 246, 0.12); }
		33%       { transform: scale(1.06); box-shadow: 0 0 24px rgba(99, 102, 241, 0.45), 0 0 56px rgba(139, 92, 246, 0.2); }
		66%       { transform: scale(0.96); box-shadow: 0 0 14px rgba(99, 102, 241, 0.25), 0 0 32px rgba(139, 92, 246, 0.08); }
	}

	/* Expanding ring 1 — slow, wide */
	.ai-chat-btn::before {
		content: '';
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		border: 2px solid rgba(99, 102, 241, 0.35);
		animation: ai-ring-1 2.8s ease-out infinite;
		pointer-events: none;
	}
	@keyframes ai-ring-1 {
		0%   { transform: scale(0.85); opacity: 0.8; }
		100% { transform: scale(1.55); opacity: 0; }
	}

	/* Expanding ring 2 — slightly faster, offset delay */
	.ai-chat-btn::after {
		content: '';
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		border: 1.5px solid rgba(139, 92, 246, 0.4);
		animation: ai-ring-2 2.4s ease-out 0.9s infinite;
		pointer-events: none;
	}
	@keyframes ai-ring-2 {
		0%   { transform: scale(0.85); opacity: 0.7; }
		100% { transform: scale(1.6); opacity: 0; }
	}

	/* ----- Dialog shell ----- */
	.ai-chat-dialog {
		position: fixed;
		bottom: 5.5em;
		right: 2em;
		z-index: 59;
		width: 380px;
		max-width: calc(100vw - 2em);
		height: 500px;
		max-height: calc(100dvh - 8em);
		background: var(--card-bg);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 16px;
		box-shadow: 0 8px 40px rgba(0, 0, 0, 0.14);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		opacity: 0;
		transform: translateY(12px) scale(0.96);
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.ai-chat-dialog.open {
		opacity: 1;
		transform: translateY(0) scale(1);
		pointer-events: auto;
	}

	/* ----- Header ----- */
	.ai-chat-header {
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.85em 1em;
		border-bottom: 1px solid rgb(var(--gray-light));
		flex-shrink: 0;
	}
	.ai-chat-avatar {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1em;
		flex-shrink: 0;
	}
	.ai-chat-header-text {
		display: flex;
		flex-direction: column;
		gap: 0.05em;
	}
	.ai-chat-title {
		font-size: 0.95em;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.ai-chat-subtitle {
		font-size: 0.7em;
		color: rgb(var(--gray));
	}
	.ai-chat-close {
		margin-left: auto;
		background: none;
		border: none;
		color: rgb(var(--gray));
		cursor: pointer;
		padding: 0.2em;
		border-radius: 6px;
		display: flex;
		align-items: center;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.ai-chat-close:hover {
		background: rgb(var(--gray-light));
		color: rgb(var(--black));
	}

	/* ----- Messages ----- */
	.ai-chat-messages {
		flex: 1;
		overflow-y: auto;
		padding: 1em;
		display: flex;
		flex-direction: column;
		gap: 0.6em;
		scroll-behavior: smooth;
	}

	/* Message row — bubbles only, no avatar/label in body */
	.ai-msg {
		display: flex;
		max-width: 85%;
		animation: ai-msg-in 0.3s ease-out;
	}
	.ai-msg.ai-bot  { align-self: flex-start; }
	.ai-msg.ai-user { align-self: flex-end; }
	.ai-msg.ai-error { align-self: center; max-width: 95%; }

	@keyframes ai-msg-in {
		from { opacity: 0; transform: translateY(8px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	/* Bubble — distinguishes user from AI by color + alignment */
	.ai-chat-bubble {
		padding: 0.65em 0.9em;
		border-radius: 16px;
		font-size: 0.88em;
		line-height: 1.55;
		word-break: break-word;
	}
	.ai-bot .ai-chat-bubble {
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		border-bottom-left-radius: 4px;
	}
	.ai-user .ai-chat-bubble {
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: #fff;
		border-bottom-right-radius: 4px;
		box-shadow: 0 2px 8px rgba(99, 102, 241, 0.22);
	}
	.ai-error .ai-chat-bubble {
		background: rgba(220, 53, 69, 0.07);
		color: #dc3545;
		font-size: 0.8em;
		text-align: center;
		border-radius: 10px;
	}

	/* ----- Typing indicator ----- */
	.ai-msg.ai-typing .ai-chat-bubble {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	.ai-msg.ai-typing .ai-chat-bubble span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: rgb(var(--gray));
		animation: ai-bounce 1.2s ease-in-out infinite;
	}
	.ai-msg.ai-typing .ai-chat-bubble span:nth-child(2) { animation-delay: 0.15s; }
	.ai-msg.ai-typing .ai-chat-bubble span:nth-child(3) { animation-delay: 0.3s; }
	@keyframes ai-bounce {
		0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
		30% { transform: translateY(-6px); opacity: 1; }
	}

	/* ----- Markdown inside bot bubbles ----- */
	.ai-bot .ai-chat-bubble h1,
	.ai-bot .ai-chat-bubble h2,
	.ai-bot .ai-chat-bubble h3,
	.ai-bot .ai-chat-bubble h4 {
		margin: 0.6em 0 0.3em 0;
		line-height: 1.3;
		color: inherit;
	}
	.ai-bot .ai-chat-bubble h1 { font-size: 1.3em; }
	.ai-bot .ai-chat-bubble h2 { font-size: 1.15em; }
	.ai-bot .ai-chat-bubble h3 { font-size: 1.05em; }

	.ai-bot .ai-chat-bubble p {
		margin: 0.4em 0;
	}
	.ai-bot .ai-chat-bubble p:first-child { margin-top: 0; }
	.ai-bot .ai-chat-bubble p:last-child { margin-bottom: 0; }

	.ai-bot .ai-chat-bubble code {
		padding: 0.12em 0.35em;
		font-size: 0.86em;
		background: rgba(var(--accent-rgb), 0.12);
		border-radius: 3px;
		font-family: 'Courier New', Courier, monospace;
	}

	.ai-bot .ai-chat-bubble pre {
		margin: 0.5em 0;
		padding: 0.7em 0.9em;
		background: rgba(var(--black), 0.06);
		border-radius: 8px;
		overflow-x: auto;
		font-size: 0.8em;
		line-height: 1.5;
	}
	[data-theme='dark'] .ai-bot .ai-chat-bubble pre {
		background: rgba(255, 255, 255, 0.06);
	}
	.ai-bot .ai-chat-bubble pre code {
		padding: 0;
		background: none;
		font-size: inherit;
	}

	.ai-bot .ai-chat-bubble ul,
	.ai-bot .ai-chat-bubble ol {
		margin: 0.3em 0;
		padding-left: 1.3em;
	}
	.ai-bot .ai-chat-bubble li {
		margin: 0.15em 0;
	}

	.ai-bot .ai-chat-bubble blockquote {
		margin: 0.4em 0;
		padding: 0.2em 0 0.2em 0.7em;
		border-left: 3px solid var(--accent);
		font-size: 0.9em;
		opacity: 0.85;
	}

	.ai-bot .ai-chat-bubble a {
		color: var(--accent);
		text-decoration: underline;
		word-break: break-all;
	}

	.ai-bot .ai-chat-bubble table {
		width: 100%;
		margin: 0.4em 0;
		border-collapse: collapse;
		font-size: 0.82em;
	}
	.ai-bot .ai-chat-bubble th,
	.ai-bot .ai-chat-bubble td {
		padding: 0.3em 0.5em;
		border: 1px solid rgb(var(--gray-light));
		text-align: left;
	}
	.ai-bot .ai-chat-bubble th {
		background: rgba(var(--accent-rgb), 0.08);
		font-weight: 600;
	}

	.ai-bot .ai-chat-bubble hr {
		border: none;
		border-top: 1px solid rgb(var(--gray-light));
		margin: 0.6em 0;
	}

	.ai-bot .ai-chat-bubble input[type='checkbox'] {
		margin-right: 0.3em;
	}

	.ai-bot .ai-chat-bubble strong { font-weight: 700; }
	.ai-bot .ai-chat-bubble em { font-style: italic; }

	/* ----- Input ----- */
	.ai-chat-input-area {
		display: flex;
		align-items: flex-end;
		gap: 0.5em;
		padding: 0.7em 1em;
		border-top: 1px solid rgb(var(--gray-light));
		flex-shrink: 0;
	}
	.ai-chat-input {
		flex: 1;
		resize: none;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 0.55em 0.75em;
		font-family: inherit;
		font-size: 0.88em;
		background: rgb(var(--gray-light));
		color: rgb(var(--black));
		outline: none;
		max-height: 100px;
		line-height: 1.45;
		transition: border-color 0.15s ease;
	}
	.ai-chat-input:focus {
		border-color: var(--accent);
	}
	.ai-chat-input::placeholder {
		color: rgb(var(--gray));
	}
	.ai-chat-send {
		flex-shrink: 0;
		width: 38px;
		height: 38px;
		border-radius: 10px;
		border: none;
		background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
		color: #fff;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.15s ease, transform 0.15s ease;
		box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
	}
	.ai-chat-send:hover  { opacity: 0.85; }
	.ai-chat-send:active { transform: scale(0.95); }
	.ai-chat-send:disabled { opacity: 0.4; cursor: not-allowed; }

	/* ----- Mobile ----- */
	@media (max-width: 500px) {
		.ai-chat-dialog {
			right: 0.5em;
			left: 0.5em;
			bottom: 5em;
			width: auto;
			max-width: none;
			height: auto;
			max-height: 55dvh;
			border-radius: 16px 16px 0 0;
		}
		.ai-chat-btn {
			right: 1em;
			bottom: 4.8em;
		}
	}
</style>

<script is:inline>
	(function () {
		var btn = document.getElementById('aiChatBtn');
		var dialog = document.getElementById('aiChatDialog');
		if (!btn || !dialog) return;

		var _chatBooted = false;

		btn.addEventListener('click', function boot(e) {
			if (_chatBooted) return;
			_chatBooted = true;
			e.stopPropagation();
			e.preventDefault();

			// Dynamically load marked CDN
			var s = document.createElement('script');
			s.src = 'https://cdn.jsdelivr.net/npm/marked@15.0.4/marked.min.js';
			s.onload = function () {
				initAiChat();
				// Re-trigger click to open dialog
				setTimeout(function () { btn.click(); }, 150);
			};
			s.onerror = function () {
				// marked failed, still boot (uses escapeHtml fallback)
				initAiChat();
				setTimeout(function () { btn.click(); }, 150);
			};
			document.head.appendChild(s);
		}, { once: true });

		function initAiChat() {
		// Markdown rendering utilities

		function escapeHtml(text) {
			return String(text)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}

		function sanitizeMarkdownSource(text) {
			if (!text) return '';
			var blocks = [];
			text = text.replace(/```[\s\S]*?```/g, function (m) {
				blocks.push(m);
				return '\x00CB' + (blocks.length - 1) + '\x00';
			});
			var inlines = [];
			text = text.replace(/`[^`]+`/g, function (m) {
				inlines.push(m);
				return '\x00IC' + (inlines.length - 1) + '\x00';
			});
			text = text.replace(/</g, '&lt;').replace(/>/g, '&gt;');
			text = text.replace(/\x00CB(\d+)\x00/g, function (_, i) { return blocks[+i]; });
			text = text.replace(/\x00IC(\d+)\x00/g, function (_, i) { return inlines[+i]; });
			return text;
		}

		if (typeof marked !== 'undefined') {
			marked.use({
				extensions: [{
					name: 'safe-link',
					renderer: {
						link: function (token) {
							var href = token.href || '';
							if (/^(https?:|mailto:|\/|#)/i.test(href)) return false;
							return token.text || href;
						}
					}
				}]
			});
		}

		function renderMarkdown(text) {
			if (!text) return '';
			if (typeof marked === 'undefined') return escapeHtml(text).replace(/\n/g, '<br>');
			try {
				return marked.parse(sanitizeMarkdownSource(text), { breaks: true, gfm: true });
			} catch (e) {
				return escapeHtml(text).replace(/\n/g, '<br>');
			}
		}

		var btn = document.getElementById('aiChatBtn');
		var dialog = document.getElementById('aiChatDialog');
		var close = document.getElementById('aiChatClose');
		var messagesEl = document.getElementById('aiChatMessages');
		var input = document.getElementById('aiChatInput');
		var sendBtn = document.getElementById('aiChatSend');
		var chatIcon = document.getElementById('aiChatIcon');
		var closeIcon = document.getElementById('aiChatCloseIcon');

		if (!btn || !dialog) return;

		// Astro scoped styles require data-astro-cid-HASH on every element.
		// Static HTML has it, but JS-created elements don't — find the actual
		// attribute name (hash varies per build) and apply it.
		var CID = '';
		(function () {
			var root = document.getElementById('aiChatRoot');
			if (!root) return;
			for (var i = 0; i < root.attributes.length; i++) {
				if (root.attributes[i].name.indexOf('data-astro-cid') === 0) { CID = root.attributes[i].name; break; }
			}
		})();
		function cid(el) { if (CID) el.setAttribute(CID, ''); return el; }

		var isOpen = false;
		var isSending = false;
		var apiBase = '';

		function getApiUrl(path) {
			if (!apiBase) {
				var header = document.querySelector('header');
				var base = (header && header.dataset.baseUrl) || '/';
				apiBase = base.replace(/\/?$/, '');
			}
			return apiBase + path;
		}

		function openDialog() {
			isOpen = true;
			dialog.classList.add('open');
			dialog.setAttribute('aria-hidden', 'false');
			chatIcon.style.display = 'none';
			closeIcon.style.display = '';
			btn.setAttribute('aria-label', '关闭 AI 聊天');
			positionDialog();
			setTimeout(function () { input.focus(); }, 200);
		}

		function closeDialog() {
			isOpen = false;
			dialog.classList.remove('open');
			dialog.setAttribute('aria-hidden', 'true');
			chatIcon.style.display = '';
			closeIcon.style.display = 'none';
			btn.setAttribute('aria-label', 'AI 聊天');
		}

		btn.addEventListener('click', function () {
			if (isOpen) { closeDialog(); } else { openDialog(); }
		});
		close.addEventListener('click', closeDialog);

		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && isOpen) {
				if (document.activeElement === input && input.value.trim()) {
					input.value = '';
					return;
				}
				closeDialog();
				btn.focus();
			}
		});

		function scrollToBottom() {
			messagesEl.scrollTop = messagesEl.scrollHeight;
		}

		// Pure-bubble message — avatar/label only in header, not per-message
		function addMsg(text, type) {
			var row = cid(document.createElement('div'));
			row.className = 'ai-msg ai-' + type;
			var bubble = cid(document.createElement('div'));
			bubble.className = 'ai-chat-bubble';
			if (type === 'bot') {
				bubble.innerHTML = renderMarkdown(text);
			} else {
				bubble.textContent = text;
			}
			row.appendChild(bubble);
			messagesEl.appendChild(row);
			scrollToBottom();
			return row;
		}

		function addTyping() {
			var row = cid(document.createElement('div'));
			row.className = 'ai-msg ai-bot ai-typing';
			row.id = 'aiTyping';
			var bubble = cid(document.createElement('div'));
			bubble.className = 'ai-chat-bubble';
			for (var i = 0; i < 3; i++) { bubble.appendChild(cid(document.createElement('span'))); }
			row.appendChild(bubble);
			messagesEl.appendChild(row);
			scrollToBottom();
			return row;
		}

		function removeTyping() {
			var el = document.getElementById('aiTyping');
			if (el) el.remove();
		}

		function setSending(state) {
			isSending = state;
			sendBtn.disabled = state;
			input.disabled = state;
		}

		async function sendMessage() {
			var text = input.value.trim();
			if (!text || isSending) return;
			if (text.length > 2000) { text = text.substring(0, 2000); }
			input.value = '';
			input.style.height = 'auto';

			addMsg(text, 'user');
			setSending(true);
			addTyping();

			try {
				var resp = await fetch(getApiUrl('/api/chat'), {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						messages: [{ role: 'user', content: text }],
					}),
				});

				removeTyping();

				if (!resp.ok) {
					var errText;
					if (resp.status === 404) {
						errText = 'AI 服务未配置（服务器端需部署 API Bridge）';
					} else if (resp.status === 429) {
						errText = '请求太频繁了，请稍后再试 🌊';
					} else {
						errText = '请求失败（HTTP ' + resp.status + '）';
					}
					addMsg(errText, 'error');
				} else {
					var data = await resp.json();
					if (data.error) {
						addMsg(data.error, 'error');
					} else {
						addMsg(data.reply || '（AI 没有返回内容）', 'bot');
					}
				}
			} catch (err) {
				removeTyping();
				addMsg('无法连接到 AI 服务，请稍后重试', 'error');
			}

			setSending(false);
			input.focus();
		}

		sendBtn.addEventListener('click', sendMessage);

		// Enter = send; Shift+Enter or Ctrl+Enter = newline
		input.addEventListener('keydown', function (e) {
			if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey) {
				e.preventDefault();
				sendMessage();
			}
		});

		input.addEventListener('input', function () {
			input.style.height = 'auto';
			input.style.height = Math.min(input.scrollHeight, 100) + 'px';
		});
		// ===== Drag to reposition =====
		var DRAG_KEY = 'kaitohub_ai_chat_pos';
		var isDragging = false;
		var dragStartX = 0, dragStartY = 0;
		var btnStartRight = 0, btnStartBottom = 0;
		var dragMoved = false;
		var DRAG_THRESHOLD = 5;

		function getBtnPos() {
			var r = parseFloat(btn.style.right) || 2 * 16;
			var b = parseFloat(btn.style.bottom) || 5.5 * 16;
			return { right: r, bottom: b };
		}

		function clampPos(right, bottom) {
			var maxRight = window.innerWidth - 56;
			var maxBottom = window.innerHeight - 56;
			return {
				right: Math.max(8, Math.min(right, maxRight)),
				bottom: Math.max(8, Math.min(bottom, maxBottom))
			};
		}

		function applyPos(pos) {
			btn.style.right = pos.right + 'px';
			btn.style.bottom = pos.bottom + 'px';
			positionDialog();
		}

		// Position dialog intelligently: clamp horizontal, flip vertical as needed
		function positionDialog() {
			var pos = getBtnPos();
			var vh = window.innerHeight;
			var vw = window.innerWidth;
			var btnTop = vh - pos.bottom - 48; // 48 = button height
			var spaceAbove = btnTop - 16; // leave margin
			var isMobile = vw <= 500;
			var maxHeightCap = isMobile ? Math.round(vh * 0.55) : 500;

			// Horizontal: clamp dialog right so it stays within viewport
			var dialogWidth = isMobile ? Math.min(380, vw - 16) : 380;
			var maxRight = vw - dialogWidth - 8;
			var dialogRight = Math.max(8, Math.min(pos.right, maxRight));
			dialog.style.right = dialogRight + 'px';

			if (spaceAbove >= (isMobile ? 260 : 320)) {
				// Open above button
				dialog.style.bottom = (pos.bottom + 56) + 'px';
				dialog.style.top = 'auto';
				dialog.style.maxHeight = Math.min(maxHeightCap, spaceAbove) + 'px';
			} else {
				// Open below button
				var spaceBelow = vh - btnTop - 48 - 16;
				dialog.style.bottom = 'auto';
				dialog.style.top = (btnTop + 48 + 8) + 'px';
				dialog.style.maxHeight = Math.min(maxHeightCap, Math.max(200, spaceBelow)) + 'px';
			}
		}

		function savePos(pos) {
			try { localStorage.setItem(DRAG_KEY, JSON.stringify(pos)); } catch (e) {}
		}

		// Load saved position
		(function () {
			try {
				var saved = localStorage.getItem(DRAG_KEY);
				if (saved) {
					var pos = JSON.parse(saved);
					if (typeof pos.right === 'number' && typeof pos.bottom === 'number') {
						applyPos(clampPos(pos.right, pos.bottom));
					}
				}
			} catch (e) {}

		}
	})();
</script>
