---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

type Props = CollectionEntry<'blog'>['data'] & {
	prevPost?: CollectionEntry<'blog'> | null;
	nextPost?: CollectionEntry<'blog'> | null;
	headings?: { text: string; level: number; id: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, prevPost, nextPost, headings = [] } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-height: 240px;
				overflow: hidden;
				margin-bottom: 0;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				width: 100%;
				max-width: 720px;
				height: auto;
				object-fit: cover;
				max-height: 240px;
			}
			.article-wrapper {
				width: 100%;
				max-width: 1140px;
				margin: 0 auto;
				padding: 0 2em;
				position: relative;
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				padding: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			/* Progress bar */
			.progress-bar {
				position: sticky;
				top: 0;
				z-index: 99;
				width: 100%;
				height: 3px;
				background: transparent;
			}
			.progress-bar::after {
				content: '';
				display: block;
				height: 100%;
				width: var(--progress, 0%);
				background: linear-gradient(90deg, var(--accent), rgba(var(--accent-rgb), 0.6));
				transition: width 0.1s linear;
			}

			/* Tags */
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				justify-content: center;
				margin-top: 0.8em;
			}
			.tag {
				display: inline-block;
				padding: 0.25em 0.7em;
				font-size: 0.78em;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.08);
				border: 1px solid rgba(var(--accent-rgb), 0.15);
				border-radius: 999px;
				text-decoration: none;
				transition: background 0.2s ease;
			}
			.tag:hover {
				background: rgba(var(--accent-rgb), 0.16);
			}

			/* Share buttons */
			.share-section {
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
				display: flex;
				align-items: center;
				gap: 0.6em;
				flex-wrap: wrap;
			}
			.share-label {
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.share-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 2em;
				height: 2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--card-bg);
				color: rgb(var(--gray));
				cursor: pointer;
				transition: all 0.2s ease;
				text-decoration: none;
			}
			.share-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.04);
			}
			.share-btn.copied {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* Comments */
			.comments-section {
				margin-top: 2em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.comment-form {
				display: flex;
				flex-direction: column;
				gap: 0.6em;
				margin-bottom: 1.5em;
			}
			.comment-form input,
			.comment-form textarea {
				padding: 0.6em 0.85em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				font-family: inherit;
				font-size: 0.88em;
				background: rgb(var(--gray-light));
				color: rgb(var(--black));
				outline: none;
				transition: border-color 0.15s ease;
				resize: vertical;
			}
			.comment-form input:focus,
			.comment-form textarea:focus {
				border-color: var(--accent);
			}
			.comment-form textarea {
				min-height: 80px;
			}
			.comment-form input::placeholder,
			.comment-form textarea::placeholder {
				color: rgb(var(--gray));
			}
			.comment-submit {
				align-self: flex-end;
				padding: 0.5em 1.2em;
				border: none;
				border-radius: 10px;
				background: var(--accent);
				color: #fff;
				font-family: inherit;
				font-size: 0.88em;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.15s ease;
			}
			.comment-submit:hover {
				opacity: 0.85;
			}
			.comment-submit:disabled {
				opacity: 0.4;
				cursor: not-allowed;
			}
			.comment-status {
				font-size: 0.82em;
				text-align: center;
				padding: 0.3em 0;
			}
			.comment-status.success { color: var(--accent); }
			.comment-status.error { color: #dc3545; }
			/* Comment list */
			.comment-list {
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.comment-item {
				display: flex;
				gap: 0.65em;
				animation: comment-in 0.25s ease-out;
			}
			@keyframes comment-in {
				from { opacity: 0; transform: translateY(8px); }
				to { opacity: 1; transform: translateY(0); }
			}
			.comment-avatar {
				flex-shrink: 0;
				width: 36px;
				height: 36px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.82em;
				font-weight: 700;
				color: #fff;
				background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
				user-select: none;
			}
			.comment-body {
				flex: 1;
				min-width: 0;
			}
			.comment-meta {
				display: flex;
				align-items: baseline;
				gap: 0.6em;
				margin-bottom: 0.35em;
			}
			.comment-author {
				font-size: 0.85em;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.comment-time {
				font-size: 0.75em;
				color: rgb(var(--gray));
			}
			.comment-content {
				padding: 0.55em 0.85em;
				border-radius: 4px 14px 14px 14px;
				font-size: 0.88em;
				line-height: 1.6;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				word-break: break-word;
			}
			.comment-empty {
				text-align: center;
				color: rgb(var(--gray));
				font-size: 0.88em;
				padding: 1.5em 0;
			}
			.comment-unavailable {
				text-align: center;
				color: rgb(var(--gray));
				font-size: 0.82em;
				padding: 1.5em 0;
			}

			/* Post navigation */
			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				margin-top: 2em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.post-nav-link {
				flex: 1;
				max-width: 48%;
				text-decoration: none;
				padding: 0.8em 1em;
				border-radius: 10px;
				border: 1px solid rgb(var(--gray-light));
				transition: border-color 0.2s ease, background 0.2s ease;
			}
			.post-nav-link:hover {
				border-color: var(--accent);
				background: rgba(var(--accent-rgb), 0.04);
			}
			.post-nav-link.empty {
				visibility: hidden;
			}
			.post-nav-link.next {
				text-align: right;
				margin-left: auto;
			}
			.post-nav-label {
				display: block;
				font-size: 0.78em;
				color: rgb(var(--gray));
				margin-bottom: 0.3em;
			}
			.post-nav-title {
				display: block;
				font-size: 0.95em;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.4;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* Table of Contents */
			.toc-sidebar {
				position: fixed;
				right: max(2em, calc((100vw - 1140px) / 2 - 220px));
				top: 6em;
				width: 220px;
				max-height: calc(100vh - 8em);
				overflow-y: auto;
				z-index: 50;
				padding-left: 1em;
				border-left: 2px solid rgb(var(--gray-light));
				display: none;
			}
			.toc-sidebar.has-toc {
				display: block;
			}
			.toc-sidebar .toc-title {
				font-size: 0.82em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.8em;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.toc-sidebar a {
				display: block;
				padding: 0.3em 0;
				font-size: 0.8em;
				color: rgb(var(--gray));
				text-decoration: none;
				line-height: 1.4;
				transition: color 0.15s ease;
				border-left: 2px solid transparent;
				margin-left: -1em;
				padding-left: 1em;
			}
			.toc-sidebar a:hover,
			.toc-sidebar a.active {
				color: var(--accent);
				border-left-color: var(--accent);
			}
			.toc-sidebar a.toc-h3 {
				padding-left: 1.8em;
			}
			.toc-sidebar a.toc-h4 {
				padding-left: 2.6em;
			}

			@media (max-width: 1300px) {
				.toc-sidebar {
					display: none !important;
				}
			}
			/* AI Q&A */
			.ai-qa-section {
				margin-top: 2em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.ai-qa-section h3 {
				font-size: 1.25em;
				margin-bottom: 0.6em;
			}
			.ai-qa-presets {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-bottom: 0.8em;
			}
			.ai-qa-preset {
				padding: 0.35em 0.75em;
				font-size: 0.82em;
				font-family: inherit;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: var(--card-bg);
				color: rgb(var(--gray-dark));
				cursor: pointer;
				transition: all 0.2s ease;
				white-space: nowrap;
			}
			.ai-qa-preset:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.06);
			}
			.ai-qa-input-row {
				display: flex;
				gap: 0.5em;
				align-items: center;
			}
			.ai-qa-input {
				flex: 1;
				padding: 0.55em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				font-family: inherit;
				font-size: 0.88em;
				background: rgb(var(--gray-light));
				color: rgb(var(--black));
				outline: none;
				transition: border-color 0.15s ease;
			}
			.ai-qa-input:focus {
				border-color: var(--accent);
			}
			.ai-qa-input::placeholder {
				color: rgb(var(--gray));
			}
			.ai-qa-send {
				flex-shrink: 0;
				padding: 0.55em 1.1em;
				border: none;
				border-radius: 10px;
				background: var(--accent);
				color: #fff;
				font-family: inherit;
				font-size: 0.88em;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.15s ease;
			}
			.ai-qa-send:hover {
				opacity: 0.85;
			}
			.ai-qa-send:disabled {
				opacity: 0.4;
				cursor: not-allowed;
			}
			/* AI Q&A conversation thread */
			.ai-qa-conversation {
				margin-top: 1em;
				display: flex;
				flex-direction: column;
				gap: 0.9em;
			}
			/* Each Q&A group */
			.ai-qa-group {
				animation: ai-qa-in 0.25s ease-out;
			}
			@keyframes ai-qa-in {
				from { opacity: 0; transform: translateY(8px); }
				to { opacity: 1; transform: translateY(0); }
			}
			/* Question bubble — right-aligned, accent background */
			.ai-qa-q {
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				margin-bottom: 0.5em;
			}
			.ai-qa-q .ai-qa-bubble {
				padding: 0.6em 0.85em;
				border-radius: 14px 14px 4px 14px;
				font-size: 0.88em;
				line-height: 1.55;
				max-width: 88%;
				background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
				color: #fff;
				box-shadow: 0 2px 8px rgba(99, 102, 241, 0.18);
			}
			/* Answer bubble — left-aligned, gray background */
			.ai-qa-a {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}
			.ai-qa-a .ai-qa-bubble {
				padding: 0.6em 0.85em;
				border-radius: 14px 14px 14px 4px;
				font-size: 0.88em;
				line-height: 1.65;
				max-width: 95%;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			/* Error in answer position */
			.ai-qa-a.ai-qa-error .ai-qa-bubble {
				background: rgba(220, 53, 69, 0.07);
				color: #dc3545;
				font-size: 0.82em;
			}
			/* Loading dots */
			.ai-qa-loading {
				display: flex;
				align-items: center;
				gap: 4px;
				padding: 0.5em 0.85em;
			}
			.ai-qa-loading span {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: rgb(var(--gray));
				animation: ai-qa-bounce 1.2s ease-in-out infinite;
			}
			.ai-qa-loading span:nth-child(2) { animation-delay: 0.15s; }
			.ai-qa-loading span:nth-child(3) { animation-delay: 0.3s; }
			@keyframes ai-qa-bounce {
				0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
				30% { transform: translateY(-6px); opacity: 1; }
			}

			@media (max-width: 600px) {
				.post-nav {
					flex-direction: column;
					gap: 0.6em;
				}
				.post-nav-link {
					max-width: 100%;
				}
				.post-nav-link.next {
					margin-left: 0;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="progress-bar" id="progressBar"></div>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={720} height={240} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="article-wrapper">
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							{
								tags && tags.length > 0 && (
									<div class="tags">
										{tags.map((tag) => (
											<a class="tag" href={`${base}blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>
										))}
									</div>
								)
							}
							<hr />
						</div>
						<slot />

						<!-- Share buttons -->
						<div class="share-section" id="shareSection">
							<span class="share-label">分享：</span>
							<button class="share-btn" id="shareCopy" title="复制链接" aria-label="复制链接">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
							</button>
							<a class="share-btn" id="shareTwitter" href="#" target="_blank" rel="noopener" title="分享到 X" aria-label="分享到 X">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
							</a>
							<a class="share-btn" id="shareWeibo" href="#" target="_blank" rel="noopener" title="分享到微博" aria-label="分享到微博">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M10.098 20.323c-3.977.391-7.414-1.406-7.672-4.02-.259-2.609 2.759-5.047 6.74-5.441 3.979-.394 7.413 1.404 7.671 4.018.259 2.6-2.759 5.049-6.739 5.443zm-2.098-3.186c-.67.11-1.34-.16-1.51-.62-.16-.46.22-.94.86-1.05.67-.11 1.34.16 1.51.62.16.46-.22.94-.86 1.05zm1.91-.12c-.29.05-.57-.07-.62-.27-.05-.2.08-.41.36-.46.29-.05.57.07.62.27.05.2-.08.41-.36.46zm3.27-.48c-2.04.34-3.24.62-3.69 1.04-.53.49-.3 1.32.56 1.83.85.5 2.04.56 3.22.33 1.18-.23 2.17-.76 2.4-1.32.23-.56-.21-.94-1.22-.87-.94.07-2.2.15-3.27-.23-.91-.33-.28-.73 0-.78zm4.86-2.35c-1.55-.48-3.39.3-4.09 1.73-.7 1.43-.04 2.98 1.45 3.46 1.5.49 3.39-.29 4.09-1.73.7-1.43-.01-2.98-1.45-3.46zm3.1-4.11c-.57-.82-1.37-1.19-2.2-1.12-.83.07-1.42.49-1.82 1.07-.4.58-.51 1.28-.33 1.95.18.67.62 1.22 1.24 1.57.61.35 1.41.5 2.12.4.71-.09 1.34-.45 1.75-1.02.41-.57.56-1.27.31-1.94-.25-.67-.71-1.11-1.07-.91z"/></svg>
							</a>
						</div>

						<!-- AI Q&A -->
						<div class="ai-qa-section" id="aiQaSection">
							<h3>向 AI 提问（基于本文内容）</h3>
							<div class="ai-qa-presets" id="aiQaPresets">
								<button class="ai-qa-preset" data-question="这篇文章的核心观点是什么？">📌 核心观点是什么？</button>
								<button class="ai-qa-preset" data-question="文中的技术方案有什么优缺点？">⚖️ 有什么优缺点？</button>
								<button class="ai-qa-preset" data-question="这篇文章适合什么水平的读者？适合什么人看？">🎯 适合什么人看？</button>
							</div>
							<div class="ai-qa-input-row">
								<input
									type="text"
									id="aiQaInput"
										maxlength="500"
									class="ai-qa-input"
									placeholder="输入你的问题..."
									autocomplete="off"
								/>
								<button id="aiQaSend" class="ai-qa-send">发送</button>
							</div>
							<div id="aiQaConversation" class="ai-qa-conversation"></div>
						</div>

						<!-- Comments -->
						<div class="comments-section" id="comments">
							<h3>评论</h3>
							<div class="comment-form" id="commentForm">
								<input type="text" id="commentAuthor" maxlength="50" placeholder="昵称（选填）" autocomplete="off" />
								<textarea id="commentContent" maxlength="2000" placeholder="写下你的想法..." rows="3"></textarea>
								<button class="comment-submit" id="commentSubmit">提交评论</button>
								<div class="comment-status" id="commentStatus"></div>
							</div>
							<div class="comment-list" id="commentList"></div>
						</div>

						{
							(prevPost || nextPost) && (
								<nav class="post-nav">
									{
										prevPost ? (
											<a class="post-nav-link prev" href={`${base}blog/${prevPost.id}/`}>
												<span class="post-nav-label">上一篇</span>
												<span class="post-nav-title">{prevPost.data.title}</span>
											</a>
										) : <span class="post-nav-link prev empty" />
									}
									{
										nextPost ? (
											<a class="post-nav-link next" href={`${base}blog/${nextPost.id}/`}>
												<span class="post-nav-label">下一篇</span>
												<span class="post-nav-title">{nextPost.data.title}</span>
											</a>
										) : <span class="post-nav-link next empty" />
									}
								</nav>
							)
						}
					</div>
				</div>
			</article>

			{
				headings.length > 0 && (
					<aside class="toc-sidebar has-toc" id="tocSidebar">
						<div class="toc-title">目录</div>
						<nav id="tocNav">
							{headings.map((h) => (
								<a href={`#${h.id}`} class={`toc-h${h.level}`}>{h.text}</a>
							))}
						</nav>
					</aside>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<script is:inline>
	(function () {
		// Progress bar
		var bar = document.getElementById('progressBar');
		var ticking = false;

		function updateProgress() {
			var article = document.querySelector('article');
			if (!article) return;
			var articleTop = article.offsetTop;
			var articleHeight = article.offsetHeight;
			var viewportHeight = window.innerHeight;
			var scrolled = window.scrollY - articleTop + viewportHeight;
			var progress = Math.min(100, Math.max(0, (scrolled / articleHeight) * 100));
			bar.style.setProperty('--progress', progress + '%');
		}

		window.addEventListener('scroll', function () {
			if (!ticking) {
				requestAnimationFrame(function () {
					updateProgress();
					updateActiveToc();
					ticking = false;
				});
				ticking = true;
			}
		});

		updateProgress();

		// TOC active tracking
		function updateActiveToc() {
			var tocLinks = document.querySelectorAll('#tocNav a');
			if (tocLinks.length === 0) return;

			var headings = [];
			tocLinks.forEach(function (link) {
				var id = link.getAttribute('href') ? link.getAttribute('href').slice(1) : '';
				if (id) {
					var el = document.getElementById(id);
					if (el) headings.push({ el: el, link: link });
				}
			});

			if (headings.length === 0) return;

			var active = headings[0].link;
			for (var i = 0; i < headings.length; i++) {
				if (headings[i].el.getBoundingClientRect().top <= 120) {
					active = headings[i].link;
				}
			}
			tocLinks.forEach(function (link) { link.classList.remove('active'); });
			active.classList.add('active');
		}

		// Share: copy link
		var shareCopy = document.getElementById('shareCopy');
		if (shareCopy) {
			shareCopy.addEventListener('click', function () {
				navigator.clipboard.writeText(window.location.href).then(function () {
					shareCopy.classList.add('copied');
					setTimeout(function () { shareCopy.classList.remove('copied'); }, 1500);
				});
			});
		}

		// Share: Twitter / Weibo
		var url = encodeURIComponent(window.location.href);
		var title = encodeURIComponent(document.title);
		var shareTwitter = document.getElementById('shareTwitter');
		var shareWeibo = document.getElementById('shareWeibo');
		if (shareTwitter) {
			shareTwitter.href = 'https://x.com/intent/tweet?url=' + url + '&text=' + title;
		}
		if (shareWeibo) {
			shareWeibo.href = 'https://service.weibo.com/share/share.php?url=' + url + '&title=' + title;
		}
	})();
</script>
<script is:inline>
	(function () {
		var section = document.getElementById('aiQaSection');
		var input = document.getElementById('aiQaInput');
		var sendBtn = document.getElementById('aiQaSend');
		var convEl = document.getElementById('aiQaConversation');
		var presetBtns = document.querySelectorAll('.ai-qa-preset');

		if (!section || !input || !sendBtn || !convEl) return;

		// Astro scoped styles require data-astro-cid-HASH on dynamic elements.
		// Find the actual attribute name (hash varies per build) and apply it.
		var CID = '';
		(function () {
			var el = section;
			if (!el) return;
			for (var i = 0; i < el.attributes.length; i++) {
				if (el.attributes[i].name.indexOf('data-astro-cid') === 0) { CID = el.attributes[i].name; break; }
			}
		})();
		function cid(el) { if (CID) el.setAttribute(CID, ''); return el; }

		var isSending = false;
		var apiBase = '';

		function getApiUrl(path) {
			if (!apiBase) {
				var header = document.querySelector('header');
				var base = (header && header.dataset.baseUrl) || '/';
				apiBase = base.replace(/\/?$/, '');
			}
			return apiBase + path;
		}

		function getArticleContent() {
			var prose = document.querySelector('.prose');
			if (!prose) return '';
			var text = prose.textContent || '';
			return text.trim().substring(0, 8000);
		}

		function getArticleTitle() {
			var h1 = document.querySelector('.title h1');
			return h1 ? h1.textContent.trim() : document.title;
		}

		// Create a Q&A group in the conversation: question bubble + loading/answer slot
		function addQaGroup(question) {
			var group = cid(document.createElement('div'));
			group.className = 'ai-qa-group';

			// Question bubble (right-aligned)
			var qDiv = cid(document.createElement('div'));
			qDiv.className = 'ai-qa-q';
			var qLabel = cid(document.createElement('span'));
			var qBubble = cid(document.createElement('div'));
			qBubble.className = 'ai-qa-bubble';
			qBubble.textContent = question;
			qDiv.appendChild(qBubble);
			group.appendChild(qDiv);

			// Answer slot (starts as loading)
			var aDiv = cid(document.createElement('div'));
			aDiv.className = 'ai-qa-a';
			group._answerSlot = aDiv;
			group.appendChild(aDiv);

			convEl.appendChild(group);
			convEl.scrollIntoView({ behavior: 'smooth', block: 'end' });
			return group;
		}

		function showLoading(group) {
			var slot = group._answerSlot;
			slot.className = 'ai-qa-a';
			slot.innerHTML = '';
			var bubble = cid(document.createElement('div'));
			bubble.className = 'ai-qa-bubble';
			var loading = cid(document.createElement('div'));
			loading.className = 'ai-qa-loading';
			for (var i = 0; i < 3; i++) { loading.appendChild(cid(document.createElement('span'))); }
			bubble.appendChild(loading);
			slot.appendChild(bubble);
		}

		function showAnswer(group, text) {
			var slot = group._answerSlot;
			slot.className = 'ai-qa-a';
			slot.innerHTML = '';
			var label = cid(document.createElement('span'));
			var bubble = cid(document.createElement('div'));
			bubble.className = 'ai-qa-bubble';
			bubble.textContent = text;
			slot.appendChild(bubble);
		}

		function showError(group, msg) {
			var slot = group._answerSlot;
			slot.className = 'ai-qa-a ai-qa-error';
			slot.innerHTML = '';
			var label = cid(document.createElement('span'));
			var bubble = cid(document.createElement('div'));
			bubble.className = 'ai-qa-bubble';
			bubble.textContent = msg;
			slot.appendChild(bubble);
		}

		function setSending(state) {
			isSending = state;
			sendBtn.disabled = state;
			input.disabled = state;
		}

		async function askQuestion(question) {
			if (isSending) return;
			var q = question || input.value.trim();
			if (!q) return;
		if (q.length > 500) { q = q.substring(0, 500); }

			if (!question) input.value = '';
			setSending(true);

			var group = addQaGroup(q);
			showLoading(group);

			try {
				var resp = await fetch(getApiUrl('/api/article-qa'), {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						question: q,
						articleTitle: getArticleTitle(),
						articleContent: getArticleContent(),
					}),
				});

				if (!resp.ok) {
					var msg;
					if (resp.status === 404) {
						msg = 'AI 服务未配置（服务器端需部署 API Bridge）';
					} else if (resp.status === 429) {
						msg = '请求太频繁了，请稍后再试 🌊';
					} else {
						msg = '请求失败（HTTP ' + resp.status + '）';
					}
					showError(group, msg);
				} else {
					var data = await resp.json();
					if (data.error) {
						showError(group, data.error);
					} else {
						showAnswer(group, data.reply || '（AI 没有返回内容）');
					}
				}
			} catch (err) {
				showError(group, '无法连接到 AI 服务，请稍后重试');
			}

			setSending(false);
		}

		// Send button
		sendBtn.addEventListener('click', function () { askQuestion(); });

		// Enter key
		input.addEventListener('keydown', function (e) {
			if (e.key === 'Enter') {
				e.preventDefault();
				askQuestion();
			}
		});

		// Preset question buttons
		presetBtns.forEach(function (btn) {
			btn.addEventListener('click', function () {
				var q = btn.getAttribute('data-question');
				if (q) {
					input.value = q;
					askQuestion(q);
				}
			});
		});
	})();
</script>


<script is:inline>
	(function () {
		var commentsSection = document.getElementById('comments');
		var commentForm = document.getElementById('commentForm');
		var commentList = document.getElementById('commentList');
		var authorInput = document.getElementById('commentAuthor');
		var contentInput = document.getElementById('commentContent');
		var submitBtn = document.getElementById('commentSubmit');
		var statusEl = document.getElementById('commentStatus');

		if (!commentsSection || !commentForm || !commentList) return;

		// Astro scoped styles: find cid attribute
		var CID = '';
		(function () {
			var el = commentsSection;
			if (!el) return;
			for (var i = 0; i < el.attributes.length; i++) {
				if (el.attributes[i].name.indexOf('data-astro-cid') === 0) { CID = el.attributes[i].name; break; }
			}
		})();
		function cid(el) { if (CID) el.setAttribute(CID, ''); return el; }

		var apiBase = '';
		function getApiUrl(path) {
			if (!apiBase) {
				var header = document.querySelector('header');
				var base = (header && header.dataset.baseUrl) || '/';
				apiBase = base.replace(/\/?$/, '');
			}
			return apiBase + path;
		}

		function getSlug() {
			var path = window.location.pathname;
			path = path.replace(/\/+$/, '');
			if (path === '') return 'home';
			var parts = path.split('/');
			return parts[parts.length - 1] || parts[parts.length - 2] || 'unknown';
		}

		var isSubmitting = false;

		function setStatus(msg, type) {
			if (!statusEl) return;
			statusEl.textContent = msg;
			statusEl.className = 'comment-status ' + (type || '');
			if (type === 'success') {
				setTimeout(function () { statusEl.textContent = ''; statusEl.className = 'comment-status'; }, 4000);
			}
		}

		function formatTime(dateStr) {
			try {
				var d = new Date(dateStr + 'Z');
				if (isNaN(d.getTime())) { d = new Date(dateStr); }
				if (isNaN(d.getTime())) return dateStr;
				var now = new Date();
				var diff = now - d;
				if (diff < 60000) return '刚刚';
				if (diff < 3600000) return Math.floor(diff / 60000) + ' 分钟前';
				if (diff < 86400000) return Math.floor(diff / 3600000) + ' 小时前';
				if (diff < 604800000) return Math.floor(diff / 86400000) + ' 天前';
				return d.getFullYear() + '-' +
					String(d.getMonth() + 1).padStart(2, '0') + '-' +
					String(d.getDate()).padStart(2, '0') + ' ' +
					String(d.getHours()).padStart(2, '0') + ':' +
					String(d.getMinutes()).padStart(2, '0');
			} catch (e) { return dateStr; }
		}

		function avatarChar(name) {
			if (!name || !name.trim()) return '匿';
			var ch = name.trim().charAt(0);
			return ch;
		}

		function renderComment(c) {
			var item = cid(document.createElement('div'));
			item.className = 'comment-item';

			var avatar = cid(document.createElement('div'));
			avatar.className = 'comment-avatar';
			avatar.textContent = avatarChar(c.author);

			var body = cid(document.createElement('div'));
			body.className = 'comment-body';

			var meta = cid(document.createElement('div'));
			meta.className = 'comment-meta';

			var authorSpan = cid(document.createElement('span'));
			authorSpan.className = 'comment-author';
			authorSpan.textContent = (c.author && c.author.trim()) ? c.author.trim() : '匿名';

			var timeSpan = cid(document.createElement('span'));
			timeSpan.className = 'comment-time';
			timeSpan.textContent = formatTime(c.created_at);

			meta.appendChild(authorSpan);
			meta.appendChild(timeSpan);

			var contentDiv = cid(document.createElement('div'));
			contentDiv.className = 'comment-content';
			contentDiv.textContent = c.content;

			body.appendChild(meta);
			body.appendChild(contentDiv);
			item.appendChild(avatar);
			item.appendChild(body);
			return item;
		}

		function renderEmpty() {
			var div = cid(document.createElement('div'));
			div.className = 'comment-empty';
			div.textContent = '暂无评论，来抢沙发吧～';
			return div;
		}

		function renderUnavailable(msg) {
			var div = cid(document.createElement('div'));
			div.className = 'comment-unavailable';
			div.textContent = msg || '评论功能暂不可用';
			return div;
		}

		async function loadComments() {
			commentList.innerHTML = '';
			try {
				var resp = await fetch(getApiUrl('/api/comments?slug=' + encodeURIComponent(getSlug())));
				if (!resp.ok) {
					if (resp.status === 404) {
						commentList.appendChild(renderUnavailable('评论服务未配置'));
					} else {
						commentList.appendChild(renderUnavailable('加载评论失败'));
					}
					return;
				}
				var comments = await resp.json();
				if (!Array.isArray(comments) || comments.length === 0) {
					commentList.appendChild(renderEmpty());
				} else {
					comments.forEach(function (c) {
						commentList.appendChild(renderComment(c));
					});
				}
			} catch (e) {
				commentList.appendChild(renderUnavailable('评论服务不可用'));
			}
		}

		function setSubmitting(state) {
			isSubmitting = state;
			submitBtn.disabled = state;
			submitBtn.textContent = state ? '提交中...' : '提交评论';
		}

		async function submitComment() {
			if (isSubmitting) return;
			var content = contentInput.value.trim();
			if (!content) {
				setStatus('请输入评论内容', 'error');
				return;
			}
			if (content.length > 2000) { content = content.substring(0, 2000); }
			var author = (authorInput.value || '').trim();
			if (author.length > 50) { author = author.substring(0, 50); }

			setSubmitting(true);
			setStatus('', '');

			try {
				var resp = await fetch(getApiUrl('/api/comments'), {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						slug: getSlug(),
						author: author,
						content: content,
					}),
				});

				if (!resp.ok) {
					var data;
					try { data = await resp.json(); } catch (e) { data = {}; }
					if (resp.status === 429) {
						setStatus('请求太频繁了，请稍后再试 🌊', 'error');
					} else {
						setStatus(data.error || '提交失败，请重试', 'error');
					}
				} else {
					var comment = await resp.json();
					setStatus('评论发表成功！', 'success');
					contentInput.value = '';
					// Insert new comment at the top of the list
					var emptyEl = commentList.querySelector('.comment-empty');
					if (emptyEl) emptyEl.remove();
					var unavailableEl = commentList.querySelector('.comment-unavailable');
					if (unavailableEl) unavailableEl.remove();
					commentList.insertBefore(renderComment(comment), commentList.firstChild);
					commentList.firstChild.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			} catch (e) {
				setStatus('评论服务不可用，请稍后重试', 'error');
			}

			setSubmitting(false);
		}

		// Load comments on page load
		loadComments();

		// Submit button
		submitBtn.addEventListener('click', submitComment);

		// Ctrl/Cmd+Enter to submit, Enter for newline
		contentInput.addEventListener('keydown', function (e) {
			if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
				e.preventDefault();
				submitComment();
			}
		});
	})();
</script>
