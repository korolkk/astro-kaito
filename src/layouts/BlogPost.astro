---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	prevPost?: CollectionEntry<'blog'> | null;
	nextPost?: CollectionEntry<'blog'> | null;
	headings?: { text: string; level: number; id: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, prevPost, nextPost, headings = [] } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-height: 240px;
				overflow: hidden;
				margin-bottom: 0;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				width: 100%;
				max-width: 720px;
				height: auto;
				object-fit: cover;
				max-height: 240px;
			}
			.article-wrapper {
				width: 100%;
				max-width: 1140px;
				margin: 0 auto;
				padding: 0 2em;
				position: relative;
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				padding: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			/* Progress bar */
			.progress-bar {
				position: sticky;
				top: 0;
				z-index: 99;
				width: 100%;
				height: 3px;
				background: transparent;
			}
			.progress-bar::after {
				content: '';
				display: block;
				height: 100%;
				width: var(--progress, 0%);
				background: linear-gradient(90deg, var(--accent), rgba(var(--accent-rgb), 0.6));
				transition: width 0.1s linear;
			}

			/* Tags */
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				justify-content: center;
				margin-top: 0.8em;
			}
			.tag {
				display: inline-block;
				padding: 0.25em 0.7em;
				font-size: 0.78em;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.08);
				border: 1px solid rgba(var(--accent-rgb), 0.15);
				border-radius: 999px;
				text-decoration: none;
				transition: background 0.2s ease;
			}
			.tag:hover {
				background: rgba(var(--accent-rgb), 0.16);
			}

			/* Post navigation */
			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				margin-top: 3em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.post-nav-link {
				flex: 1;
				max-width: 48%;
				text-decoration: none;
				padding: 0.8em 1em;
				border-radius: 10px;
				border: 1px solid rgb(var(--gray-light));
				transition: border-color 0.2s ease, background 0.2s ease;
			}
			.post-nav-link:hover {
				border-color: var(--accent);
				background: rgba(var(--accent-rgb), 0.04);
			}
			.post-nav-link.empty {
				visibility: hidden;
			}
			.post-nav-link.next {
				text-align: right;
				margin-left: auto;
			}
			.post-nav-label {
				display: block;
				font-size: 0.78em;
				color: rgb(var(--gray));
				margin-bottom: 0.3em;
			}
			.post-nav-title {
				display: block;
				font-size: 0.95em;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.4;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* Table of Contents */
			.toc-sidebar {
				position: fixed;
				right: max(2em, calc((100vw - 1140px) / 2 - 220px));
				top: 6em;
				width: 220px;
				max-height: calc(100vh - 8em);
				overflow-y: auto;
				z-index: 50;
				padding-left: 1em;
				border-left: 2px solid rgb(var(--gray-light));
				display: none;
			}
			.toc-sidebar.has-toc {
				display: block;
			}
			.toc-sidebar .toc-title {
				font-size: 0.82em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.8em;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.toc-sidebar a {
				display: block;
				padding: 0.3em 0;
				font-size: 0.8em;
				color: rgb(var(--gray));
				text-decoration: none;
				line-height: 1.4;
				transition: color 0.15s ease;
				border-left: 2px solid transparent;
				margin-left: -1em;
				padding-left: 1em;
			}
			.toc-sidebar a:hover,
			.toc-sidebar a.active {
				color: var(--accent);
				border-left-color: var(--accent);
			}
			.toc-sidebar a.toc-h3 {
				padding-left: 1.8em;
			}
			.toc-sidebar a.toc-h4 {
				padding-left: 2.6em;
			}

			@media (max-width: 1300px) {
				.toc-sidebar {
					display: none !important;
				}
			}
			@media (max-width: 600px) {
				.post-nav {
					flex-direction: column;
					gap: 0.6em;
				}
				.post-nav-link {
					max-width: 100%;
				}
				.post-nav-link.next {
					margin-left: 0;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="progress-bar" id="progressBar"></div>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={720} height={240} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="article-wrapper">
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							{
								tags && tags.length > 0 && (
									<div class="tags">
										{tags.map((tag) => (
											<a class="tag" href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>
										))}
									</div>
								)
							}
							<hr />
						</div>
						<slot />
						{
							(prevPost || nextPost) && (
								<nav class="post-nav">
									{
										prevPost ? (
											<a class="post-nav-link prev" href={`/blog/${prevPost.id}/`}>
												<span class="post-nav-label">上一篇</span>
												<span class="post-nav-title">{prevPost.data.title}</span>
											</a>
										) : <span class="post-nav-link prev empty" />
									}
									{
										nextPost ? (
											<a class="post-nav-link next" href={`/blog/${nextPost.id}/`}>
												<span class="post-nav-label">下一篇</span>
												<span class="post-nav-title">{nextPost.data.title}</span>
											</a>
										) : <span class="post-nav-link next empty" />
									}
								</nav>
							)
						}
					</div>
				</div>
			</article>

			{
				headings.length > 0 && (
					<aside class="toc-sidebar has-toc" id="tocSidebar">
						<div class="toc-title">目录</div>
						<nav id="tocNav">
							{headings.map((h) => (
								<a href={`#${h.id}`} class={`toc-h${h.level}`}>{h.text}</a>
							))}
						</nav>
					</aside>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<script is:inline>
	(function () {
		const bar = document.getElementById('progressBar');
		let ticking = false;

		function updateProgress() {
			const article = document.querySelector('article');
			if (!article) return;
			const articleTop = article.offsetTop;
			const articleHeight = article.offsetHeight;
			const viewportHeight = window.innerHeight;
			const scrolled = window.scrollY - articleTop + viewportHeight;
			const progress = Math.min(100, Math.max(0, (scrolled / articleHeight) * 100));
			bar.style.setProperty('--progress', `${progress}%`);
		}

		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(() => {
					updateProgress();
					updateActiveToc();
					ticking = false;
				});
				ticking = true;
			}
		});

		updateProgress();

		// TOC active tracking
		function updateActiveToc() {
			const tocLinks = document.querySelectorAll('#tocNav a');
			if (tocLinks.length === 0) return;

			const headings = [];
			tocLinks.forEach((link) => {
				const id = link.getAttribute('href')?.slice(1);
				if (id) {
					const el = document.getElementById(id);
					if (el) headings.push({ el, link });
				}
			});

			if (headings.length === 0) return;

			let active = headings[0].link;
			for (const { el, link } of headings) {
				if (el.getBoundingClientRect().top <= 120) {
					active = link;
				}
			}
			tocLinks.forEach((link) => link.classList.remove('active'));
			active.classList.add('active');
		}
	})();
</script>
