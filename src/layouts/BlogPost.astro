---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

type Props = CollectionEntry<'blog'>['data'] & {
	prevPost?: CollectionEntry<'blog'> | null;
	nextPost?: CollectionEntry<'blog'> | null;
	headings?: { text: string; level: number; id: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, prevPost, nextPost, headings = [] } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-height: 240px;
				overflow: hidden;
				margin-bottom: 0;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				width: 100%;
				max-width: 720px;
				height: auto;
				object-fit: cover;
				max-height: 240px;
			}
			.article-wrapper {
				width: 100%;
				max-width: 1140px;
				margin: 0 auto;
				padding: 0 2em;
				position: relative;
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				padding: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

			/* Progress bar */
			.progress-bar {
				position: sticky;
				top: 0;
				z-index: 99;
				width: 100%;
				height: 3px;
				background: transparent;
			}
			.progress-bar::after {
				content: '';
				display: block;
				height: 100%;
				width: var(--progress, 0%);
				background: linear-gradient(90deg, var(--accent), rgba(var(--accent-rgb), 0.6));
				transition: width 0.1s linear;
			}

			/* Tags */
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				justify-content: center;
				margin-top: 0.8em;
			}
			.tag {
				display: inline-block;
				padding: 0.25em 0.7em;
				font-size: 0.78em;
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.08);
				border: 1px solid rgba(var(--accent-rgb), 0.15);
				border-radius: 999px;
				text-decoration: none;
				transition: background 0.2s ease;
			}
			.tag:hover {
				background: rgba(var(--accent-rgb), 0.16);
			}

			/* Share buttons */
			.share-section {
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
				display: flex;
				align-items: center;
				gap: 0.6em;
				flex-wrap: wrap;
			}
			.share-label {
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.share-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 2em;
				height: 2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--card-bg);
				color: rgb(var(--gray));
				cursor: pointer;
				transition: all 0.2s ease;
				text-decoration: none;
			}
			.share-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.04);
			}
			.share-btn.copied {
				border-color: var(--accent);
				color: var(--accent);
			}

			/* Comments */
			.comments-section {
				margin-top: 2em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.comment-form {
				display: flex;
				flex-direction: column;
				gap: 0.6em;
				margin-bottom: 1.5em;
			}
			.comment-form input,
			.comment-form textarea {
				padding: 0.6em 0.85em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				font-family: inherit;
				font-size: 0.88em;
				background: rgb(var(--gray-light));
				color: rgb(var(--black));
				outline: none;
				transition: border-color 0.15s ease;
				resize: vertical;
			}
			.comment-form input:focus,
			.comment-form textarea:focus {
				border-color: var(--accent);
			}
			.comment-form textarea {
				min-height: 80px;
			}
			.comment-form input::placeholder,
			.comment-form textarea::placeholder {
				color: rgb(var(--gray));
			}
			.comment-submit {
				align-self: flex-end;
				padding: 0.5em 1.2em;
				border: none;
				border-radius: 10px;
				background: var(--accent);
				color: #fff;
				font-family: inherit;
				font-size: 0.88em;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.15s ease;
			}
			.comment-submit:hover {
				opacity: 0.85;
			}
			.comment-submit:disabled {
				opacity: 0.4;
				cursor: not-allowed;
			}
			.comment-status {
				font-size: 0.82em;
				text-align: center;
				padding: 0.3em 0;
			}
			.comment-status.success { color: var(--accent); }
			.comment-status.error { color: #dc3545; }
			/* Comment list */
			.comment-list {
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.comment-item {
				display: flex;
				gap: 0.65em;
				animation: comment-in 0.25s ease-out;
			}
			@keyframes comment-in {
				from { opacity: 0; transform: translateY(8px); }
				to { opacity: 1; transform: translateY(0); }
			}
			.comment-avatar {
				flex-shrink: 0;
				width: 36px;
				height: 36px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.82em;
				font-weight: 700;
				color: #fff;
				background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
				user-select: none;
			}
			.comment-body {
				flex: 1;
				min-width: 0;
			}
			.comment-meta {
				display: flex;
				align-items: baseline;
				gap: 0.6em;
				margin-bottom: 0.35em;
			}
			.comment-author {
				font-size: 0.85em;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.comment-time {
				font-size: 0.75em;
				color: rgb(var(--gray));
			}
			.comment-content {
				padding: 0.55em 0.85em;
				border-radius: 4px 14px 14px 14px;
				font-size: 0.88em;
				line-height: 1.6;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				word-break: break-word;
			}
			.comment-empty {
				text-align: center;
				color: rgb(var(--gray));
				font-size: 0.88em;
				padding: 1.5em 0;
			}
			.comment-unavailable {
				text-align: center;
				color: rgb(var(--gray));
				font-size: 0.82em;
				padding: 1.5em 0;
			}

			/* Reply button */
			.comment-reply-btn {
				font-size: 0.75em;
				color: rgb(var(--gray));
				background: none;
				border: none;
				cursor: pointer;
				padding: 0.15em 0.4em;
				border-radius: 4px;
				transition: color 0.15s ease;
				font-family: inherit;
			}
			.comment-reply-btn:hover { color: var(--accent); }

			/* Inline reply form */
			.comment-reply-form {
				display: none;
				margin-top: 0.6em;
			}
			.comment-reply-form.open { display: flex; flex-direction: column; gap: 0.45em; }
			.comment-reply-form textarea {
				padding: 0.5em 0.75em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				font-family: inherit;
				font-size: 0.82em;
				background: rgb(var(--gray-light));
				color: rgb(var(--black));
				outline: none;
				resize: vertical;
				min-height: 60px;
				transition: border-color 0.15s ease;
				box-sizing: border-box;
			}
			.comment-reply-form textarea:focus { border-color: var(--accent); }
			.comment-reply-actions {
				display: flex;
				gap: 0.4em;
				align-self: flex-end;
			}
			.comment-reply-cancel {
				padding: 0.35em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: var(--card-bg);
				color: rgb(var(--gray));
				font-family: inherit;
				font-size: 0.78em;
				cursor: pointer;
			}
			.comment-reply-cancel:hover { color: rgb(var(--black)); }
			.comment-reply-submit {
				padding: 0.35em 0.9em;
				border: none;
				border-radius: 8px;
				background: var(--accent);
				color: #fff;
				font-family: inherit;
				font-size: 0.78em;
				font-weight: 600;
				cursor: pointer;
			}
			.comment-reply-submit:hover { opacity: 0.85; }

			/* Nested replies */
			.comment-replies {
				margin-left: 2.5em;
				margin-top: 0.5em;
				padding-left: 0.8em;
				border-left: 2px solid rgb(var(--gray-light));
				display: flex;
				flex-direction: column;
				gap: 0.6em;
			}
			.comment-replies .comment-item { font-size: 0.94em; }

			/* Reply-to indicator */
			.comment-reply-to {
				font-size: 0.78em;
				color: var(--accent);
				margin-bottom: 0.2em;
			}

			/* Like button */
			.comment-like-btn {
				font-size: 0.75em;
				color: rgb(var(--gray));
				background: none;
				border: none;
				cursor: pointer;
				padding: 0.15em 0.4em;
				border-radius: 4px;
				transition: all 0.2s ease;
				font-family: inherit;
				display: inline-flex;
				align-items: center;
				gap: 0.25em;
			}
			.comment-like-btn:hover { color: #e74c3c; }
			.comment-like-btn.liked { color: #e74c3c; }

			/* Device info badge */
			.comment-device {
				font-size: 0.7em;
				color: rgb(var(--gray));
				margin-top: 0.25em;
				opacity: 0.75;
			}

			/* Actions row */
			.comment-actions {
				display: flex;
				gap: 0.3em;
				margin-top: 0.35em;
			}

			@media (max-width: 480px) {
				.comment-replies {
					margin-left: 1.2em;
					padding-left: 0.5em;
				}
			}

			/* Post navigation */
			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				margin-top: 2em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.post-nav-link {
				flex: 1;
				max-width: 48%;
				text-decoration: none;
				padding: 0.8em 1em;
				border-radius: 10px;
				border: 1px solid rgb(var(--gray-light));
				transition: border-color 0.2s ease, background 0.2s ease;
			}
			.post-nav-link:hover {
				border-color: var(--accent);
				background: rgba(var(--accent-rgb), 0.04);
			}
			.post-nav-link.empty {
				visibility: hidden;
			}
			.post-nav-link.next {
				text-align: right;
				margin-left: auto;
			}
			.post-nav-label {
				display: block;
				font-size: 0.78em;
				color: rgb(var(--gray));
				margin-bottom: 0.3em;
			}
			.post-nav-title {
				display: block;
				font-size: 0.95em;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.4;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* Table of Contents */
			.toc-sidebar {
				position: fixed;
				right: max(2em, calc((100vw - 1140px) / 2 - 220px));
				top: 6em;
				width: 220px;
				max-height: calc(100vh - 8em);
				overflow-y: auto;
				z-index: 50;
				padding-left: 1em;
				border-left: 2px solid rgb(var(--gray-light));
				display: none;
			}
			.toc-sidebar.has-toc {
				display: block;
			}
			.toc-sidebar .toc-title {
				font-size: 0.82em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.8em;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.toc-sidebar a {
				display: block;
				padding: 0.3em 0;
				font-size: 0.8em;
				color: rgb(var(--gray));
				text-decoration: none;
				line-height: 1.4;
				transition: color 0.15s ease;
				border-left: 2px solid transparent;
				margin-left: -1em;
				padding-left: 1em;
			}
			.toc-sidebar a:hover,
			.toc-sidebar a.active {
				color: var(--accent);
				border-left-color: var(--accent);
			}
			.toc-sidebar a.toc-h3 {
				padding-left: 1.8em;
			}
			.toc-sidebar a.toc-h4 {
				padding-left: 2.6em;
			}

			@media (max-width: 1300px) {
				.toc-sidebar {
					display: none !important;
				}
			}
			/* AI Q&A */
			.ai-qa-section {
				margin-top: 2em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.ai-qa-section h3 {
				font-size: 1.25em;
				margin-bottom: 0.6em;
			}
			.ai-qa-presets {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-bottom: 0.8em;
			}
			.ai-qa-preset {
				padding: 0.35em 0.75em;
				font-size: 0.82em;
				font-family: inherit;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: var(--card-bg);
				color: rgb(var(--gray-dark));
				cursor: pointer;
				transition: all 0.2s ease;
				white-space: nowrap;
			}
			.ai-qa-preset:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: rgba(var(--accent-rgb), 0.06);
			}
			.ai-qa-input-row {
				display: flex;
				gap: 0.5em;
				align-items: center;
			}
			.ai-qa-input {
				flex: 1;
				padding: 0.55em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				font-family: inherit;
				font-size: 0.88em;
				background: rgb(var(--gray-light));
				color: rgb(var(--black));
				outline: none;
				transition: border-color 0.15s ease;
			}
			.ai-qa-input:focus {
				border-color: var(--accent);
			}
			.ai-qa-input::placeholder {
				color: rgb(var(--gray));
			}
			.ai-qa-send {
				flex-shrink: 0;
				padding: 0.55em 1.1em;
				border: none;
				border-radius: 10px;
				background: var(--accent);
				color: #fff;
				font-family: inherit;
				font-size: 0.88em;
				font-weight: 600;
				cursor: pointer;
				transition: opacity 0.15s ease;
			}
			.ai-qa-send:hover {
				opacity: 0.85;
			}
			.ai-qa-send:disabled {
				opacity: 0.4;
				cursor: not-allowed;
			}
			/* AI Q&A conversation thread */
			.ai-qa-conversation {
				margin-top: 1em;
				display: flex;
				flex-direction: column;
				gap: 0.9em;
			}
			/* Each Q&A group */
			.ai-qa-group {
				animation: ai-qa-in 0.25s ease-out;
			}
			@keyframes ai-qa-in {
				from { opacity: 0; transform: translateY(8px); }
				to { opacity: 1; transform: translateY(0); }
			}
			/* Question bubble — right-aligned, accent background */
			.ai-qa-q {
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				margin-bottom: 0.5em;
			}
			.ai-qa-q .ai-qa-bubble {
				padding: 0.6em 0.85em;
				border-radius: 14px 14px 4px 14px;
				font-size: 0.88em;
				line-height: 1.55;
				max-width: 88%;
				background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
				color: #fff;
				box-shadow: 0 2px 8px rgba(99, 102, 241, 0.18);
			}
			/* Answer bubble — left-aligned, gray background */
			.ai-qa-a {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
			}
			.ai-qa-a .ai-qa-bubble {
				padding: 0.6em 0.85em;
				border-radius: 14px 14px 14px 4px;
				font-size: 0.88em;
				line-height: 1.65;
				max-width: 95%;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			/* Error in answer position */
			.ai-qa-a.ai-qa-error .ai-qa-bubble {
				background: rgba(220, 53, 69, 0.07);
				color: #dc3545;
				font-size: 0.82em;
			}
			/* Loading dots */
			.ai-qa-loading {
				display: flex;
				align-items: center;
				gap: 4px;
				padding: 0.5em 0.85em;
			}
			.ai-qa-loading span {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: rgb(var(--gray));
				animation: ai-qa-bounce 1.2s ease-in-out infinite;
			}
			.ai-qa-loading span:nth-child(2) { animation-delay: 0.15s; }
			.ai-qa-loading span:nth-child(3) { animation-delay: 0.3s; }
			@keyframes ai-qa-bounce {
				0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
				30% { transform: translateY(-6px); opacity: 1; }
			}

			/* ----- Markdown content inside bubbles ----- */
			.ai-qa-bubble h1,
			.ai-qa-bubble h2,
			.ai-qa-bubble h3,
			.ai-qa-bubble h4,
			.ai-qa-bubble h5,
			.ai-qa-bubble h6,
			.comment-content h1,
			.comment-content h2,
			.comment-content h3,
			.comment-content h4,
			.comment-content h5,
			.comment-content h6 {
				margin: 0.8em 0 0.4em 0;
				line-height: 1.3;
				color: inherit;
			}
			.ai-qa-bubble h1, .comment-content h1 { font-size: 1.4em; }
			.ai-qa-bubble h2, .comment-content h2 { font-size: 1.25em; }
			.ai-qa-bubble h3, .comment-content h3 { font-size: 1.1em; }
			.ai-qa-bubble h4, .comment-content h4 { font-size: 1em; }

			.ai-qa-bubble p,
			.comment-content p {
				margin: 0.5em 0;
			}
			.ai-qa-bubble p:first-child,
			.comment-content p:first-child {
				margin-top: 0;
			}
			.ai-qa-bubble p:last-child,
			.comment-content p:last-child {
				margin-bottom: 0;
			}

			/* Inline code */
			.ai-qa-bubble code,
			.comment-content code {
				padding: 0.15em 0.4em;
				font-size: 0.88em;
				background: rgba(var(--accent-rgb), 0.1);
				border-radius: 3px;
				font-family: 'Courier New', Courier, monospace;
				word-break: break-word;
			}

			/* Fenced code blocks */
			.ai-qa-bubble pre,
			.comment-content pre {
				margin: 0.6em 0;
				padding: 0.8em 1em;
				background: rgba(var(--black), 0.06);
				border-radius: 8px;
				overflow-x: auto;
				font-size: 0.82em;
				line-height: 1.5;
			}
			[data-theme='dark'] .ai-qa-bubble pre,
			[data-theme='dark'] .comment-content pre {
				background: rgba(255, 255, 255, 0.06);
			}
			.ai-qa-bubble pre code,
			.comment-content pre code {
				padding: 0;
				background: none;
				font-size: inherit;
				border-radius: 0;
			}

			/* Lists */
			.ai-qa-bubble ul,
			.ai-qa-bubble ol,
			.comment-content ul,
			.comment-content ol {
				margin: 0.4em 0;
				padding-left: 1.5em;
			}
			.ai-qa-bubble li,
			.comment-content li {
				margin: 0.2em 0;
				line-height: 1.55;
			}

			/* Blockquotes */
			.ai-qa-bubble blockquote,
			.comment-content blockquote {
				margin: 0.5em 0;
				padding: 0.3em 0 0.3em 0.8em;
				border-left: 3px solid var(--accent);
				color: inherit;
				opacity: 0.85;
